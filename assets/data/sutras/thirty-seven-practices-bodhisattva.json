     "section": "Verse 13"
    },
    {
     "n": 60,
     "text": "སྙིང་རྗེའི་དབང་གིས་དེ་ཡི་སྡིག་པ་རྣམས། །",
     "section": "Verse 13"
    },
    {
     "n": 61,
     "text": "བདག་ལ་ལེན་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 13"
    },
    {
     "n": 62,
     "text": "འགའ་ཞིག་བདག་ལ་མི་སྙན་སྣ་ཚོགས་པ། །",
     "section": "Verse 14"
    },
    {
     "n": 63,
     "text": "སྟོང་གསུམ་ཁྱབ་པར་སྒྲོགས་པར་བྱེད་ན་ཡང། །",
     "section": "Verse 14"
    },
    {
     "n": 64,
     "text": "བྱམས་པའི་སེམས་ཀྱིས་སླར་ཡང་དེ་ཉིད་ཀྱི། །",
     "section": "Verse 14"
    },
    {
     "n": 65,
     "text": "ཡོན་ཏན་བརྗོད་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 14"
    },
    {
     "n": 66,
     "text": "འགྲོ་མང་འདུས་པའི་དབུས་སུ་འགའ་ཞིག་གིས། །",
     "section": "Verse 15"
    },
    {
     "n": 67,
     "text": "མཚང་ནས་བྲུས་ཤིང་ཚིག་ངན་སྨྲ་ན་ཡང༌། །",
     "section": "Verse 15"
    },
    {
     "n": 68,
     "text": "དེ་ལ་དགེ་བའི་བཤེས་ཀྱིས་འདུ་ཤེས་ཀྱིས། །",
     "section": "Verse 15"
    },
    {
     "n": 69,
     "text": "གུས་པར་འདུད་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 15"
    },
    {
     "n": 70,
     "text": "བདག་གི་བུ་བཞིན་གཅེས་པར་བསྐྱངས་བའི་མིས། །",
     "section": "Verse 16"
    },
    {
     "n": 71,
     "text": "བདག་ལ་དགྲ་བཞིན་ལྟ་བར་བྱེད་ན་ཡང༌། །",
     "section": "Verse 16"
    },
    {
     "n": 72,
     "text": "ནད་ཀྱིས་བཏབ་པའི་བུ་ལ་མ་བཞིན་དུ། །",
     "section": "Verse 16"
    },
    {
     "n": 73,
     "text": "ལྷག་པར་བརྩེ་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 16"
    },
    {
     "n": 74,
     "text": "རང་དང་མཉམ་པའམ་དམན་པའི་སྐྱེ་བོ་ཡིས། །",
     "section": "Verse 17"
    },
    {
     "n": 75,
     "text": "ང་རྒྱལ་དབང་གིས་བརྙས་ཐབས་བྱེད་ན་ཡང༌། །",
     "section": "Verse 17"
    },
    {
     "n": 76,
     "text": "བླ་མ་བཞིན་དུ་གུས་པས་བདག་ཉིད་ཀྱི། །",
     "section": "Verse 17"
    },
    {
     "n": 77,
     "text": "སྤྱི་བོར་ལེན་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 17"
    },
    {
     "n": 78,
     "text": "འཚོ་བས་འཕོངས་ཤིང་རྟག་ཏུ་མི་ཡིས་བརྙས། །",
     "section": "Verse 18"
    },
    {
     "n": 79,
     "text": "ཚབས་ཆེན་ནད་དང་གདོན་གྱིས་བཏབ་ཀྱང་སླར། །",
     "section": "Verse 18"
    },
    {
     "n": 80,
     "text": "འགྲོ་ཀུན་སྡིག་སྡུག་བདག་ལ་ལེན་བྱེད་ཅིང༌། །",
     "section": "Verse 18"
    },
    {
     "n": 81,
     "text": "ཞུམ་པ་མེད་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 18"
    },
    {
     "n": 82,
     "text": "སྙན་པར་གྲགས་ཤིང་འགྲོ་མང་སྤྱི་བོས་བཏུད། །",
     "section": "Verse 19"
    },
    {
     "n": 83,
     "text": "རྣམ་ཐོས་བུ་ཡིས་ནོར་འདྲ་ཐོབ་གྱུར་ཀྱང༌། །",
     "section": "Verse 19"
    },
    {
     "n": 84,
     "text": "སྲིད་པའི་དཔལ་འབྱོར་སྙིང་པོ་མེད་གཟིགས་ནས། །",
     "section": "Verse 19"
    },
    {
     "n": 85,
     "text": "ཁེངས་པ་མེད་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 19"
    },
    {
     "n": 86,
     "text": "རང་གི་ཞེ་སྡང་དགྲ་བོ་མ་ཐུལ་ན། །",
     "section": "Verse 20"
    },
    {
     "n": 87,
     "text": "ཕྱི་རོལ་དགྲ་བོ་བཏུལ་ཞིང་འཕེལ་བར་འགྱུར། །",
     "section": "Verse 20"
    },
    {
     "n": 88,
     "text": "དེ་ཕྱིར་བྱམས་དང་སྙིང་རྗེའི་དམག་དཔུང་གིས། །",
     "section": "Verse 20"
    },
    {
     "n": 89,
     "text": "རང་རྒྱུད་འདུལ་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 20"
    },
    {
     "n": 90,
     "text": "འདོད་པའི་ཡོན་ཏན་ལན་ཚྭའི་ཆུ་དང་འདྲ། །",
     "section": "Verse 21"
    },
    {
     "n": 91,
     "text": "ཇི་ཙམ་སྤྱད་ཅིང་སྲེད་པ་འཕེལ་བར་འགྱུར། །",
     "section": "Verse 21"
    },
    {
     "n": 92,
     "text": "གང་ལ་ཞེན་ཆགས་སྐྱེ་བའི་དངོས་པོ་རྣམས། །",
     "section": "Verse 21"
    },
    {
     "n": 93,
     "text": "འཕྲལ་ལ་སྤོང་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 21"
    },
    {
     "n": 94,
     "text": "ཇི་ལྟར་སྣང་བ་འདི་དག་རང་གི་སེམས། །",
     "section": "Verse 22"
    },
    {
     "n": 95,
     "text": "སེམས་ཉིད་གདོད་ནས་སྤྲོས་པའི་མཐའ་དང་བྲལ། །",
     "section": "Verse 22"
    },
    {
     "n": 96,
     "text": "དེ་ཉིད་ཤེས་ནས་གཟུང་འཛིན་མཚན་མ་རྣམས། །",
     "section": "Verse 22"
    },
    {
     "n": 97,
     "text": "ཡིད་ལ་མི་བྱེད་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 22"
    },
    {
     "n": 98,
     "text": "ཡིད་དུ་འོང་པའི་ཡུལ་དང་འཕྲད་པ་ན། །",
     "section": "Verse 23"
    },
    {
     "n": 99,
     "text": "དབྱར་གྱི་དུས་ཀྱི་འཇའ་ཚོན་ཇི་བཞིན་དུ། །",
     "section": "Verse 23"
    },
    {
     "n": 100,
     "text": "མཛེས་པར་སྣང་ཡང་བདེན་པར་མི་ལྟ་ཞིང༌། །",
     "section": "Verse 23"
    },
    {
     "n": 101,
     "text": "ཞེན་ཆགས་སྤོང་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 23"
    },
    {
     "n": 102,
     "text": "སྡུག་བསྔལ་སྣ་ཚོགས་རྨི་ལམ་བུ་ཤི་ལྟར། །",
     "section": "Verse 24"
    },
    {
     "n": 103,
     "text": "འཁྲུལ་སྣང་བདེན་པར་བཟུང་བས་ཨ་ཐང་ཆད། །",
     "section": "Verse 24"
    },
    {
     "n": 104,
     "text": "དེའི་ཕྱིར་མི་མཐུན་རྐྱེན་དང་འཕྲད་པའི་ཚེ། །",
     "section": "Verse 24"
    },
    {
     "n": 105,
     "text": "འཁྲུལ་པར་ལྟ་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 24"
    },
    {
     "n": 106,
     "text": "བྱང་ཆུབ་འདོད་པས་ལུས་ཀྱང་བཏང་དགོས་ན། །",
     "section": "Verse 25"
    },
    {
     "n": 107,
     "text": "ཕྱི་རོལ་དངོས་པོ་རྣམས་ལ་སྨོས་ཅི་དགོས། །",
     "section": "Verse 25"
    },
    {
     "n": 108,
     "text": "དེ་ཕྱིར་ལན་དང་རྣམ་སྨིན་མི་རེ་བའི། །",
     "section": "Verse 25"
    },
    {
     "n": 109,
     "text": "སྦྱིན་པ་གཏོང་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 25"
    },
    {
     "n": 110,
     "text": "ཚུལ་ཁྲིམས་མེད་པར་རང་དོན་མི་འགྲུབ་ན། །",
     "section": "Verse 26"
    },
    {
     "n": 111,
     "text": "གཞན་དོན་སྒྲུབ་པར་འདོད་པ་གད་མོའི་གནས། །",
     "section": "Verse 26"
    },
    {
     "n": 112,
     "text": "དེ་ཕྱིར་སྲིད་པའི་འདུན་པ་མེད་པ་ཡི། །",
     "section": "Verse 26"
    },
    {
     "n": 113,
     "text": "ཚུལ་ཁྲིམས་སྲུང་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 26"
    },
    {
     "n": 114,
     "text": "དགེ་བའི་ལོངས་སྤྱོད་འདོད་པའི་རྒྱལ་སྲས་ལ། །",
     "section": "Verse 27"
    },
    {
     "n": 115,
     "text": "གནོད་བྱེད་ཐམས་ཅད་རིན་ཆེན་གཏེར་དང་མཚུངས། །",
     "section": "Verse 27"
    },
    {
     "n": 116,
     "text": "དེ་ཕྱིར་ཀུན་ལ་ཞེ་འགྲས་མེད་པ་ཡི། །",
     "section": "Verse 27"
    },
    {
     "n": 117,
     "text": "བཟོད་པ་སྒོམ་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 27"
    },
    {
     "n": 118,
     "text": "རང་དོན་འབའ་ཞིག་སྒྲུབ་པའི་ཉན་རང་ཡང༌། །",
     "section": "Verse 28"
    },
    {
     "n": 119,
     "text": "མགོ་ལ་མེ་ཤོར་བཟློག་ལྟར་བརྩོན་མཐོང་ན། །",
     "section": "Verse 28"
    },
    {
     "n": 120,
     "text": "འགྲོ་ཀུན་དོན་དུ་ཡོན་ཏན་འབྱུང་གནས་ཀྱི། །",
     "section": "Verse 28"
    },
    {
     "n": 121,
     "text": "བརྩོན་འགྲུས་རྩོམ་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 28"
    },
    {
     "n": 122,
     "text": "ཞི་གནས་རབ་ཏུ་ལྡན་པའི་ལྷག་མཐོང་གིས། །",
     "section": "Verse 29"
    },
    {
     "n": 123,
     "text": "ཉོན་མོངས་རྣམ་པར་འཇོམས་པར་ཤེས་བྱས་ནས། །",
     "section": "Verse 29"
    },
    {
     "n": 124,
     "text": "གཟུགས་མེད་བཞི་ལས་ཡང་དག་འདའ་བ་ཡི། །",
     "section": "Verse 29"
    },
    {
     "n": 125,
     "text": "བསམ་གཏན་སྒོམ་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 29"
    },
    {
     "n": 126,
     "text": "ཤེས་རབ་མེད་པར་ཕ་རོལ་ཕྱིན་ལྔ་ཡིས། །",
     "section": "Verse 30"
    },
    {
     "n": 127,
     "text": "རྫོགས་པའི་བྱང་ཆུབ་འཐོབ་པར་མི་ནུས་པས། །",
     "section": "Verse 30"
    },
    {
     "n": 128,
     "text": "ཐབས་དང་ལྡན་ཞིང་འཁོར་གསུམ་མི་རྟོག་པའི། །",
     "section": "Verse 30"
    },
    {
     "n": 129,
     "text": "ཤེས་རབ་སྒོམ་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 30"
    },
    {
     "n": 130,
     "text": "རང་གི་འཁྲུལ་པ་རང་གིས་མ་བརྟགས་ན། །",
     "section": "Verse 31"
    },
    {
     "n": 131,
     "text": "ཆོས་པའི་གཟུགས་ཀྱིས་ཆོས་མིན་བྱེད་སྲིད་པས། །",
     "section": "Verse 31"
    },
    {
     "n": 132,
     "text": "དེ་ཕྱིར་རྒྱུན་དུ་རང་གི་འཁྲུལ་པ་ལ། །",
     "section": "Verse 31"
    },
    {
     "n": 133,
     "text": "བརྟགས་ནས་སྤོང་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 31"
    },
    {
     "n": 134,
     "text": "ཉོན་མོངས་དབང་གིས་རྒྱལ་སྲས་གཞན་དག་གིས། །",
     "section": "Verse 32"
    },
    {
     "n": 135,
     "text": "ཉེས་པ་གླེང་ན་བདག་ཉིད་ཉམས་འགྱུར་བས། །",
     "section": "Verse 32"
    },
    {
     "n": 136,
     "text": "ཐེག་པ་ཆེ་ལ་ཞུགས་པའི་གང་ཟག་གིས། །",
     "section": "Verse 32"
    },
    {
     "n": 137,
     "text": "ཉེས་པ་མི་སྨྲ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 32"
    },
    {
     "n": 138,
     "text": "རྙེད་བཀུར་དབང་གིས་ཕན་ཚུན་རྩོད་འགྱུར་ཞིང༌། །",
     "section": "Verse 33"
    },
    {
     "n": 139,
     "text": "ཐོས་བསམ་སྒོམ་པའི་བྱ་བ་ཉམས་འགྱུར་བས། །",
     "section": "Verse 33"
    },
    {
     "n": 140,
     "text": "མཛའ་བཤེས་ཁྱིམ་དང་སྦྱིན་བདག་ཁྱིམ་རྣམས་ལ། །",
     "section": "Verse 33"
    },
    {
     "n": 141,
     "text": "ཆགས་པ་སྤོང་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 33"
    },
    {
     "n": 142,
     "text": "རྩུབ་མོའི་ཚིག་གིས་གཞན་སེམས་འཁྲུག་འགྱུར་ཞིང༌། །",
     "section": "Verse 34"
    },
    {
     "n": 143,
     "text": "རྒྱལ་བའི་སྲས་ཀྱི་སྤྱོད་ཚུལ་ཉམས་འགྱུར་བས། །",
     "section": "Verse 34"
    },
    {
     "n": 144,
     "text": "དེ་ཕྱིར་གཞན་གྱི་ཡིད་དུ་མི་འོང་བའི། །",
     "section": "Verse 34"
    },
    {
     "n": 145,
     "text": "ཚིག་རྩུབ་སྤོང་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 34"
    },
    {
     "n": 146,
     "text": "ཉོན་མོངས་གོམས་ན་གཉེན་པོས་ཟློག་དཀའ་བས། །",
     "section": "Verse 35"
    },
    {
     "n": 147,
     "text": "དྲན་ཤེས་སྐྱེས་བུས་གཉེན་པོའི་མཚོན་བཟུང་ནས། །",
     "section": "Verse 35"
    },
    {
     "n": 148,
     "text": "ཆགས་སོགས་ཉོན་མོངས་དང་པོ་སྐྱེས་མ་ཐག །",
     "section": "Verse 35"
    },
    {
     "n": 149,
     "text": "འབུར་འཇོམས་བྱེད་པར་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 35"
    },
    {
     "n": 150,
     "text": "མདོར་ན་གང་དུ་སྤྱོད་ལམ་ཅི་བྱེད་ཀྱང༌། །",
     "section": "Verse 36"
    },
    {
     "n": 151,
     "text": "རང་གི་སེམས་ཀྱི་གནས་སྐབས་ཅི་འདྲ་ཞེས། །",
     "section": "Verse 36"
    },
    {
     "n": 152,
     "text": "རྒྱུན་དུ་དྲན་དང་ཤེས་བཞིན་ལྡན་པ་ཡིས། །",
     "section": "Verse 36"
    },
    {
     "n": 153,
     "text": "གཞན་དོན་སྒྲུབ་པ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 36"
    },
    {
     "n": 154,
     "text": "དེ་ལྟར་བརྩོན་པས་བསྒྲུབ་པའི་དགེ་བ་རྣམས། །",
     "section": "Verse 37"
    },
    {
     "n": 155,
     "text": "མཐའ་ཡས་འགྲོ་བའི་སྡུག་བསྔལ་བསལ་བྱའི་ཕྱིར། །",
     "section": "Verse 37"
    },
    {
     "n": 156,
     "text": "འཁོར་གསུམ་རྣམ་པར་དག་པའི་ཤེས་རབ་ཀྱིས། །",
     "section": "Verse 37"
    },
    {
     "n": 157,
     "text": "བྱང་ཆུབ་བསྔོ་བ་རྒྱལ་སྲས་ལག་ལེན་ཡིན། །",
     "section": "Verse 37"
    },
    {
     "n": 158,
     "text": "མདོ་རྒྱུད་བསྟན་བཅོས་རྣམས་ལས་གསུངས་པའི་དོན། །"
    },
    {
     "n": 159,
     "text": "དམ་པ་རྣམས་ཀྱི་གསུང་གི་རྗེས་འབྲངས་ནས། །"
    },
    {
     "n": 160,
     "text": "རྒྱལ་སྲས་རྣམས་ཀྱི་ལག་ལེན་སུམ་ཅུ་བདུན། །"
    },
    {
     "n": 161,
     "text": "རྒྱལ་སྲས་ལམ་ལ་སློབ་འདོད་དོན་དུ་བཀོད། །"
    },
    {
     "n": 162,
     "text": "བློ་གྲོས་དམན་ཞིང་སྦྱངས་པ་ཆུང་བའི་ཕྱིར། །"
    },
    {
     "n": 163,
     "text": "མཁས་ལ་དགྱེས་པའི་སྡེབ་སྦྱོར་མ་མཆིས་ཏེ། །"
    },
    {
     "n": 164,
     "text": "མདོ་དང་དམ་པའི་གསུང་ལ་བརྟེན་པའི་ཕྱིར། །"
    },
    {
     "n": 165,
     "text": "རྒྱལ་སྲས་ལག་ལེན་འཁྲུལ་མེད་ལགས་པར་སེམས། །"
    },
    {
     "n": 166,
     "text": "འོན་ཀྱང་རྒྱལ་སྲས་སྤྱོད་པ་རླབས་ཆེན་རྣམས། །"
    },
    {
     "n": 167,
     "text": "བློ་དམན་བདག་འདྲས་གཏིང་དཔག་དཀའ་བའི་ཕྱིར། །"
    },
    {
     "n": 168,
     "text": "འགལ་དང་མ་འབྲེལ་ལ་སོགས་ཉེས་པའི་ཚོགས། །"
    },
    {
     "n": 169,
     "text": "དམ་པ་རྣམས་ཀྱིས་བཟོད་པ་མཛད་དུ་གསོལ། །"
    },
    {
     "n": 170,
     "text": "དེ་ལས་བྱུང་བའི་དགེ་བས་འགྲོ་བ་ཀུན། །"
    },
    {
     "n": 171,
     "text": "དོན་དམ་ཀུན་རྫོབ་བྱང་ཆུབ་སེམས་མཆོག་གིས། །"
    },
    {
     "n": 172,
     "text": "སྲིད་དང་ཞི་བའི་མཐའ་ལ་མི་གནས་པའི། །"
    },
    {
     "n": 173,
     "text": "སྤྱན་རས་གཟིགས་མགོན་དེ་དང་མཚུངས་པར་ཤོག །"
    },
    {
     "n": 174,
     "text": "ཅེས་པ་འདི་རང་གཞན་ལ་ཕན་པའི་དོན་དུ་ལུང་དང་རིགས་པ་སྨྲ་བའི་བཙུན་པ་ཐོགས་མེད་ཀྱིས་དངུལ་ཆུའི་རིན་ཆེན་ཕུག་ཏུ་སྦྱར་བའོ། །།"
    }
   ]
  }
 ]
}
