{
 "id": "phap-cu-ty-kheo",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 360-382",
 "summary": "Phẩm kệ trong Kinh Pháp Cú (Tiểu Bộ, Dhp 360–382) nói về phẩm hạnh của người tỳ-kheo. Kệ mở đầu bằng việc phòng hộ mắt, tai, mũi, lưỡi, thân, lời và ý, rồi mô tả vị chế ngự tay chân và lời nói, thích thiền định, biết đủ và sống độc cư. Phẩm kết bằng hình ảnh vị tỳ-kheo trẻ siêng tu giáo pháp, soi sáng thế gian như trăng thoát mây.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Tỳ-kheo",
  "pli": "Bhikkhuvagga",
  "en": "Mendicants"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 6,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp360-382/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Lành thay, phòng hộ mắt!"
    },
    {
     "n": 2,
     "text": "Lành thay, phòng hộ tai!"
    },
    {
     "n": 3,
     "text": "Lành thay, phòng hộ mũi!"
    },
    {
     "n": 4,
     "text": "Lành thay, phòng hộ lưỡi."
    },
    {
     "n": 5,
     "text": "Lành thay phòng hộ thân!"
    },
    {
     "n": 6,
     "text": "Lành thay, phòng hộ lời,"
    },
    {
     "n": 7,
     "text": "Lành thay, phòng hộ ý."
    },
    {
     "n": 8,
     "text": "Lành thay, phòng tất cả."
    },
    {
     "n": 9,
     "text": "Tỳ-kheo phòng tất cả,"
    },
    {
     "n": 10,
     "text": "Thoát được mọi khổ đau."
    },
    {
     "n": 11,
     "text": "Người chế ngự tay chân,"
    },
    {
     "n": 12,
     "text": "Chế ngự lời và đầu,"
    },
    {
     "n": 13,
     "text": "Vui thích nội thiền định,"
    },
    {
     "n": 14,
     "text": "Độc thân, biết vừa đủ, Thật xứng gọi tỳ-kheo."
    },
    {
     "n": 15,
     "text": "Tỳ-kheo chế ngự miệng,"
    },
    {
     "n": 16,
     "text": "Vừa lời, không cống cao,"
    },
    {
     "n": 17,
     "text": "Khi trình bày pháp nghĩa,"
    },
    {
     "n": 18,
     "text": "Lời lẽ dịu ngọt ngào."
    },
    {
     "n": 19,
     "text": "Vị tỳ-kheo thích Pháp,"
    },
    {
     "n": 20,
     "text": "Mến pháp, suy tư Pháp."
    },
    {
     "n": 21,
     "text": "Tâm tư niệm chánh Pháp,"
    },
    {
     "n": 22,
     "text": "Không rời bỏ chánh Pháp."
    },
    {
     "n": 23,
     "text": "Không khinh điều mình được,"
    },
    {
     "n": 24,
     "text": "Không ganh người khác được,"
    },
    {
     "n": 25,
     "text": "Tỳ-kheo ganh tỵ người,"
    },
    {
     "n": 26,
     "text": "Không sao chứng Thiền định."
    },
    {
     "n": 27,
     "text": "Tỳ-kheo dù được ít,"
    },
    {
     "n": 28,
     "text": "Không khinh điều mình được,"
    },
    {
     "n": 29,
     "text": "Sống thanh tịnh không nhác,"
    },
    {
     "n": 30,
     "text": "Chư thiên khen vị này."
    },
    {
     "n": 31,
     "text": "Hoàn toàn, đối danh sắc,"
    },
    {
     "n": 32,
     "text": "Không chấp Ta, của Ta."
    },
    {
     "n": 33,
     "text": "Không chấp, không sầu não."
    },
    {
     "n": 34,
     "text": "Thật xứng danh Tỳ-kheo."
    },
    {
     "n": 35,
     "text": "Tỳ-kheo trú Từ Bi,"
    },
    {
     "n": 36,
     "text": "Tín thành giáo Pháp Phật,"
    },
    {
     "n": 37,
     "text": "Chứng cảnh giới tịch tỉnh."
    },
    {
     "n": 38,
     "text": "Các hạnh an tịnh lạc."
    },
    {
     "n": 39,
     "text": "Tỳ-kheo, tát thuyền này,"
    },
    {
     "n": 40,
     "text": "Thuyền không, nhẹ đi mau."
    },
    {
     "n": 41,
     "text": "Trừ tham, diệt sân hận,"
    },
    {
     "n": 42,
     "text": "Tất chứng đạt Niết-bàn."
    },
    {
     "n": 43,
     "text": "Đoạn năm, từ bỏ năm,"
    },
    {
     "n": 44,
     "text": "Tu tập năm tối thượng,"
    },
    {
     "n": 45,
     "text": "Tỳ-kheo cắt năm trói,"
    },
    {
     "n": 46,
     "text": "Xứng danh vượt “bộc lưu”."
    },
    {
     "n": 47,
     "text": "Tỳ-kheo, hãy tu thiền, Chớ buông lung phóng dật,"
    },
    {
     "n": 48,
     "text": "Tâm chớ đắm say dục,"
    },
    {
     "n": 49,
     "text": "Phóng dật, nuốt sắt nóng"
    },
    {
     "n": 50,
     "text": "Bị đốt, chớ than khổ!"
    },
    {
     "n": 51,
     "text": "Không trí tuệ, không thiền,"
    },
    {
     "n": 52,
     "text": "Không thiền, không trí tuệ."
    },
    {
     "n": 53,
     "text": "Người có thiền có tuệ,"
    },
    {
     "n": 54,
     "text": "Nhất định gần Niết-bàn."
    },
    {
     "n": 55,
     "text": "Bước vào ngôi nhà trống,"
    },
    {
     "n": 56,
     "text": "Tỳ-kheo tâm an tịnh,"
    },
    {
     "n": 57,
     "text": "Thọ hưởng vui siêu nhân,"
    },
    {
     "n": 58,
     "text": "Tịnh quán theo chánh pháp."
    },
    {
     "n": 59,
     "text": "Người luôn luôn chánh niệm,"
    },
    {
     "n": 60,
     "text": "Sự sanh diệt các uẩn,"
    },
    {
     "n": 61,
     "text": "Được hoan hỷ, hân hoan,"
    },
    {
     "n": 62,
     "text": "Chỉ bậc bất tử biết."
    },
    {
     "n": 63,
     "text": "Đây Tỳ-kheo có trí,"
    },
    {
     "n": 64,
     "text": "Tu tập pháp căn bản"
    },
    {
     "n": 65,
     "text": "Hộ căn, biết vừa đủ,"
    },
    {
     "n": 66,
     "text": "Gìn giữ căn bản giới,"
    },
    {
     "n": 67,
     "text": "Thường gần gũi bạn lành,"
    },
    {
     "n": 68,
     "text": "Sống thanh tịnh tinh cần."
    },
    {
     "n": 69,
     "text": "Giao thiệp khéo thân thiện,"
    },
    {
     "n": 70,
     "text": "Cử chỉ mực đoan trang."
    },
    {
     "n": 71,
     "text": "Do vậy hưởng vui nhiều,"
    },
    {
     "n": 72,
     "text": "Sẽ dứt mọi khổ đau."
    },
    {
     "n": 73,
     "text": "Như hoa Vassika,"
    },
    {
     "n": 74,
     "text": "Quăng bỏ cánh úa tàn,"
    },
    {
     "n": 75,
     "text": "Cũng vậy vị Tỳ-kheo,"
    },
    {
     "n": 76,
     "text": "Hãy giải thoát tham sân."
    },
    {
     "n": 77,
     "text": "Thân tịnh, lời an tịnh,"
    },
    {
     "n": 78,
     "text": "An tịnh, khéo thiền tịnh."
    },
    {
     "n": 79,
     "text": "Tỳ-kheo bỏ thế vật,"
    },
    {
     "n": 80,
     "text": "Xứng danh bậc tịch tịnh."
    },
    {
     "n": 81,
     "text": "Tự mình chỉ trích mình,"
    },
    {
     "n": 82,
     "text": "Tự mình dò xét mình,"
    },
    {
     "n": 83,
     "text": "Tỳ-kheo tự phòng hộ,"
    },
    {
     "n": 84,
     "text": "Chánh niệm trú an lạc."
    },
    {
     "n": 85,
     "text": "Tự mình y chỉ mình,"
    },
    {
     "n": 86,
     "text": "(dị bản)"
    },
    {
     "n": 87,
     "text": "Tự mình đi đến mình,"
    },
    {
     "n": 88,
     "text": "Vậy hãy tự điều phục,"
    },
    {
     "n": 89,
     "text": "Như khách buôn ngựa hiền."
    },
    {
     "n": 90,
     "text": "Tỳ-kheo nhiều hân hoan,"
    },
    {
     "n": 91,
     "text": "Tịnh tín giáo pháp Phật,"
    },
    {
     "n": 92,
     "text": "Chứng cảnh giới tịch tịnh,"
    },
    {
     "n": 93,
     "text": "Các hạnh an tịnh lạc."
    },
    {
     "n": 94,
     "text": "Tỳ-kheo tuy tuổi nhỏ"
    },
    {
     "n": 95,
     "text": "Siêng tu giáo pháp Phật,"
    },
    {
     "n": 96,
     "text": "Soi sáng thế gian này,"
    },
    {
     "n": 97,
     "text": "Như trăng thoát khỏi mây."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp360-382/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Cakkhunā saṁvaro sādhu,"
    },
    {
     "n": 2,
     "text": "sādhu sotena saṁvaro;"
    },
    {
     "n": 3,
     "text": "Ghānena saṁvaro sādhu,"
    },
    {
     "n": 4,
     "text": "sādhu jivhāya saṁvaro."
    },
    {
     "n": 5,
     "text": "Kāyena saṁvaro sādhu,"
    },
    {
     "n": 6,
     "text": "sādhu vācāya saṁvaro;"
    },
    {
     "n": 7,
     "text": "Manasā saṁvaro sādhu,"
    },
    {
     "n": 8,
     "text": "sādhu sabbattha saṁvaro;"
    },
    {
     "n": 9,
     "text": "Sabbattha saṁvuto bhikkhu,"
    },
    {
     "n": 10,
     "text": "sabbadukkhā pamuccati."
    },
    {
     "n": 11,
     "text": "Hatthasaṁyato pādasaṁyato,"
    },
    {
     "n": 12,
     "text": "Vācāsaṁyato saṁyatuttamo;"
    },
    {
     "n": 13,
     "text": "Ajjhattarato samāhito,"
    },
    {
     "n": 14,
     "text": "Eko santusito tamāhu bhikkhuṁ."
    },
    {
     "n": 15,
     "text": "Yo mukhasaṁyato bhikkhu,"
    },
    {
     "n": 16,
     "text": "mantabhāṇī anuddhato;"
    },
    {
     "n": 17,
     "text": "Atthaṁ dhammañca dīpeti,"
    },
    {
     "n": 18,
     "text": "madhuraṁ tassa bhāsitaṁ."
    },
    {
     "n": 19,
     "text": "Dhammārāmo dhammarato,"
    },
    {
     "n": 20,
     "text": "dhammaṁ anuvicintayaṁ;"
    },
    {
     "n": 21,
     "text": "Dhammaṁ anussaraṁ bhikkhu,"
    },
    {
     "n": 22,
     "text": "saddhammā na parihāyati."
    },
    {
     "n": 23,
     "text": "Salābhaṁ nātimaññeyya,"
    },
    {
     "n": 24,
     "text": "nāññesaṁ pihayaṁ care;"
    },
    {
     "n": 25,
     "text": "Aññesaṁ pihayaṁ bhikkhu,"
    },
    {
     "n": 26,
     "text": "samādhiṁ nādhigacchati."
    },
    {
     "n": 27,
     "text": "Appalābhopi ce bhikkhu,"
    },
    {
     "n": 28,
     "text": "salābhaṁ nātimaññati;"
    },
    {
     "n": 29,
     "text": "Taṁ ve devā pasaṁsanti,"
    },
    {
     "n": 30,
     "text": "suddhājīviṁ atanditaṁ."
    },
    {
     "n": 31,
     "text": "Sabbaso nāmarūpasmiṁ,"
    },
    {
     "n": 32,
     "text": "yassa natthi mamāyitaṁ;"
    },
    {
     "n": 33,
     "text": "Asatā ca na socati,"
    },
    {
     "n": 34,
     "text": "sa ve “bhikkhū”ti vuccati."
    },
    {
     "n": 35,
     "text": "Mettāvihārī yo bhikkhu,"
    },
    {
     "n": 36,
     "text": "pasanno buddhasāsane;"
    },
    {
     "n": 37,
     "text": "Adhigacche padaṁ santaṁ,"
    },
    {
     "n": 38,
     "text": "saṅkhārūpasamaṁ sukhaṁ."
    },
    {
     "n": 39,
     "text": "Siñca bhikkhu imaṁ nāvaṁ,"
    },
    {
     "n": 40,
     "text": "sittā te lahumessati;"
    },
    {
     "n": 41,
     "text": "Chetvā rāgañca dosañca,"
    },
    {
     "n": 42,
     "text": "tato nibbānamehisi."
    },
    {
     "n": 43,
     "text": "Pañca chinde pañca jahe,"
    },
    {
     "n": 44,
     "text": "pañca cuttari bhāvaye;"
    },
    {
     "n": 45,
     "text": "Pañca saṅgātigo bhikkhu,"
    },
    {
     "n": 46,
     "text": "“oghatiṇṇo”ti vuccati."
    },
    {
     "n": 47,
     "text": "Jhāya bhikkhu mā pamādo,"
    },
    {
     "n": 48,
     "text": "Mā te kāmaguṇe ramessu cittaṁ;"
    },
    {
     "n": 49,
     "text": "Mā lohaguḷaṁ gilī pamatto,"
    },
    {
     "n": 50,
     "text": "Mā kandi “dukkhamidan”ti dayhamāno."
    },
    {
     "n": 51,
     "text": "Natthi jhānaṁ apaññassa,"
    },
    {
     "n": 52,
     "text": "paññā natthi ajhāyato;"
    },
    {
     "n": 53,
     "text": "Yamhi jhānañca paññā ca,"
    },
    {
     "n": 54,
     "text": "sa ve nibbānasantike."
    },
    {
     "n": 55,
     "text": "Suññāgāraṁ paviṭṭhassa,"
    },
    {
     "n": 56,
     "text": "santacittassa bhikkhuno;"
    },
    {
     "n": 57,
     "text": "Amānusī rati hoti,"
    },
    {
     "n": 58,
     "text": "sammā dhammaṁ vipassato."
    },
    {
     "n": 59,
     "text": "Yato yato sammasati,"
    },
    {
     "n": 60,
     "text": "khandhānaṁ udayabbayaṁ;"
    },
    {
     "n": 61,
     "text": "Labhatī pītipāmojjaṁ,"
    },
    {
     "n": 62,
     "text": "amataṁ taṁ vijānataṁ."
    },
    {
     "n": 63,
     "text": "Tatrāyamādi bhavati,"
    },
    {
     "n": 64,
     "text": "idha paññassa bhikkhuno;"
    },
    {
     "n": 65,
     "text": "Indriyagutti santuṭṭhi,"
    },
    {
     "n": 66,
     "text": "pātimokkhe ca saṁvaro."
    },
    {
     "n": 67,
     "text": "Mitte bhajassu kalyāṇe,"
    },
    {
     "n": 68,
     "text": "suddhājīve atandite;"
    },
    {
     "n": 69,
     "text": "Paṭisanthāravutyassa,"
    },
    {
     "n": 70,
     "text": "ācārakusalo siyā;"
    },
    {
     "n": 71,
     "text": "Tato pāmojjabahulo,"
    },
    {
     "n": 72,
     "text": "dukkhassantaṁ karissati."
    },
    {
     "n": 73,
     "text": "Vassikā viya pupphāni,"
    },
    {
     "n": 74,
     "text": "maddavāni pamuñcati;"
    },
    {
     "n": 75,
     "text": "Evaṁ rāgañca dosañca,"
    },
    {
     "n": 76,
     "text": "vippamuñcetha bhikkhavo."
    },
    {
     "n": 77,
     "text": "Santakāyo santavāco,"
    },
    {
     "n": 78,
     "text": "santavā susamāhito;"
    },
    {
     "n": 79,
     "text": "Vantalokāmiso bhikkhu,"
    },
    {
     "n": 80,
     "text": "“upasanto”ti vuccati."
    },
    {
     "n": 81,
     "text": "Attanā codayattānaṁ,"
    },
    {
     "n": 82,
     "text": "paṭimaṁsetha attanā;"
    },
    {
     "n": 83,
     "text": "So attagutto satimā,"
    },
    {
     "n": 84,
     "text": "sukhaṁ bhikkhu vihāhisi."
    },
    {
     "n": 85,
     "text": "Attā hi attano nātho,"
    },
    {
     "n": 86,
     "text": "ko hi nātho paro siyā;"
    },
    {
     "n": 87,
     "text": "Attā hi attano gati,"
    },
    {
     "n": 88,
     "text": "tasmā saṁyamamattānaṁ;"
    },
    {
     "n": 89,
     "text": "Assaṁ bhadraṁva vāṇijo."
    },
    {
     "n": 90,
     "text": "Pāmojjabahulo bhikkhu,"
    },
    {
     "n": 91,
     "text": "pasanno buddhasāsane;"
    },
    {
     "n": 92,
     "text": "Adhigacche padaṁ santaṁ,"
    },
    {
     "n": 93,
     "text": "saṅkhārūpasamaṁ sukhaṁ."
    },
    {
     "n": 94,
     "text": "Yo have daharo bhikkhu,"
    },
    {
     "n": 95,
     "text": "yuñjati buddhasāsane;"
    },
    {
     "n": 96,
     "text": "Somaṁ lokaṁ pabhāseti,"
    },
    {
     "n": 97,
     "text": "abbhā muttova candimā."
    }
   ]
  },
