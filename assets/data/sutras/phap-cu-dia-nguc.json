{
 "id": "phap-cu-dia-nguc",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 306-319",
 "summary": "Phẩm thuộc Kinh Pháp Cú (Tiểu Bộ, kệ 306-319), cảnh báo về hậu quả của hạnh ác như nói dối, làm rồi chối, khoác y mà ác hạnh, phóng dật theo vợ người. Phẩm dùng hình ảnh địa ngục để nhắc quả báo của nghiệp xấu, và khuyên giữ giới, nhiếp phục tự thân, giữ chánh kiến để đi vào cõi lành.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Địa Ngục",
  "pli": "Nirayavagga",
  "en": "Hell"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 4,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp306-319/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Nói láo đọa địa ngục"
    },
    {
     "n": 2,
     "text": "Có làm nói không làm,"
    },
    {
     "n": 3,
     "text": "Cả hai chết đồng đẳng,"
    },
    {
     "n": 4,
     "text": "Làm người, nghiệp hạ liệt."
    },
    {
     "n": 5,
     "text": "Nhiều người khoác cà-sa,"
    },
    {
     "n": 6,
     "text": "Ác hạnh không nhiếp phục."
    },
    {
     "n": 7,
     "text": "Người ác, do ác hạnh,"
    },
    {
     "n": 8,
     "text": "Phải sanh cõi Địa ngục."
    },
    {
     "n": 9,
     "text": "Tốt hơn nuốt hòn sắt"
    },
    {
     "n": 10,
     "text": "Cháy đỏ như than hồng,"
    },
    {
     "n": 11,
     "text": "Hơn ác giới, buông lung"
    },
    {
     "n": 12,
     "text": "Ăn đồ ăn quốc độ."
    },
    {
     "n": 13,
     "text": "Bốn nạn chờ đợi người,"
    },
    {
     "n": 14,
     "text": "Phóng dật theo vợ người;"
    },
    {
     "n": 15,
     "text": "Mắc họa, ngủ không yên,"
    },
    {
     "n": 16,
     "text": "Bị chê là thứ ba, Đọa địa ngục, thứ bốn."
    },
    {
     "n": 17,
     "text": "Mắc họa, đọa ác thú,"
    },
    {
     "n": 18,
     "text": "Bị hoảng sợ, ít vui."
    },
    {
     "n": 19,
     "text": "Quốc vương phạt trọng hình."
    },
    {
     "n": 20,
     "text": "Vậy chớ theo vợ người."
    },
    {
     "n": 21,
     "text": "Như cỏ sa vụng nắm,"
    },
    {
     "n": 22,
     "text": "Tất bị họa đứt tay."
    },
    {
     "n": 23,
     "text": "Hạnh sa môn tà vạy,"
    },
    {
     "n": 24,
     "text": "Tất bị đọa địa ngục."
    },
    {
     "n": 25,
     "text": "Sống phóng đãng buông lung,"
    },
    {
     "n": 26,
     "text": "Theo giới cấm ô nhiễm,"
    },
    {
     "n": 27,
     "text": "Sống phạm hạnh đáng nghi"
    },
    {
     "n": 28,
     "text": "Sao chứng được quả lớn."
    },
    {
     "n": 29,
     "text": "Cần phải làm, nên làm"
    },
    {
     "n": 30,
     "text": "Làm cùng tận khả năng"
    },
    {
     "n": 31,
     "text": "Xuất gia sống phóng đãng,"
    },
    {
     "n": 32,
     "text": "Chỉ tăng loạn bụi đời."
    },
    {
     "n": 33,
     "text": "Ác hạnh không nên làm,"
    },
    {
     "n": 34,
     "text": "Làm xong, chịu khổ lụy,"
    },
    {
     "n": 35,
     "text": "Thiện hạnh, ắt nên làm,"
    },
    {
     "n": 36,
     "text": "Làm xong, không ăn năn."
    },
    {
     "n": 37,
     "text": "Như thành ở biên thùy,"
    },
    {
     "n": 38,
     "text": "Trong ngoài điều phòng hộ"
    },
    {
     "n": 39,
     "text": "Cũng vậy, phòng hộ mình,"
    },
    {
     "n": 40,
     "text": "Sát na chớ buông lung."
    },
    {
     "n": 41,
     "text": "Sát na chớ buông lung."
    },
    {
     "n": 42,
     "text": "Khi rơi vào địa ngục."
    },
    {
     "n": 43,
     "text": "Không đáng hổ, lại hổ."
    },
    {
     "n": 44,
     "text": "Việc đáng hổ, lại không."
    },
    {
     "n": 45,
     "text": "Do chấp nhận tà kiến,"
    },
    {
     "n": 46,
     "text": "Chúng sanh đi ác thú."
    },
    {
     "n": 47,
     "text": "Không đáng sợ, lại sợ,"
    },
    {
     "n": 48,
     "text": "Đáng sợ, lại thấy không,"
    },
    {
     "n": 49,
     "text": "Do chấp nhận tà kiến,"
    },
    {
     "n": 50,
     "text": "Chúng sanh đi ác thú."
    },
    {
     "n": 51,
     "text": "Không lỗi, lại thấy lỗi,"
    },
    {
     "n": 52,
     "text": "Có lỗi, lại thấy không,"
    },
    {
     "n": 53,
     "text": "Do chấp nhận tà kiến,"
    },
    {
     "n": 54,
     "text": "Chúng sanh đi ác thú."
    },
    {
     "n": 55,
     "text": "Có lỗi, biết có lỗi,"
    },
    {
     "n": 56,
     "text": "Không lỗi, biết là không,"
    },
    {
     "n": 57,
     "text": "Do chấp nhận chánh kiến,"
    },
    {
     "n": 58,
     "text": "Chúng sanh đi cõi lành."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp306-319/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Abhūtavādī nirayaṁ upeti,"
    },
    {
     "n": 2,
     "text": "Yo vāpi katvā na karomi cāha;"
    },
    {
     "n": 3,
     "text": "Ubhopi te pecca samā bhavanti,"
    },
    {
     "n": 4,
     "text": "Nihīnakammā manujā parattha."
    },
    {
     "n": 5,
     "text": "Kāsāvakaṇṭhā bahavo,"
    },
    {
     "n": 6,
     "text": "pāpadhammā asaññatā;"
    },
    {
     "n": 7,
     "text": "Pāpā pāpehi kammehi,"
    },
    {
     "n": 8,
     "text": "nirayaṁ te upapajjare."
    },
    {
     "n": 9,
     "text": "Seyyo ayoguḷo bhutto,"
    },
    {
     "n": 10,
     "text": "tatto aggisikhūpamo;"
    },
    {
     "n": 11,
     "text": "Yañce bhuñjeyya dussīlo,"
    },
    {
     "n": 12,
     "text": "raṭṭhapiṇḍamasaññato."
    },
    {
     "n": 13,
     "text": "Cattāri ṭhānāni naro pamatto,"
    },
    {
     "n": 14,
     "text": "Āpajjati paradārūpasevī;"
    },
    {
     "n": 15,
     "text": "Apuññalābhaṁ na nikāmaseyyaṁ,"
    },
    {
     "n": 16,
     "text": "Nindaṁ tatīyaṁ nirayaṁ catutthaṁ."
    },
    {
     "n": 17,
     "text": "Apuññalābho ca gatī ca pāpikā,"
    },
    {
     "n": 18,
     "text": "Bhītassa bhītāya ratī ca thokikā;"
    },
    {
     "n": 19,
     "text": "Rājā ca daṇḍaṁ garukaṁ paṇeti,"
    },
    {
     "n": 20,
     "text": "Tasmā naro paradāraṁ na seve."
    },
    {
     "n": 21,
     "text": "Kuso yathā duggahito,"
    },
    {
     "n": 22,
     "text": "hatthamevānukantati;"
    },
    {
     "n": 23,
     "text": "Sāmaññaṁ dupparāmaṭṭhaṁ,"
    },
    {
     "n": 24,
     "text": "nirayāyupakaḍḍhati."
    },
    {
     "n": 25,
     "text": "Yaṁ kiñci sithilaṁ kammaṁ,"
    },
    {
     "n": 26,
     "text": "saṅkiliṭṭhañca yaṁ vataṁ;"
    },
    {
     "n": 27,
     "text": "Saṅkassaraṁ brahmacariyaṁ,"
    },
    {
     "n": 28,
     "text": "na taṁ hoti mahapphalaṁ."
    },
    {
     "n": 29,
     "text": "Kayirā ce kayirāthenaṁ,"
    },
    {
     "n": 30,
     "text": "daḷhamenaṁ parakkame;"
    },
    {
     "n": 31,
     "text": "Sithilo hi paribbājo,"
    },
    {
     "n": 32,
     "text": "bhiyyo ākirate rajaṁ."
    },
    {
     "n": 33,
     "text": "Akataṁ dukkaṭaṁ seyyo,"
    },
    {
     "n": 34,
     "text": "pacchā tappati dukkaṭaṁ;"
    },
    {
     "n": 35,
     "text": "Katañca sukataṁ seyyo,"
    },
    {
     "n": 36,
     "text": "yaṁ katvā nānutappati."
    },
    {
     "n": 37,
     "text": "Nagaraṁ yathā paccantaṁ,"
    },
    {
     "n": 38,
     "text": "guttaṁ santarabāhiraṁ;"
    },
    {
     "n": 39,
     "text": "Evaṁ gopetha attānaṁ,"
    },
    {
     "n": 40,
     "text": "khaṇo vo mā upaccagā;"
    },
    {
     "n": 41,
     "text": "Khaṇātītā hi socanti,"
    },
    {
     "n": 42,
     "text": "nirayamhi samappitā."
    },
    {
     "n": 43,
     "text": "Alajjitāye lajjanti,"
    },
    {
     "n": 44,
     "text": "lajjitāye na lajjare;"
    },
    {
     "n": 45,
     "text": "Micchādiṭṭhisamādānā,"
    },
    {
     "n": 46,
     "text": "sattā gacchanti duggatiṁ."
    },
    {
     "n": 47,
     "text": "Abhaye bhayadassino,"
    },
    {
     "n": 48,
     "text": "bhaye cābhayadassino;"
    },
    {
     "n": 49,
     "text": "Micchādiṭṭhisamādānā,"
    },
    {
     "n": 50,
     "text": "sattā gacchanti duggatiṁ."
    },
    {
     "n": 51,
     "text": "Avajje vajjamatino,"
    },
    {
     "n": 52,
     "text": "vajje cāvajjadassino;"
    },
    {
     "n": 53,
     "text": "Micchādiṭṭhisamādānā,"
    },
    {
     "n": 54,
     "text": "sattā gacchanti duggatiṁ."
    },
    {
     "n": 55,
     "text": "Vajjañca vajjato ñatvā,"
    },
    {
     "n": 56,
     "text": "avajjañca avajjato;"
    },
    {
     "n": 57,
     "text": "Sammādiṭṭhisamādānā,"
    },
    {
     "n": 58,
     "text": "sattā gacchanti suggatiṁ."
    }
   ]
  },
  {
   "key": "en-translation",
   "lang": "en",
   "variant": "translation",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp306-319/sujato?lang=en (translation_text)",
