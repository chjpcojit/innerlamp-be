{
 "id": "phap-cu-gia",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 146-156",
 "summary": "Phẩm thuộc Kinh Pháp Cú (Tiểu Bộ, kệ 146-156), nói về già, bệnh và sự mong manh của thân xác. Phẩm đặt câu hỏi vì sao còn cười vui khi đời mãi bị thiêu đốt, nhắc thân này rồi cũng suy hoại, cái chết chấm dứt mạng sống. Phẩm khuyên người đọc sống tinh tấn, giữ phạm hạnh khi còn trẻ để khỏi hối tiếc về sau.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Già",
  "pli": "Jarāvagga",
  "en": "Old Age"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 3,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp146-156/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Cười gì, hân hoan gì,"
    },
    {
     "n": 2,
     "text": "Khi đời mãi bị thiêu?"
    },
    {
     "n": 3,
     "text": "Bị tối tăm bao trùm,"
    },
    {
     "n": 4,
     "text": "Sao không tìm ngọn đèn?"
    },
    {
     "n": 5,
     "text": "Hãy xem bong bóng đẹp,"
    },
    {
     "n": 6,
     "text": "Chỗ chất chứa vết thương,"
    },
    {
     "n": 7,
     "text": "Bệnh hoạn nhiều suy tư,"
    },
    {
     "n": 8,
     "text": "Thật không gì trường cửu."
    },
    {
     "n": 9,
     "text": "Sắc này bị suy già,"
    },
    {
     "n": 10,
     "text": "Ổ tật bệnh, mỏng manh,"
    },
    {
     "n": 11,
     "text": "Nhóm bất tịnh đổ vỡ,"
    },
    {
     "n": 12,
     "text": "Chết chấm dứt mạng sống."
    },
    {
     "n": 13,
     "text": "Như trái bầu mùa thu,"
    },
    {
     "n": 14,
     "text": "Bị vất bỏ quăng đi,"
    },
    {
     "n": 15,
     "text": "Nhóm xương trắng bồ câu,"
    },
    {
     "n": 16,
     "text": "Thấy chúng còn vui gì?"
    },
    {
     "n": 17,
     "text": "Thành này làm bằng xương,"
    },
    {
     "n": 18,
     "text": "Quét tô bằng thịt máu,"
    },
    {
     "n": 19,
     "text": "Ở đây già và chết,"
    },
    {
     "n": 20,
     "text": "Mạn, lừa đảo chất chứa."
    },
    {
     "n": 21,
     "text": "Xe vua đẹp cũng già,"
    },
    {
     "n": 22,
     "text": "Thân này rồi sẽ già."
    },
    {
     "n": 23,
     "text": "Pháp bậc thiện, không già."
    },
    {
     "n": 24,
     "text": "Như vậy bậc chí thiện Nói lên cho bậc thiện."
    },
    {
     "n": 25,
     "text": "Người ít nghe kém học,"
    },
    {
     "n": 26,
     "text": "Lớn già như trâu đực."
    },
    {
     "n": 27,
     "text": "Thịt nó tuy lớn lên,"
    },
    {
     "n": 28,
     "text": "Nhưng tuệ không tăng trưởng."
    },
    {
     "n": 29,
     "text": "Lang thang bao kiếp sống"
    },
    {
     "n": 30,
     "text": "Ta tìm nhưng chẳng gặp,"
    },
    {
     "n": 31,
     "text": "Người xây dựng nhà này,"
    },
    {
     "n": 32,
     "text": "Khổ thay, phải tái sanh."
    },
    {
     "n": 33,
     "text": "Ôi! Người làm nhà kia Nay ta đã thấy ngươi!"
    },
    {
     "n": 34,
     "text": "Người không làm nhà nữa."
    },
    {
     "n": 35,
     "text": "Đòn tay ngươi bị gẫy,"
    },
    {
     "n": 36,
     "text": "Kèo cột ngươi bị tan"
    },
    {
     "n": 37,
     "text": "Tâm ta đạt tịch diệt,"
    },
    {
     "n": 38,
     "text": "Tham ái thảy tiêu vong."
    },
    {
     "n": 39,
     "text": "Lúc trẻ, không phạm hạnh,"
    },
    {
     "n": 40,
     "text": "Không tìm kiếm bạc tiền."
    },
    {
     "n": 41,
     "text": "Như cò già bên ao,"
    },
    {
     "n": 42,
     "text": "Ủ rũ, không tôm cá."
    },
    {
     "n": 43,
     "text": "Lúc trẻ, không phạm hạnh,"
    },
    {
     "n": 44,
     "text": "Không tìm kiếm bạc tiền."
    },
    {
     "n": 45,
     "text": "Như cây cung bị gãy,"
    },
    {
     "n": 46,
     "text": "Thở than những ngày qua."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp146-156/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Ko nu hāso kimānando,"
    },
    {
     "n": 2,
     "text": "niccaṁ pajjalite sati;"
    },
    {
     "n": 3,
     "text": "Andhakārena onaddhā,"
    },
    {
     "n": 4,
     "text": "padīpaṁ na gavesatha."
    },
    {
     "n": 5,
     "text": "Passa cittakataṁ bimbaṁ,"
    },
    {
     "n": 6,
     "text": "arukāyaṁ samussitaṁ;"
    },
    {
     "n": 7,
     "text": "Āturaṁ bahusaṅkappaṁ,"
    },
    {
     "n": 8,
     "text": "yassa natthi dhuvaṁ ṭhiti."
    },
    {
     "n": 9,
     "text": "Parijiṇṇamidaṁ rūpaṁ,"
    },
    {
     "n": 10,
     "text": "roganīḷaṁ pabhaṅguraṁ;"
    },
    {
     "n": 11,
     "text": "Bhijjati pūtisandeho,"
    },
    {
     "n": 12,
     "text": "maraṇantañhi jīvitaṁ."
    },
    {
     "n": 13,
     "text": "Yānimāni apatthāni,"
    },
    {
     "n": 14,
     "text": "alābūneva sārade;"
    },
    {
     "n": 15,
     "text": "Kāpotakāni aṭṭhīni,"
    },
    {
     "n": 16,
     "text": "tāni disvāna kā rati."
    },
    {
     "n": 17,
     "text": "Aṭṭhīnaṁ nagaraṁ kataṁ,"
    },
    {
     "n": 18,
     "text": "maṁsalohitalepanaṁ;"
    },
    {
     "n": 19,
     "text": "Yattha jarā ca maccu ca,"
    },
    {
     "n": 20,
     "text": "māno makkho ca ohito."
    },
    {
     "n": 21,
     "text": "Jīranti ve rājarathā sucittā,"
    },
    {
     "n": 22,
     "text": "Atho sarīrampi jaraṁ upeti;"
    },
    {
     "n": 23,
     "text": "Satañca dhammo na jaraṁ upeti,"
    },
    {
     "n": 24,
     "text": "Santo have sabbhi pavedayanti."
    },
    {
     "n": 25,
     "text": "Appassutāyaṁ puriso,"
    },
    {
     "n": 26,
     "text": "balībaddhova jīrati;"
    },
    {
     "n": 27,
     "text": "Maṁsāni tassa vaḍḍhanti,"
    },
    {
     "n": 28,
     "text": "paññā tassa na vaḍḍhati."
    },
    {
     "n": 29,
     "text": "Anekajātisaṁsāraṁ,"
    },
    {
     "n": 30,
     "text": "sandhāvissaṁ anibbisaṁ;"
    },
    {
     "n": 31,
     "text": "Gahakāraṁ gavesanto,"
    },
    {
     "n": 32,
     "text": "dukkhā jāti punappunaṁ."
    },
    {
     "n": 33,
     "text": "Gahakāraka diṭṭhosi,"
    },
    {
     "n": 34,
     "text": "puna gehaṁ na kāhasi;"
    },
    {
     "n": 35,
     "text": "Sabbā te phāsukā bhaggā,"
    },
    {
     "n": 36,
     "text": "gahakūṭaṁ visaṅkhataṁ;"
    },
    {
     "n": 37,
     "text": "Visaṅkhāragataṁ cittaṁ,"
    },
    {
     "n": 38,
     "text": "taṇhānaṁ khayamajjhagā."
    },
    {
     "n": 39,
     "text": "Acaritvā brahmacariyaṁ,"
    },
    {
     "n": 40,
     "text": "aladdhā yobbane dhanaṁ;"
    },
    {
     "n": 41,
     "text": "Jiṇṇakoñcāva jhāyanti,"
    },
    {
     "n": 42,
     "text": "khīṇamaccheva pallale."
    },
    {
     "n": 43,
     "text": "Acaritvā brahmacariyaṁ,"
    },
    {
     "n": 44,
     "text": "aladdhā yobbane dhanaṁ;"
    },
    {
     "n": 45,
     "text": "Senti cāpātikhīṇāva,"
    },
    {
     "n": 46,
     "text": "purāṇāni anutthunaṁ."
    }
   ]
  },
  {
   "key": "en-translation",
   "lang": "en",
   "variant": "translation",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp146-156/sujato?lang=en (translation_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (bilara-data _publication-v2.json); the translator additionally requests that use not be for AI training datasets, AI models or AI-derived technologies",
   "lines": [
    {
     "n": 1,
     "text": "What is joy, what is laughter,"
    },
    {
     "n": 2,
     "text": "when the flames are ever burning?"
    },
    {
     "n": 3,
     "text": "Swathed in darkness,"
    },
    {
     "n": 4,
     "text": "would you not seek a light?"
    },
    {
     "n": 5,
     "text": "See this fancy puppet,"
    },
    {
     "n": 6,
     "text": "a body built of sores,"
    },
    {
     "n": 7,
     "text": "diseased, obsessed over,"
    },
    {
     "n": 8,
     "text": "in which nothing lasts at all."
    },
    {
     "n": 9,
     "text": "This body is decrepit and frail,"
    },
    {
     "n": 10,
     "text": "a nest of disease."
    },
    {
     "n": 11,
     "text": "This foul carcass falls apart,"
    },
    {
     "n": 12,
     "text": "for life ends in death."
    },
    {
     "n": 13,
     "text": "These dove-grey bones"
    },
    {
     "n": 14,
     "text": "are tossed away like"
    },
    {
     "n": 15,
     "text": "dried gourds in the autumn—"
    },
    {
     "n": 16,
     "text": "what joy is there in such a sight?"
    },
    {
     "n": 17,
     "text": "In this city built of bones,"
    },
    {
     "n": 18,
     "text": "plastered with flesh and blood,"
    },
    {
     "n": 19,
     "text": "old age and death are stashed away,"
    },
    {
     "n": 20,
     "text": "along with conceit and contempt."
    },
    {
     "n": 21,
     "text": "Fancy chariots of kings wear out,"
    },
    {
     "n": 22,
     "text": "and even this body gets old."
    },
    {
     "n": 23,
     "text": "But the truth of the good never gets old—"
    },
    {
     "n": 24,
     "text": "so the good proclaim to the good."
    },
    {
     "n": 25,
     "text": "A person of little learning"
    },
    {
     "n": 26,
     "text": "ages like an ox—"
    },
    {
     "n": 27,
     "text": "their flesh grows,"
    },
    {
     "n": 28,
     "text": "but not their wisdom."
    },
    {
     "n": 29,
     "text": "Transmigrating through countless rebirths,"
    },
    {
     "n": 30,
     "text": "I’ve journeyed without reward,"
    },
    {
     "n": 31,
     "text": "searching for the house-builder;"
    },
    {
     "n": 32,
     "text": "painful is birth again and again."
    },
    {
     "n": 33,
     "text": "I’ve seen you, house-builder!"
    },
    {
     "n": 34,
     "text": "You won’t build a house again!"
    },
    {
     "n": 35,
     "text": "Your rafters are all broken,"
    },
    {
     "n": 36,
     "text": "your roof-peak demolished."
    },
    {
     "n": 37,
     "text": "The mind, set on demolition,"
    },
    {
     "n": 38,
     "text": "has reached the end of cravings."
    },
    {
     "n": 39,
     "text": "When young they spurned the spiritual path"
    },
    {
     "n": 40,
     "text": "and failed to earn any wealth."
    },
    {
     "n": 41,
     "text": "Now they brood like old cranes"
    },
    {
     "n": 42,
     "text": "in a pond bereft of fish."
    },
    {
     "n": 43,
     "text": "When young they spurned the spiritual path"
    },
    {
     "n": 44,
     "text": "and failed to earn any wealth."
    },
    {
     "n": 45,
     "text": "Now they lie like spent arrows,"
    },
    {
     "n": 46,
     "text": "bemoaning over things past."
    }
   ]
  }
 ]
}
