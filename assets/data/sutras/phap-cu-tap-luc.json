   "lines": [
    {
     "n": 1,
     "text": "Nhờ từ bỏ lạc nhỏ,"
    },
    {
     "n": 2,
     "text": "Thấy được lạc lớn hơn,"
    },
    {
     "n": 3,
     "text": "Bậc trí bỏ lạc nhỏ,"
    },
    {
     "n": 4,
     "text": "Thấy được lạc lớn hơn."
    },
    {
     "n": 5,
     "text": "Gieo khổ đau cho người,"
    },
    {
     "n": 6,
     "text": "Mong cầu lạc cho mình,"
    },
    {
     "n": 7,
     "text": "Bị hận thù buộc ràng"
    },
    {
     "n": 8,
     "text": "Không sao thoát hận thù."
    },
    {
     "n": 9,
     "text": "Việc đáng làm, không làm,"
    },
    {
     "n": 10,
     "text": "Không đáng làm, lại làm,"
    },
    {
     "n": 11,
     "text": "Người ngạo mạn, phóng dật,"
    },
    {
     "n": 12,
     "text": "Lậu hoặc ắt tăng trưởng."
    },
    {
     "n": 13,
     "text": "Người siêng năng cần mẫn,"
    },
    {
     "n": 14,
     "text": "Thường thường quán thân niệm,"
    },
    {
     "n": 15,
     "text": "Không làm việc không đáng,"
    },
    {
     "n": 16,
     "text": "Gắng làm việc đáng làm,"
    },
    {
     "n": 17,
     "text": "Người tư niệm giác tỉnh,"
    },
    {
     "n": 18,
     "text": "Lậu hoặc được tiêu trừ."
    },
    {
     "n": 19,
     "text": "Sau khi giết mẹ cha"
    },
    {
     "n": 20,
     "text": "Giết hai vua Sát-lỵ"
    },
    {
     "n": 21,
     "text": "Giết vương quốc, quần thần"
    },
    {
     "n": 22,
     "text": "Vô ưu, Phạm chí sống."
    },
    {
     "n": 23,
     "text": "Sau khi giết mẹ cha,"
    },
    {
     "n": 24,
     "text": "Hai vua Bà-la-môn"
    },
    {
     "n": 25,
     "text": "Giết hổ tướng thứ năm"
    },
    {
     "n": 26,
     "text": "Vô ưu, Phạm chí sống."
    },
    {
     "n": 27,
     "text": "Đệ tử Gotama,"
    },
    {
     "n": 28,
     "text": "Luôn luôn tự tỉnh giác"
    },
    {
     "n": 29,
     "text": "Vô luận ngày hay đêm,"
    },
    {
     "n": 30,
     "text": "Thường tưởng niệm Phật-đà."
    },
    {
     "n": 31,
     "text": "Đệ tử Gotama,"
    },
    {
     "n": 32,
     "text": "Luôn luôn tự tỉnh giác,"
    },
    {
     "n": 33,
     "text": "Vô luận ngày hay đêm,"
    },
    {
     "n": 34,
     "text": "Thường tưởng niệm Chánh Pháp."
    },
    {
     "n": 35,
     "text": "Đệ tử Gotama,"
    },
    {
     "n": 36,
     "text": "Luôn luôn tự tỉnh giác,"
    },
    {
     "n": 37,
     "text": "Vô luận ngày hay đêm,"
    },
    {
     "n": 38,
     "text": "Thường tưởng niệm Tăng già."
    },
    {
     "n": 39,
     "text": "Đệ tử Gotama,"
    },
    {
     "n": 40,
     "text": "Luôn luôn tự tỉnh giác,"
    },
    {
     "n": 41,
     "text": "Vô luận ngày hay đêm,"
    },
    {
     "n": 42,
     "text": "Thường tưởng niệm sắc thân."
    },
    {
     "n": 43,
     "text": "Đệ tử Gotama,"
    },
    {
     "n": 44,
     "text": "Luôn luôn tự tỉnh giác,"
    },
    {
     "n": 45,
     "text": "Vô luận ngày hay đêm,"
    },
    {
     "n": 46,
     "text": "Ý vui niềm bất hại."
    },
    {
     "n": 47,
     "text": "Đệ tử Gotama,"
    },
    {
     "n": 48,
     "text": "Luôn luôn tự tỉnh giác,"
    },
    {
     "n": 49,
     "text": "Vô luận ngày hay đêm,"
    },
    {
     "n": 50,
     "text": "Ý vui tu thiền quán."
    },
    {
     "n": 51,
     "text": "Vui hạnh xuất gia khó,"
    },
    {
     "n": 52,
     "text": "Tại gia sinh hoạt khó,"
    },
    {
     "n": 53,
     "text": "Sống bạn không đồng, khổ,"
    },
    {
     "n": 54,
     "text": "Trôi lăn luân hồi, khổ."
    },
    {
     "n": 55,
     "text": "Vậy chớ sống luân hồi,"
    },
    {
     "n": 56,
     "text": "Chớ chạy theo đau khổ."
    },
    {
     "n": 57,
     "text": "Tín tâm, sống giới hạnh"
    },
    {
     "n": 58,
     "text": "Đủ danh xưng tài sản,"
    },
    {
     "n": 59,
     "text": "Chỗ nào người ấy đến,"
    },
    {
     "n": 60,
     "text": "Chỗ ấy được cung kính."
    },
    {
     "n": 61,
     "text": "Người lành dầu ở xa"
    },
    {
     "n": 62,
     "text": "Sáng tỏ như núi tuyết,"
    },
    {
     "n": 63,
     "text": "Người ác dầu ở gần"
    },
    {
     "n": 64,
     "text": "Như tên bắn đêm đen."
    },
    {
     "n": 65,
     "text": "Ai ngồi nằm một mình,"
    },
    {
     "n": 66,
     "text": "Độc hành không buồn chán,"
    },
    {
     "n": 67,
     "text": "Tự điều phục một mình"
    },
    {
     "n": 68,
     "text": "Sống thoải mái rừng sâu."
    }
   ]
  },
  {
   "key": "pli-translation",
