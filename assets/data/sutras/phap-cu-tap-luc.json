   "lines": [
    {
     "n": 1,
     "text": "Mattāsukhapariccāgā,"
    },
    {
     "n": 2,
     "text": "passe ce vipulaṁ sukhaṁ;"
    },
    {
     "n": 3,
     "text": "Caje mattāsukhaṁ dhīro,"
    },
    {
     "n": 4,
     "text": "sampassaṁ vipulaṁ sukhaṁ."
    },
    {
     "n": 5,
     "text": "Paradukkhūpadhānena,"
    },
    {
     "n": 6,
     "text": "attano sukhamicchati;"
    },
    {
     "n": 7,
     "text": "Verasaṁsaggasaṁsaṭṭho,"
    },
    {
     "n": 8,
     "text": "verā so na parimuccati."
    },
    {
     "n": 9,
     "text": "Yañhi kiccaṁ apaviddhaṁ,"
    },
    {
     "n": 10,
     "text": "akiccaṁ pana karīyati;"
    },
    {
     "n": 11,
     "text": "Unnaḷānaṁ pamattānaṁ,"
    },
    {
     "n": 12,
     "text": "tesaṁ vaḍḍhanti āsavā."
    },
    {
     "n": 13,
     "text": "Yesañca susamāraddhā,"
    },
    {
     "n": 14,
     "text": "niccaṁ kāyagatā sati;"
    },
    {
     "n": 15,
     "text": "Akiccaṁ te na sevanti,"
    },
    {
     "n": 16,
     "text": "kicce sātaccakārino;"
    },
    {
     "n": 17,
     "text": "Satānaṁ sampajānānaṁ,"
    },
    {
     "n": 18,
     "text": "atthaṁ gacchanti āsavā."
    },
    {
     "n": 19,
     "text": "Mātaraṁ pitaraṁ hantvā,"
    },
    {
     "n": 20,
     "text": "rājāno dve ca khattiye;"
    },
    {
     "n": 21,
     "text": "Raṭṭhaṁ sānucaraṁ hantvā,"
    },
    {
     "n": 22,
     "text": "anīgho yāti brāhmaṇo."
    },
    {
     "n": 23,
     "text": "Mātaraṁ pitaraṁ hantvā,"
    },
    {
     "n": 24,
     "text": "rājāno dve ca sotthiye;"
    },
    {
     "n": 25,
     "text": "Veyagghapañcamaṁ hantvā,"
    },
    {
     "n": 26,
     "text": "anīgho yāti brāhmaṇo."
    },
    {
     "n": 27,
     "text": "Suppabuddhaṁ pabujjhanti,"
    },
    {
     "n": 28,
     "text": "sadā gotamasāvakā;"
    },
    {
     "n": 29,
     "text": "Yesaṁ divā ca ratto ca,"
    },
    {
     "n": 30,
     "text": "niccaṁ buddhagatā sati."
    },
    {
     "n": 31,
     "text": "Suppabuddhaṁ pabujjhanti,"
    },
    {
     "n": 32,
     "text": "sadā gotamasāvakā;"
    },
    {
     "n": 33,
     "text": "Yesaṁ divā ca ratto ca,"
    },
    {
     "n": 34,
     "text": "niccaṁ dhammagatā sati."
    },
    {
     "n": 35,
     "text": "Suppabuddhaṁ pabujjhanti,"
    },
    {
     "n": 36,
     "text": "sadā gotamasāvakā;"
    },
    {
     "n": 37,
     "text": "Yesaṁ divā ca ratto ca,"
    },
    {
     "n": 38,
     "text": "niccaṁ saṅghagatā sati."
    },
    {
     "n": 39,
     "text": "Suppabuddhaṁ pabujjhanti,"
    },
    {
     "n": 40,
     "text": "sadā gotamasāvakā;"
    },
    {
     "n": 41,
     "text": "Yesaṁ divā ca ratto ca,"
    },
    {
     "n": 42,
     "text": "niccaṁ kāyagatā sati."
    },
    {
     "n": 43,
     "text": "Suppabuddhaṁ pabujjhanti,"
    },
    {
     "n": 44,
     "text": "sadā gotamasāvakā;"
    },
    {
     "n": 45,
     "text": "Yesaṁ divā ca ratto ca,"
    },
    {
     "n": 46,
     "text": "ahiṁsāya rato mano."
    },
    {
     "n": 47,
     "text": "Suppabuddhaṁ pabujjhanti,"
    },
    {
     "n": 48,
     "text": "sadā gotamasāvakā;"
    },
    {
     "n": 49,
     "text": "Yesaṁ divā ca ratto ca,"
    },
    {
     "n": 50,
     "text": "bhāvanāya rato mano."
    },
    {
     "n": 51,
     "text": "Duppabbajjaṁ durabhiramaṁ,"
    },
    {
     "n": 52,
     "text": "Durāvāsā gharā dukhā;"
    },
    {
     "n": 53,
     "text": "Dukkhosamānasaṁvāso,"
    },
    {
     "n": 54,
     "text": "Dukkhānupatitaddhagū;"
    },
    {
     "n": 55,
     "text": "Tasmā na caddhagū siyā,"
    },
    {
     "n": 56,
     "text": "Na ca dukkhānupatito siyā."
    },
    {
     "n": 57,
     "text": "Saddho sīlena sampanno,"
    },
    {
     "n": 58,
     "text": "yasobhogasamappito;"
    },
    {
     "n": 59,
     "text": "Yaṁ yaṁ padesaṁ bhajati,"
    },
    {
     "n": 60,
     "text": "tattha tattheva pūjito."
    },
    {
     "n": 61,
     "text": "Dūre santo pakāsenti,"
    },
    {
     "n": 62,
     "text": "himavantova pabbato;"
    },
    {
     "n": 63,
     "text": "Asantettha na dissanti,"
    },
    {
     "n": 64,
     "text": "rattiṁ khittā yathā sarā."
    },
    {
     "n": 65,
     "text": "Ekāsanaṁ ekaseyyaṁ,"
    },
    {
     "n": 66,
     "text": "eko caramatandito;"
    },
    {
     "n": 67,
     "text": "Eko damayamattānaṁ,"
    },
    {
     "n": 68,
     "text": "vanante ramito siyā."
    }
   ]
  },
