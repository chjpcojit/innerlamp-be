{
 "id": "phap-cu-tham-ai",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 334-359",
 "summary": "Phẩm kệ trong Kinh Pháp Cú (Tiểu Bộ, Dhp 334–359) bàn về tham ái. Kệ ví ái dục lan nhanh như dây leo, khiến người phóng dật nhảy từ đời này sang đời khác, và nhắc rằng sầu khổ tăng theo ái nhưng sẽ rơi khỏi người đã hàng phục được ái. Phẩm khuyên nhổ tận gốc ái dục và nhắc rằng bố thí cho người ly dục thì được quả lớn.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Tham Ái",
  "pli": "Taṇhāvagga",
  "en": "Craving"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 8,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp334-359/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Người sống đời phóng dật,"
    },
    {
     "n": 2,
     "text": "Ái tăng như dây leo."
    },
    {
     "n": 3,
     "text": "Nhảy đời này đời khác,"
    },
    {
     "n": 4,
     "text": "Như vượn tham quả rừng."
    },
    {
     "n": 5,
     "text": "Ai sống trong đời này,"
    },
    {
     "n": 6,
     "text": "Bị ái dục buộc ràng"
    },
    {
     "n": 7,
     "text": "Sầu khổ sẽ tăng trưởng,"
    },
    {
     "n": 8,
     "text": "Như cỏ bi gặp mưa."
    },
    {
     "n": 9,
     "text": "Ai sống trong đời này"
    },
    {
     "n": 10,
     "text": "Ái dục được hàng phục"
    },
    {
     "n": 11,
     "text": "Sầu rơi khỏi người ấy"
    },
    {
     "n": 12,
     "text": "Như giọt nước lá sen."
    },
    {
     "n": 13,
     "text": "Đây điều lành Ta dạy,"
    },
    {
     "n": 14,
     "text": "Các người tụ họp đây,"
    },
    {
     "n": 15,
     "text": "Hãy nhổ tận gốc ái"
    },
    {
     "n": 16,
     "text": "Như nhổ gốc cỏ bi."
    },
    {
     "n": 17,
     "text": "Chớ để ma phá hoại,"
    },
    {
     "n": 18,
     "text": "Như dòng nước cỏ lau."
    },
    {
     "n": 19,
     "text": "Như cây bị chặt đốn,"
    },
    {
     "n": 20,
     "text": "Gốc chưa hại vẫn bền"
    },
    {
     "n": 21,
     "text": "Ái tùy miên chưa nhổ,"
    },
    {
     "n": 22,
     "text": "Khổ này vẫn sanh hoài."
    },
    {
     "n": 23,
     "text": "Ba mươi sáu dòng ái,"
    },
    {
     "n": 24,
     "text": "Trôi người đến khả ái."
    },
    {
     "n": 25,
     "text": "Các tư tưởng tham ái."
    },
    {
     "n": 26,
     "text": "Cuốn trôi người tà kiến."
    },
    {
     "n": 27,
     "text": "Dòng ái dục chảy khắp,"
    },
    {
     "n": 28,
     "text": "Như giây leo mọc tràn,"
    },
    {
     "n": 29,
     "text": "Thấy giây leo vừa sanh,"
    },
    {
     "n": 30,
     "text": "Với tuệ, hãy đoạn gốc."
    },
    {
     "n": 31,
     "text": "Người đời nhớ ái dục,"
    },
    {
     "n": 32,
     "text": "Ưa thích các hỷ lạc."
    },
    {
     "n": 33,
     "text": "Tuy mong cầu an lạc,"
    },
    {
     "n": 34,
     "text": "Chúng vẫn phải sanh già."
    },
    {
     "n": 35,
     "text": "Người bị ái buộc ràng,"
    },
    {
     "n": 36,
     "text": "Vùng vẫy và hoảng sợ, Như thỏ bị sa lưới."
    },
    {
     "n": 37,
     "text": "Chúng sanh ái trói buộc,"
    },
    {
     "n": 38,
     "text": "Chịu khổ đau dài dài."
    },
    {
     "n": 39,
     "text": "Người bị ái buộc ràng,"
    },
    {
     "n": 40,
     "text": "Vùng vẫy và hoảng sợ, Như thỏ bị sa lưới."
    },
    {
     "n": 41,
     "text": "Do vậy vị tỷ kheo, Mong cầu mình ly tham"
    },
    {
     "n": 42,
     "text": "Nên nhiếp phục ái dục."
    },
    {
     "n": 43,
     "text": "Lìa rừng lại hướng rừng"
    },
    {
     "n": 44,
     "text": "Thoát rừng chạy theo rừng."
    },
    {
     "n": 45,
     "text": "Nên xem người như vậy,"
    },
    {
     "n": 46,
     "text": "Được thoát khỏi buộc ràng. Lại chạy theo ràng buộc."
    },
    {
     "n": 47,
     "text": "Sắt, cây, gai trói buộc"
    },
    {
     "n": 48,
     "text": "Người trí xem chưa bền."
    },
    {
     "n": 49,
     "text": "Tham châu báu, trang sức"
    },
    {
     "n": 50,
     "text": "Tham vọng vợ và con."
    },
    {
     "n": 51,
     "text": "Người có trí nói rằng: Trói buộc này thật bền."
    },
    {
     "n": 52,
     "text": "Trì kéo xuống, lún xuống, Nhưng thật sự khó thoát."
    },
    {
     "n": 53,
     "text": "Người trí cắt trừ nó,"
    },
    {
     "n": 54,
     "text": "Bỏ dục lạc, không màng."
    },
    {
     "n": 55,
     "text": "Người đắm say ái dục Tự lao mình xuống dòng"
    },
    {
     "n": 56,
     "text": "Như nhện sa lưới dệt."
    },
    {
     "n": 57,
     "text": "Người trí cắt trừ nó,"
    },
    {
     "n": 58,
     "text": "Bỏ mọi khổ, không màng."
    },
    {
     "n": 59,
     "text": "Bỏ quá, hiện, vị lai,"
    },
    {
     "n": 60,
     "text": "Đến bờ kia cuộc đời,"
    },
    {
     "n": 61,
     "text": "Ý giải thoát tất cả,"
    },
    {
     "n": 62,
     "text": "Chớ vướng tại sanh già."
    },
    {
     "n": 63,
     "text": "Người tà ý nhiếp phục,"
    },
    {
     "n": 64,
     "text": "Tham sắc bén nhìn tịnh,"
    },
    {
     "n": 65,
     "text": "Người ấy ái tăng trưởng,"
    },
    {
     "n": 66,
     "text": "Làm giây trói mình chặt."
    },
    {
     "n": 67,
     "text": "Ai vui, an tịnh ý,"
    },
    {
     "n": 68,
     "text": "Quán bất tịnh, thường niệm,"
    },
    {
     "n": 69,
     "text": "Người ấy sẽ diệt ái,"
    },
    {
     "n": 70,
     "text": "Cắt đứt Ma trói buộc."
    },
    {
     "n": 71,
     "text": "Ai tới đích không sợ,"
    },
    {
     "n": 72,
     "text": "Ly ái, không nhiễm ô"
    },
    {
     "n": 73,
     "text": "Nhổ mũi tên sanh tử,"
    },
    {
     "n": 74,
     "text": "Thân này thân cuối cùng."
    },
    {
     "n": 75,
     "text": "Ái lìa, không chấp thủ"
    },
    {
     "n": 76,
     "text": "Cú pháp khéo biện tài"
    },
    {
     "n": 77,
     "text": "Thấu suốt từ vô ngại,"
    },
    {
     "n": 78,
     "text": "Hiểu thứ lớp trước sau."
    },
    {
     "n": 79,
     "text": "Thân này thân cuối cùng"
    },
    {
     "n": 80,
     "text": "Vị như vậy được gọi, Bậc Đại trí, đại nhân."
    },
    {
     "n": 81,
     "text": "Ta hàng phục tất cả, Ta rõ biết tất cả,"
    },
    {
     "n": 82,
     "text": "Không bị nhiễm pháp nào."
    },
    {
     "n": 83,
     "text": "Ta từ bỏ tất cả Ái diệt, tự giải thoát."
    },
    {
     "n": 84,
     "text": "Đã tự mình thắng trí, Ta gọi ai thầy ta?"
    },
    {
     "n": 85,
     "text": "Pháp thí, thắng mọi thí!"
    },
    {
     "n": 86,
     "text": "Pháp vị, thắng mọi vị!"
    },
    {
     "n": 87,
     "text": "Pháp hỷ, thắng mọi hỷ!"
    },
    {
     "n": 88,
     "text": "Ái diệt, thắng mọi khổ!"
    },
    {
     "n": 89,
     "text": "Tài sản hại người ngu."
    },
    {
     "n": 90,
     "text": "Không người tìm bờ kia"
    },
    {
     "n": 91,
     "text": "Kẻ ngu vì tham giàu,"
    },
    {
     "n": 92,
     "text": "Hại mình và hại người."
    },
    {
     "n": 93,
     "text": "Cỏ làm hại ruộng vườn,"
    },
    {
     "n": 94,
     "text": "Tham làm hại người đời."
    },
    {
     "n": 95,
     "text": "Bố thí người ly tham,"
    },
    {
     "n": 96,
     "text": "Do vậy được quả lớn."
    },
    {
     "n": 97,
     "text": "Cỏ làm hại ruộng vườn,"
    },
    {
     "n": 98,
     "text": "Sân làm hại người đời."
    },
    {
     "n": 99,
     "text": "Bố thí người ly sân,"
    },
    {
     "n": 100,
     "text": "Do vậy được quả lớn."
    },
    {
     "n": 101,
     "text": "Cỏ làm hại ruộng vườn,"
    },
    {
     "n": 102,
     "text": "Si làm hại người đời,"
    },
    {
     "n": 103,
     "text": "Bố thí người ly si,"
    },
    {
     "n": 104,
     "text": "Do vậy được quả lớn."
    },
    {
     "n": 105,
     "text": "Cỏ làm hại ruộng vườn,"
    },
    {
     "n": 106,
     "text": "Dục làm hại người đời."
    },
    {
     "n": 107,
     "text": "Bố thí người ly dục,"
    },
    {
     "n": 108,
     "text": "Do vậy được quả lớn."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp334-359/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Manujassa pamattacārino,"
    },
    {
     "n": 2,
     "text": "Taṇhā vaḍḍhati māluvā viya;"
    },
    {
     "n": 3,
     "text": "So plavatī hurā huraṁ,"
    },
    {
     "n": 4,
     "text": "Phalamicchaṁva vanasmi vānaro."
    },
    {
     "n": 5,
     "text": "Yaṁ esā sahate jammī,"
    },
    {
     "n": 6,
     "text": "taṇhā loke visattikā;"
    },
    {
     "n": 7,
     "text": "Sokā tassa pavaḍḍhanti,"
    },
    {
     "n": 8,
     "text": "abhivaṭṭhaṁva bīraṇaṁ."
    },
    {
     "n": 9,
     "text": "Yo cetaṁ sahate jammiṁ,"
    },
    {
     "n": 10,
     "text": "taṇhaṁ loke duraccayaṁ;"
    },
    {
     "n": 11,
     "text": "Sokā tamhā papatanti,"
    },
    {
     "n": 12,
     "text": "udabinduva pokkharā."
    },
    {
     "n": 13,
     "text": "Taṁ vo vadāmi bhaddaṁ vo,"
    },
    {
     "n": 14,
     "text": "yāvantettha samāgatā;"
    },
    {
     "n": 15,
     "text": "Taṇhāya mūlaṁ khaṇatha,"
    },
    {
     "n": 16,
     "text": "usīratthova bīraṇaṁ;"
    },
    {
     "n": 17,
     "text": "Mā vo naḷaṁva sotova,"
    },
    {
     "n": 18,
     "text": "māro bhañji punappunaṁ."
    },
    {
     "n": 19,
     "text": "Yathāpi mūle anupaddave daḷhe,"
    },
    {
     "n": 20,
     "text": "Chinnopi rukkho punareva rūhati;"
    },
    {
     "n": 21,
     "text": "Evampi taṇhānusaye anūhate,"
    },
    {
     "n": 22,
     "text": "Nibbattatī dukkhamidaṁ punappunaṁ."
    },
    {
     "n": 23,
     "text": "Yassa chattiṁsati sotā,"
    },
    {
     "n": 24,
     "text": "manāpasavanā bhusā;"
    },
    {
     "n": 25,
     "text": "Mahāvahanti duddiṭṭhiṁ,"
    },
    {
     "n": 26,
     "text": "saṅkappā rāganissitā."
    },
    {
     "n": 27,
     "text": "Savanti sabbadhi sotā,"
    },
    {
     "n": 28,
     "text": "latā uppajja tiṭṭhati;"
    },
    {
     "n": 29,
     "text": "Tañca disvā lataṁ jātaṁ,"
    },
    {
     "n": 30,
     "text": "mūlaṁ paññāya chindatha."
    },
    {
     "n": 31,
     "text": "Saritāni sinehitāni ca,"
    },
    {
     "n": 32,
     "text": "Somanassāni bhavanti jantuno;"
    },
    {
     "n": 33,
     "text": "Te sātasitā sukhesino,"
    },
    {
     "n": 34,
     "text": "Te ve jātijarūpagā narā."
    },
    {
     "n": 35,
     "text": "Tasiṇāya purakkhatā pajā,"
    },
    {
     "n": 36,
     "text": "Parisappanti sasova bandhito;"
    },
    {
     "n": 37,
     "text": "Saṁyojanasaṅgasattakā,"
    },
    {
     "n": 38,
     "text": "Dukkhamupenti punappunaṁ cirāya."
    },
    {
     "n": 39,
     "text": "Tasiṇāya purakkhatā pajā,"
    },
    {
     "n": 40,
     "text": "Parisappanti sasova bandhito;"
    },
    {
     "n": 41,
     "text": "Tasmā tasiṇaṁ vinodaye,"
    },
    {
     "n": 42,
     "text": "Ākaṅkhanta virāgamattano."
    },
    {
     "n": 43,
     "text": "Yo nibbanatho vanādhimutto,"
    },
    {
     "n": 44,
     "text": "Vanamutto vanameva dhāvati;"
    },
    {
     "n": 45,
     "text": "Taṁ puggalametha passatha,"
    },
    {
     "n": 46,
     "text": "Mutto bandhanameva dhāvati."
    },
    {
     "n": 47,
     "text": "Na taṁ daḷhaṁ bandhanamāhu dhīrā,"
    },
    {
     "n": 48,
     "text": "Yadāyasaṁ dārujapabbajañca;"
    },
    {
     "n": 49,
     "text": "Sārattarattā maṇikuṇḍalesu,"
    },
    {
     "n": 50,
     "text": "Puttesu dāresu ca yā apekkhā."
    },
    {
     "n": 51,
     "text": "Etaṁ daḷhaṁ bandhanamāhu dhīrā,"
    },
    {
     "n": 52,
     "text": "Ohārinaṁ sithilaṁ duppamuñcaṁ;"
    },
    {
     "n": 53,
     "text": "Etampi chetvāna paribbajanti,"
    },
    {
     "n": 54,
     "text": "Anapekkhino kāmasukhaṁ pahāya."
    },
    {
     "n": 55,
     "text": "Ye rāgarattānupatanti sotaṁ,"
    },
    {
     "n": 56,
     "text": "Sayaṅkataṁ makkaṭakova jālaṁ;"
    },
    {
     "n": 57,
     "text": "Etampi chetvāna vajanti dhīrā,"
    },
    {
     "n": 58,
     "text": "Anapekkhino sabbadukkhaṁ pahāya."
    },
    {
     "n": 59,
     "text": "Muñca pure muñca pacchato,"
    },
    {
     "n": 60,
     "text": "Majjhe muñca bhavassa pāragū;"
    },
    {
     "n": 61,
     "text": "Sabbattha vimuttamānaso,"
    },
    {
     "n": 62,
     "text": "Na punaṁ jātijaraṁ upehisi."
    },
    {
     "n": 63,
     "text": "Vitakkamathitassa jantuno,"
    },
    {
     "n": 64,
     "text": "Tibbarāgassa subhānupassino;"
    },
    {
     "n": 65,
     "text": "Bhiyyo taṇhā pavaḍḍhati,"
    },
    {
     "n": 66,
     "text": "Esa kho daḷhaṁ karoti bandhanaṁ."
    },
    {
     "n": 67,
     "text": "Vitakkūpasame ca yo rato,"
    },
    {
     "n": 68,
     "text": "Asubhaṁ bhāvayate sadā sato;"
    },
    {
     "n": 69,
     "text": "Esa kho byanti kāhiti,"
    },
    {
     "n": 70,
     "text": "Esa checchati mārabandhanaṁ."
    },
    {
     "n": 71,
     "text": "Niṭṭhaṅgato asantāsī,"
    },
    {
     "n": 72,
     "text": "vītataṇho anaṅgaṇo;"
    },
    {
     "n": 73,
     "text": "Acchindi bhavasallāni,"
    },
    {
     "n": 74,
     "text": "antimoyaṁ samussayo."
    },
    {
     "n": 75,
     "text": "Vītataṇho anādāno,"
    },
    {
     "n": 76,
     "text": "Niruttipadakovido;"
    },
    {
     "n": 77,
     "text": "Akkharānaṁ sannipātaṁ,"
    },
    {
     "n": 78,
     "text": "Jaññā pubbāparāni ca;"
    },
    {
     "n": 79,
     "text": "Sa ve “antimasārīro,"
    },
    {
     "n": 80,
     "text": "Mahāpañño mahāpuriso”ti vuccati."
    },
    {
     "n": 81,
     "text": "Sabbābhibhū sabbavidūhamasmi,"
    },
    {
     "n": 82,
     "text": "Sabbesu dhammesu anūpalitto;"
    },
    {
     "n": 83,
     "text": "Sabbañjaho taṇhakkhaye vimutto,"
    },
    {
     "n": 84,
     "text": "Sayaṁ abhiññāya kamuddiseyyaṁ."
    },
    {
     "n": 85,
     "text": "Sabbadānaṁ dhammadānaṁ jināti,"
    },
    {
     "n": 86,
     "text": "Sabbarasaṁ dhammaraso jināti;"
    },
    {
     "n": 87,
     "text": "Sabbaratiṁ dhammarati jināti,"
    },
    {
     "n": 88,
     "text": "Taṇhakkhayo sabbadukkhaṁ jināti."
    },
    {
     "n": 89,
     "text": "Hananti bhogā dummedhaṁ,"
    },
    {
     "n": 90,
     "text": "no ca pāragavesino;"
    },
    {
     "n": 91,
     "text": "Bhogataṇhāya dummedho,"
    },
    {
     "n": 92,
     "text": "hanti aññeva attanaṁ."
    },
    {
     "n": 93,
     "text": "Tiṇadosāni khettāni,"
    },
    {
     "n": 94,
     "text": "rāgadosā ayaṁ pajā;"
    },
    {
     "n": 95,
     "text": "Tasmā hi vītarāgesu,"
    },
    {
     "n": 96,
     "text": "dinnaṁ hoti mahapphalaṁ."
    },
    {
     "n": 97,
     "text": "Tiṇadosāni khettāni,"
    },
    {
     "n": 98,
     "text": "dosadosā ayaṁ pajā;"
    },
    {
     "n": 99,
     "text": "Tasmā hi vītadosesu,"
    },
    {
     "n": 100,
     "text": "dinnaṁ hoti mahapphalaṁ."
    },
    {
     "n": 101,
     "text": "Tiṇadosāni khettāni,"
    },
    {
     "n": 102,
     "text": "mohadosā ayaṁ pajā;"
    },
    {
     "n": 103,
     "text": "Tasmā hi vītamohesu,"
    },
    {
     "n": 104,
     "text": "dinnaṁ hoti mahapphalaṁ."
    },
    {
     "n": 105,
     "text": "Tiṇadosāni khettāni,"
    },
    {
     "n": 106,
     "text": "icchādosā ayaṁ pajā;"
    },
    {
     "n": 107,
     "text": "Tasmā hi vigaticchesu,"
    },
    {
     "n": 108,
     "text": "dinnaṁ hoti mahapphalaṁ."
    }
   ]
