   "lines": [
    {
     "n": 1,
     "text": "བདག་ནི་སེམས་ཅན་ཐམས་ཅད་ལ། །",
     "section": "Verse 1"
    },
    {
     "n": 2,
     "text": "ཡིད་བཞིན་ནོར་བུ་ལས་ལྷག་པའི། །",
     "section": "Verse 1"
    },
    {
     "n": 3,
     "text": "དོན་མཆོག་སྒྲུབ་པའི་བསམ་པ་ཡིས། །",
     "section": "Verse 1"
    },
    {
     "n": 4,
     "text": "རྟག་ཏུ་གཅེས་པར་འཛིན་པར་ཤོག །",
     "section": "Verse 1"
    },
    {
     "n": 5,
     "text": "གང་དུ་སུ་དང་འགྲོགས་པའི་ཚེ། །",
     "section": "Verse 2"
    },
    {
     "n": 6,
     "text": "བདག་ཉིད་ཀུན་ལས་དམན་བལྟ་ཞིང༌། །",
     "section": "Verse 2"
    },
    {
     "n": 7,
     "text": "གཞན་ལ་བསམ་པ་ཐག་པ་ཡིས། །",
     "section": "Verse 2"
    },
    {
     "n": 8,
     "text": "མཆོག་ཏུ་གཅེས་པར་འཛིན་པར་ཤོག །",
     "section": "Verse 2"
    },
    {
     "n": 9,
     "text": "སྤྱོད་ལམ་ཀུན་ཏུ་རང་རྒྱུད་ལ། །",
     "section": "Verse 3"
    },
    {
     "n": 10,
     "text": "རྟོག་ཅིང་ཉོན་མོངས་སྐྱེས་མ་ཐག །",
     "section": "Verse 3"
    },
    {
     "n": 11,
     "text": "བདག་གཞན་མ་རུངས་བྱེད་པས་ན། །",
     "section": "Verse 3"
    },
    {
     "n": 12,
     "text": "བཙན་ཐབས་གདོང་ནས་བཟློག་པར་ཤོག །",
     "section": "Verse 3"
    },
    {
     "n": 13,
     "text": "རང་བཞིན་ངན་པའི་སེམས་ཅན་རྣམས། །",
     "section": "Verse 4"
    },
    {
     "n": 14,
     "text": "སྡིག་སྡུག་དྲག་པོས་ནོན་མཐོང་ཚེ། །",
     "section": "Verse 4"
    },
    {
     "n": 15,
     "text": "རིན་ཆེན་གཏེར་དང་འཕྲད་པ་བཞིན། །",
     "section": "Verse 4"
    },
    {
     "n": 16,
     "text": "རྙེད་པར་དཀའ་བས་གཅེས་འཛིན་ཤོག །",
     "section": "Verse 4"
    },
    {
     "n": 17,
     "text": "བདག་ལ་གཞན་གྱིས་ཕྲག་དོག་གིས། །",
     "section": "Verse 5"
    },
    {
     "n": 18,
     "text": "གཤེ་བསྐུར་ལ་སོགས་མི་རིགས་པའི། །",
     "section": "Verse 5"
    },
    {
     "n": 19,
     "text": "གྱོང་ཁ་རང་གིས་ལེན་པ་དང༌། །",
     "section": "Verse 5"
    },
    {
     "n": 20,
     "text": "རྒྱལ་ཁ་གཞན་ལ་འབུལ་བར་ཤོག །",
     "section": "Verse 5"
    },
    {
     "n": 21,
     "text": "གང་ལ་བདག་གིས་ཕན་བཏགས་པའི། །",
     "section": "Verse 6"
    },
    {
     "n": 22,
     "text": "རེ་བ་ཆེ་བ་གང་ཞིག་གིས། །",
     "section": "Verse 6"
    },
    {
     "n": 23,
     "text": "ཤིན་ཏུ་མི་རིགས་གནོད་བྱེད་ནའང༌། །",
     "section": "Verse 6"
    },
    {
     "n": 24,
     "text": "བཤེས་གཉེན་དམ་པར་བལྟ་བར་ཤོག །",
     "section": "Verse 6"
    },
    {
     "n": 25,
     "text": "མདོར་ན་དངོས་སམ་བརྒྱུད་པ་ཡིས། །",
     "section": "Verse 7"
    },
    {
     "n": 26,
     "text": "ཕན་བདེ་མ་རྣམས་ཀུན་ལ་འབུལ། །",
     "section": "Verse 7"
    },
    {
     "n": 27,
     "text": "མ་ཡི་གནོད་དང་སྡུག་བསྔལ་ཀུན། །",
     "section": "Verse 7"
    },
    {
     "n": 28,
     "text": "གསང་བས་བདག་ལ་ལེན་པར་ཤོག །",
     "section": "Verse 7"
    },
    {
     "n": 29,
     "text": "དེ་དག་ཀུན་ཀྱང་ཆོས་བརྒྱད་ཀྱི། །",
     "section": "Verse 8"
    },
    {
     "n": 30,
     "text": "རྟོག་པའི་དྲི་མས་མ་སྦགས་ཤིང༌། །",
     "section": "Verse 8"
    },
    {
     "n": 31,
     "text": "ཆོས་ཀུན་སྒྱུ་མར་ཤེས་པའི་བློས། །",
     "section": "Verse 8"
    },
    {
     "n": 32,
     "text": "ཞེན་མེད་འཆིང་བ་ལས་གྲོལ་ཤོག །",
     "section": "Verse 8"
    },
    {
     "n": 33,
     "text": "ཅེས་པ་འདི་ནི་དགེ་བཤེས་གླང་ཐང་པ་རྡོ་རྗེ་སེངྒེའི་གསུང་ངོ༌།། །།"
    }
   ]
  }
 ]
}
