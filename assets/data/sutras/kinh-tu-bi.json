{
 "id": "kinh-tu-bi",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Snp 1.8",
 "summary": "Bài kinh kệ thuộc Kinh Tập (Tiểu Bộ), nói về những phẩm hạnh cần có của người muốn đạt cảnh giới an tịnh: ngay thẳng, nhu hòa, sống đạm bạc, không cao mạn. Phần chính khuyên rải tâm từ đến mọi loài chúng sanh, mong tất cả được an lạc, hạnh phúc, không phân biệt lớn nhỏ, gần xa. Kinh thường được dùng để thực hành và nuôi dưỡng lòng từ.",
 "titles": {
  "vi": "Kinh Từ Bi",
  "pli": "Karaṇīyamettasutta",
  "en": "The Discourse on Love"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": true,
 "purposes": [
  "CAU_AN"
 ],
 "durationMinutes": 5,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "translator": "Thích Minh Châu",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/suttas/snp1.8/minh_chau?lang=vi",
   "license": "UNKNOWN",
   "licenseNote": "SuttaCentral page states only: Translated by Thích Minh Châu; prepared for SuttaCentral by editor named in footer; no license given",
   "lines": [
    {
     "n": 1,
     "text": "Vị thiện xảo mục đích,"
    },
    {
     "n": 2,
     "text": "Cần phải làm như sau:"
    },
    {
     "n": 3,
     "text": "Sau khi hiểu thông suốt,"
    },
    {
     "n": 4,
     "text": "Con đường an tịnh ấy,"
    },
    {
     "n": 5,
     "text": "Có khả năng trực tánh,"
    },
    {
     "n": 6,
     "text": "Thật sự, khéo chân trực,"
    },
    {
     "n": 7,
     "text": "Dễ nói và nhu hòa,"
    },
    {
     "n": 8,
     "text": "Không có gì cao mạn."
    },
    {
     "n": 9,
     "text": "Sống cảm thấy vừa đủ,"
    },
    {
     "n": 10,
     "text": "Nuôi sống thật dễ dàng,"
    },
    {
     "n": 11,
     "text": "Ít có sự rộn ràng,"
    },
    {
     "n": 12,
     "text": "Sống đạm bạc, giản dị."
    },
    {
     "n": 13,
     "text": "Các căn được tịnh lạc,"
    },
    {
     "n": 14,
     "text": "Khôn ngoan và thận trọng,"
    },
    {
     "n": 15,
     "text": "Không xông xáo gia đình,"
    },
    {
     "n": 16,
     "text": "Không tham ái, tham vọng."
    },
    {
     "n": 17,
     "text": "Các hành sở của mình,"
    },
    {
     "n": 18,
     "text": "Không nhỏ nhen, vụn vặt,"
    },
    {
     "n": 19,
     "text": "Khiến người khác có trí,"
    },
    {
     "n": 20,
     "text": "Có thể sanh chỉ trích,"
    },
    {
     "n": 21,
     "text": "Mong mọi loài chúng sanh,"
    },
    {
     "n": 22,
     "text": "Được an lạc, an ổn,"
    },
    {
     "n": 23,
     "text": "Mong chúng chứng đạt được,"
    },
    {
     "n": 24,
     "text": "Hạnh phúc và an lạc."
    },
    {
     "n": 25,
     "text": "Mong tất cả những ai,"
    },
    {
     "n": 26,
     "text": "Hữu tình có mạng sống,"
    },
    {
     "n": 27,
     "text": "Kẻ yếu hay kẻ mạnh,"
    },
    {
     "n": 28,
     "text": "Không bỏ sót một ai,"
    },
    {
     "n": 29,
     "text": "Kẻ dài hay kẻ lớn,"
    },
    {
     "n": 30,
     "text": "Trung thấp, loài lớn, nhỏ."
    },
    {
     "n": 31,
     "text": "Loài được thấy, không thấy,"
    },
    {
     "n": 32,
     "text": "Loài sống xa, không xa,"
    },
    {
     "n": 33,
     "text": "Các loài hiện đang sống,"
    },
    {
     "n": 34,
     "text": "Các loài sẽ được sanh,"
    },
    {
     "n": 35,
     "text": "Mong mọi loài chúng sanh,"
    },
    {
     "n": 36,
     "text": "Sống hạnh phúc an lạc."
    },
    {
     "n": 37,
     "text": "Mong rằng không có ai,"
    },
    {
     "n": 38,
     "text": "Lường gạt, lừa dối ai,"
    },
    {
     "n": 39,
     "text": "Không có ai khinh mạn,"
    },
    {
     "n": 40,
     "text": "Tại bất cứ chỗ nào,"
    },
    {
     "n": 41,
     "text": "Không vì giận hờn nhau,"
    },
    {
     "n": 42,
     "text": "Không vì tưởng chống đối."
    },
    {
     "n": 43,
     "text": "Lại có người mong muốn,"
    },
    {
     "n": 44,
     "text": "Làm đau khổ cho nhau."
    },
    {
     "n": 45,
     "text": "Như tấm lòng người mẹ,"
    },
    {
     "n": 46,
     "text": "Đối với con của mình,"
    },
    {
     "n": 47,
     "text": "Trọn đời lo che chở,"
    },
    {
     "n": 48,
     "text": "Con độc nhất mình sanh."
    },
    {
     "n": 49,
     "text": "Cũng vậy, đối tất cả"
    },
    {
     "n": 50,
     "text": "Các hữu tình chúng sanh,"
    },
    {
     "n": 51,
     "text": "Hãy tu tập tâm ý,"
    },
    {
     "n": 52,
     "text": "Không hạn lượng, rộng lớn."
    },
    {
     "n": 53,
     "text": "Hãy tu tập từ tâm,"
    },
    {
     "n": 54,
     "text": "Trong tất cả thế giới,"
    },
    {
     "n": 55,
     "text": "Hãy tu tập tâm ý,"
    },
    {
     "n": 56,
     "text": "Không hạn lượng, rộng lớn,"
    },
    {
     "n": 57,
     "text": "Phía trên và phía dưới,"
    },
    {
     "n": 58,
     "text": "Cũng vậy cả bề ngang,"
    },
    {
     "n": 59,
     "text": "Không hạn chế, trói buộc,"
    },
    {
     "n": 60,
     "text": "Không hận, không thù địch."
    },
    {
     "n": 61,
     "text": "Khi đứng hay khi ngồi,"
    },
    {
     "n": 62,
     "text": "Khi ngồi hay khi nằm,"
    },
    {
     "n": 63,
     "text": "Lâu cho đến khi nào,"
    },
    {
     "n": 64,
     "text": "Khi đang còn tỉnh thức,"
    },
    {
     "n": 65,
     "text": "Hãy an trú niệm này,"
    },
    {
     "n": 66,
     "text": "Nếp sống này như vậy."
    },
    {
     "n": 67,
     "text": "Được đời đề cập đến,"
    },
    {
     "n": 68,
     "text": "Là nếp sống tối thượng."
    },
    {
     "n": 69,
     "text": "Ai từ bỏ tà kiến,"
    },
    {
     "n": 70,
     "text": "Giữ giới, đủ chánh kiến,"
    },
    {
     "n": 71,
     "text": "Nhiếp phục được tham ái,"
    },
    {
     "n": 72,
     "text": "Đối với các dục vọng,"
    },
    {
     "n": 73,
     "text": "Không còn phải tái sanh, Đi đến thai tạng nữa."
    }
   ],
   "variant": "translation"
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/snp1.8/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "“Karaṇīyamatthakusalena,"
    },
    {
     "n": 2,
     "text": "Yanta santaṁ padaṁ abhisamecca;"
    },
    {
     "n": 3,
     "text": "Sakko ujū ca suhujū ca,"
    },
    {
     "n": 4,
     "text": "Sūvaco cassa mudu anatimānī."
    },
    {
     "n": 5,
     "text": "Santussako ca subharo ca,"
    },
    {
     "n": 6,
     "text": "Appakicco ca sallahukavutti;"
    },
    {
     "n": 7,
     "text": "Santindriyo ca nipako ca,"
    },
    {
     "n": 8,
     "text": "Appagabbho kulesvananugiddho."
    },
    {
     "n": 9,
     "text": "Na ca khuddamācare kiñci,"
    },
    {
     "n": 10,
     "text": "Yena viññū pare upavadeyyuṁ;"
    },
    {
     "n": 11,
     "text": "Sukhino va khemino hontu,"
    },
    {
     "n": 12,
     "text": "Sabbasattā bhavantu sukhitattā."
    },
    {
     "n": 13,
     "text": "Ye keci pāṇabhūtatthi,"
    },
    {
     "n": 14,
     "text": "Tasā vā thāvarā vanavasesā;"
    },
    {
     "n": 15,
     "text": "Dīghā vā ye va mahantā,"
    },
    {
     "n": 16,
     "text": "Majjhimā rassakā aṇukathūlā."
    },
    {
     "n": 17,
     "text": "Diṭṭhā vā ye va adiṭṭhā,"
    },
    {
     "n": 18,
     "text": "Ye va dūre vasanti avidūre;"
    },
    {
     "n": 19,
     "text": "Bhūtā va sambhavesī va,"
    },
    {
     "n": 20,
     "text": "Sabbasattā bhavantu sukhitattā."
    },
    {
     "n": 21,
     "text": "Na paro paraṁ nikubbetha,"
    },
    {
     "n": 22,
     "text": "Nātimaññetha katthaci na kañci;"
    },
    {
     "n": 23,
     "text": "Byārosanā paṭighasañña,"
    },
    {
     "n": 24,
     "text": "Nāññamaññassa dukkhamiccheyya."
    },
    {
     "n": 25,
     "text": "Mātā yathā niyaṁ puttam"
    },
    {
     "n": 26,
     "text": "Āyusā ekaputtamanurakkhe;"
    },
    {
     "n": 27,
     "text": "Evampi sabbabhūtesu,"
    },
    {
     "n": 28,
     "text": "Mānasaṁ bhāvaye aparimāṇaṁ."
    },
    {
     "n": 29,
     "text": "Mettañca sabbalokasmi,"
    },
    {
     "n": 30,
     "text": "Mānasaṁ bhāvaye aparimāṇaṁ;"
    },
    {
     "n": 31,
     "text": "Uddhaṁ adho ca tiriyañca,"
    },
    {
     "n": 32,
     "text": "Asambādhaṁ averamasapattaṁ."
    },
    {
     "n": 33,
     "text": "Tiṭṭhaṁ caraṁ nisinno va,"
    },
    {
     "n": 34,
     "text": "Sayāno yāvatāssa vitamiddho;"
    },
    {
     "n": 35,
     "text": "Etaṁ satiṁ adhiṭṭheyya,"
    },
    {
     "n": 36,
     "text": "Brahmametaṁ vihāramidhamāhu."
    },
    {
     "n": 37,
     "text": "Diṭṭhiñca anupaggamma,"
    },
    {
     "n": 38,
     "text": "Sīlavā dassanena sampanno;"
    },
    {
     "n": 39,
     "text": "Kāmesu vinaya gedhaṁ,"
    },
    {
     "n": 40,
     "text": "Na hi jātuggabbhaseyya punaretī”ti."
    },
    {
     "n": 41,
     "text": "Mettasuttaṁ aṭṭhamaṁ."
    }
   ],
   "variant": "translation"
  },
  {
   "key": "en-translation",
   "lang": "en",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/snp1.8/sujato?lang=en (translation_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (bilara-data _publication-v2.json); the translator additionally requests that use not be for AI training datasets, AI models or AI-derived technologies",
   "lines": [
    {
     "n": 1,
     "text": "Those who are skilled in the meaning of scripture"
    },
    {
     "n": 2,
     "text": "should practice as follows to realize the state of peace."
    },
    {
     "n": 3,
     "text": "Let them be capable and upright, very upright,"
    },
    {
     "n": 4,
     "text": "easy to speak to, gentle and humble;"
    },
    {
     "n": 5,
     "text": "content and unburdensome,"
    },
    {
     "n": 6,
     "text": "unbusied, living lightly,"
    },
    {
     "n": 7,
     "text": "alert, with senses calmed,"
    },
    {
     "n": 8,
     "text": "courteous, not fawning on families."
    },
    {
     "n": 9,
     "text": "Let them not do the slightest thing"
    },
    {
     "n": 10,
     "text": "that others who are wise would blame."
    },
    {
     "n": 11,
     "text": "May they be happy and safe!"
    },
    {
     "n": 12,
     "text": "May all beings be happy!"
    },
    {
     "n": 13,
     "text": "Whatever living creatures there are"
    },
    {
     "n": 14,
     "text": "with not a one left out—"
    },
    {
     "n": 15,
     "text": "frail or firm, long or large,"
    },
    {
     "n": 16,
     "text": "medium, small, tiny or round,"
    },
    {
     "n": 17,
     "text": "seen or unseen,"
    },
    {
     "n": 18,
     "text": "living far or near,"
    },
    {
     "n": 19,
     "text": "those who have been born and those about to be born—"
    },
    {
     "n": 20,
     "text": "may all beings be happy!"
    },
    {
     "n": 21,
     "text": "Let none deceive another,"
    },
    {
     "n": 22,
     "text": "nor look down on anyone anywhere."
    },
    {
     "n": 23,
     "text": "Though provoked or aggrieved,"
    },
    {
     "n": 24,
     "text": "let them not wish pain on each other."
    },
    {
     "n": 25,
     "text": "Even as a mother would protect with her life"
    },
    {
     "n": 26,
     "text": "her child, her only child,"
    },
    {
     "n": 27,
     "text": "so too for all creatures"
    },
    {
     "n": 28,
     "text": "unfold a boundless heart."
    },
    {
     "n": 29,
     "text": "With love for the whole world,"
    },
    {
     "n": 30,
     "text": "unfold a boundless heart:"
    },
    {
     "n": 31,
     "text": "above, below, all round,"
    },
    {
     "n": 32,
     "text": "unconstricted, without enmity or foe."
    },
    {
     "n": 33,
     "text": "When standing, walking, sitting,"
    },
    {
     "n": 34,
     "text": "or lying down while yet unweary,"
    },
    {
     "n": 35,
     "text": "keep this ever in mind;"
    },
    {
     "n": 36,
     "text": "for this, they say, is a divine meditation in this life."
    },
    {
     "n": 37,
     "text": "Avoiding harmful views,"
    },
    {
     "n": 38,
     "text": "virtuous, accomplished in insight,"
    },
    {
     "n": 39,
     "text": "with desire for sensual pleasures dispelled,"
    },
    {
     "n": 40,
     "text": "they never return to a womb again."
    }
   ],
   "variant": "translation"
  }
 ]
}
