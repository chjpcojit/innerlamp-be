{
 "id": "phap-cu-hinh-phat",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 129-145",
 "summary": "Phẩm thuộc Kinh Pháp Cú (Tiểu Bộ, kệ 129-145), khuyên lấy mình làm ví dụ vì ai cũng sợ hình phạt, sợ chết và thương sự sống, nên không giết, không bảo người giết. Phẩm nói về không dùng gậy gộc hại người, sống tự chế, thanh tịnh, và ví người biết tự điều phục như thợ khéo uốn nắn tên, ván, nước.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Hình Phạt",
  "pli": "Daṇḍavagga",
  "en": "The Rod"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 5,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp129-145/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Mọi người sợ hình phạt,"
    },
    {
     "n": 2,
     "text": "Mọi người sợ tử vong."
    },
    {
     "n": 3,
     "text": "Lấy mình làm ví dụ"
    },
    {
     "n": 4,
     "text": "Không giết, không bảo giết."
    },
    {
     "n": 5,
     "text": "Mọi người sợ hình phạt,"
    },
    {
     "n": 6,
     "text": "Mọi người thương sống còn;"
    },
    {
     "n": 7,
     "text": "Lấy mình làm ví dụ,"
    },
    {
     "n": 8,
     "text": "Không giết, không bảo giết."
    },
    {
     "n": 9,
     "text": "Chúng sanh cầu an lạc,"
    },
    {
     "n": 10,
     "text": "Ai dùng trượng hại người,"
    },
    {
     "n": 11,
     "text": "Để tìm lạc cho mình,"
    },
    {
     "n": 12,
     "text": "Đời sau không được lạc."
    },
    {
     "n": 13,
     "text": "Chúng sanh cầu an lạc,"
    },
    {
     "n": 14,
     "text": "Không dùng trượng hại người,"
    },
    {
     "n": 15,
     "text": "Để tìm lạc cho mình,"
    },
    {
     "n": 16,
     "text": "Đời sau hưởng được lạc."
    },
    {
     "n": 17,
     "text": "Chớ nói lời ác độc,"
    },
    {
     "n": 18,
     "text": "Nói ác, bị nói lại,"
    },
    {
     "n": 19,
     "text": "Khổ thay lời phẫn nộ,"
    },
    {
     "n": 20,
     "text": "Đao trượng phản chạm người."
    },
    {
     "n": 21,
     "text": "Nếu tự mình yên lặng,"
    },
    {
     "n": 22,
     "text": "Như chiếc chuông bị bể."
    },
    {
     "n": 23,
     "text": "Người đã chứng Niết-bàn"
    },
    {
     "n": 24,
     "text": "Người không còn phẫn nộ."
    },
    {
     "n": 25,
     "text": "Với gậy người chăn bò,"
    },
    {
     "n": 26,
     "text": "Lùa bò ra bãi cỏ;"
    },
    {
     "n": 27,
     "text": "Cũng vậy, già và chết,"
    },
    {
     "n": 28,
     "text": "Lùa người đến mạng chung."
    },
    {
     "n": 29,
     "text": "Người ngu làm điều ác,"
    },
    {
     "n": 30,
     "text": "Không ý thức việc làm."
    },
    {
     "n": 31,
     "text": "Do tự nghiệp, người ngu"
    },
    {
     "n": 32,
     "text": "Bị nung nấu, như lửa."
    },
    {
     "n": 33,
     "text": "Dùng trượng phạt không trượng"
    },
    {
     "n": 34,
     "text": "Làm ác người không ác."
    },
    {
     "n": 35,
     "text": "Trong mười loại khổ đau,"
    },
    {
     "n": 36,
     "text": "Chịu gấp một loại khổ:"
    },
    {
     "n": 37,
     "text": "Hoặc khổ thọ khốc liệt,"
    },
    {
     "n": 38,
     "text": "Thân thể bị thương vong,"
    },
    {
     "n": 39,
     "text": "Hoặc thọ bệnh kịch liệt,"
    },
    {
     "n": 40,
     "text": "Hay loạn ý tán tâm."
    },
    {
     "n": 41,
     "text": "Hoặc tai vạ từ vua,"
    },
    {
     "n": 42,
     "text": "Hay bị vu trọng tội;"
    },
    {
     "n": 43,
     "text": "Bà con phải ly tán,"
    },
    {
     "n": 44,
     "text": "Tài sản bị nát tan."
    },
    {
     "n": 45,
     "text": "Hoặc phòng ốc nhà cửa"
    },
    {
     "n": 46,
     "text": "Bị hỏa tai thiêu đốt;"
    },
    {
     "n": 47,
     "text": "Khi thân hoại mạng chung,"
    },
    {
     "n": 48,
     "text": "Ác tuệ sanh địa ngục."
    },
    {
     "n": 49,
     "text": "Không phải sống lõa thể Bện tóc, tro trét mình,"
    },
    {
     "n": 50,
     "text": "Tuyệt thực, lăn trên đất,"
    },
    {
     "n": 51,
     "text": "Sống nhớp, siêng ngồi xổm,"
    },
    {
     "n": 52,
     "text": "Làm con người được sạch, Nếu không trừ nghi hoặc."
    },
    {
     "n": 53,
     "text": "Ai sống tự trang sức,"
    },
    {
     "n": 54,
     "text": "Nhưng an tịnh, nhiếp phục, Sống kiên trì, phạm hạnh,"
    },
    {
     "n": 55,
     "text": "Không hại mọi sinh linh."
    },
    {
     "n": 56,
     "text": "Vị ấy là phạm chí, Hay sa môn, khất sĩ."
    },
    {
     "n": 57,
     "text": "Thật khó tìm ở đời,"
    },
    {
     "n": 58,
     "text": "Người biết thẹn, tự chế,"
    },
    {
     "n": 59,
     "text": "Biết tránh né chỉ trích"
    },
    {
     "n": 60,
     "text": "Như ngựa hiền tránh roi."
    },
    {
     "n": 61,
     "text": "Như ngựa hiền chạm roi,"
    },
    {
     "n": 62,
     "text": "Hãy nhiệt tâm, hăng hái,"
    },
    {
     "n": 63,
     "text": "Với tín, giới, tinh tấn,"
    },
    {
     "n": 64,
     "text": "Thiền định cùng trạch pháp."
    },
    {
     "n": 65,
     "text": "Minh hạnh đủ, chánh niệm,"
    },
    {
     "n": 66,
     "text": "Đoạn khổ này vô lượng."
    },
    {
     "n": 67,
     "text": "Người trị thủy dẫn nước,"
    },
    {
     "n": 68,
     "text": "Kẻ làm tên nắn tên,"
    },
    {
     "n": 69,
     "text": "Người thợ mộc uốn ván,"
    },
    {
     "n": 70,
     "text": "Bậc tự điều, điều thân."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp129-145/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Sabbe tasanti daṇḍassa,"
    },
    {
     "n": 2,
     "text": "sabbe bhāyanti maccuno;"
    },
    {
     "n": 3,
     "text": "Attānaṁ upamaṁ katvā,"
    },
    {
     "n": 4,
     "text": "na haneyya na ghātaye."
    },
    {
     "n": 5,
     "text": "Sabbe tasanti daṇḍassa,"
    },
    {
     "n": 6,
     "text": "sabbesaṁ jīvitaṁ piyaṁ;"
    },
    {
     "n": 7,
     "text": "Attānaṁ upamaṁ katvā,"
    },
    {
     "n": 8,
     "text": "na haneyya na ghātaye."
    },
    {
     "n": 9,
     "text": "Sukhakāmāni bhūtāni,"
    },
    {
     "n": 10,
     "text": "yo daṇḍena vihiṁsati;"
    },
    {
     "n": 11,
     "text": "Attano sukhamesāno,"
    },
    {
     "n": 12,
     "text": "pecca so na labhate sukhaṁ."
    },
    {
     "n": 13,
     "text": "Sukhakāmāni bhūtāni,"
    },
    {
     "n": 14,
     "text": "yo daṇḍena na hiṁsati;"
    },
    {
     "n": 15,
     "text": "Attano sukhamesāno,"
    },
    {
     "n": 16,
     "text": "pecca so labhate sukhaṁ."
    },
    {
     "n": 17,
     "text": "Māvoca pharusaṁ kañci,"
    },
    {
     "n": 18,
     "text": "vuttā paṭivadeyyu taṁ;"
    },
    {
     "n": 19,
     "text": "Dukkhā hi sārambhakathā,"
    },
    {
     "n": 20,
     "text": "paṭidaṇḍā phuseyyu taṁ."
    },
    {
     "n": 21,
     "text": "Sace neresi attānaṁ,"
    },
    {
     "n": 22,
     "text": "kaṁso upahato yathā;"
    },
    {
     "n": 23,
     "text": "Esa pattosi nibbānaṁ,"
    },
    {
     "n": 24,
     "text": "sārambho te na vijjati."
    },
    {
     "n": 25,
     "text": "Yathā daṇḍena gopālo,"
    },
    {
     "n": 26,
     "text": "gāvo pājeti gocaraṁ;"
    },
    {
     "n": 27,
     "text": "Evaṁ jarā ca maccu ca,"
    },
    {
     "n": 28,
     "text": "āyuṁ pājenti pāṇinaṁ."
    },
    {
     "n": 29,
     "text": "Atha pāpāni kammāni,"
    },
    {
     "n": 30,
     "text": "karaṁ bālo na bujjhati;"
    },
    {
     "n": 31,
     "text": "Sehi kammehi dummedho,"
    },
    {
     "n": 32,
     "text": "aggidaḍḍhova tappati."
    },
    {
     "n": 33,
     "text": "Yo daṇḍena adaṇḍesu,"
    },
    {
     "n": 34,
     "text": "appaduṭṭhesu dussati;"
    },
    {
     "n": 35,
     "text": "Dasannamaññataraṁ ṭhānaṁ,"
    },
    {
     "n": 36,
     "text": "khippameva nigacchati."
    },
    {
     "n": 37,
     "text": "Vedanaṁ pharusaṁ jāniṁ,"
    },
    {
     "n": 38,
     "text": "sarīrassa va bhedanaṁ;"
    },
    {
     "n": 39,
     "text": "Garukaṁ vāpi ābādhaṁ,"
    },
    {
     "n": 40,
     "text": "cittakkhepaṁ va pāpuṇe."
    },
    {
     "n": 41,
     "text": "Rājato vā upasaggaṁ,"
    },
    {
     "n": 42,
     "text": "Abbhakkhānaṁ va dāruṇaṁ;"
    },
    {
     "n": 43,
     "text": "Parikkhayaṁ va ñātīnaṁ,"
    },
    {
     "n": 44,
     "text": "Bhogānaṁ va pabhaṅguraṁ."
    },
    {
     "n": 45,
     "text": "Atha vāssa agārāni,"
    },
    {
     "n": 46,
     "text": "aggi ḍahati pāvako;"
    },
    {
     "n": 47,
     "text": "Kāyassa bhedā duppañño,"
    },
    {
     "n": 48,
     "text": "nirayaṁ sopapajjati."
    },
    {
     "n": 49,
     "text": "Na naggacariyā na jaṭā na paṅkā,"
    },
    {
     "n": 50,
     "text": "Nānāsakā thaṇḍilasāyikā vā;"
    },
    {
     "n": 51,
     "text": "Rajojallaṁ ukkuṭikappadhānaṁ,"
    },
    {
     "n": 52,
     "text": "Sodhenti maccaṁ avitiṇṇakaṅkhaṁ."
    },
    {
     "n": 53,
     "text": "Alaṅkato cepi samaṁ careyya,"
    },
    {
     "n": 54,
     "text": "Santo danto niyato brahmacārī;"
    },
    {
     "n": 55,
     "text": "Sabbesu bhūtesu nidhāya daṇḍaṁ,"
    },
    {
     "n": 56,
     "text": "So brāhmaṇo so samaṇo sa bhikkhu."
    },
    {
     "n": 57,
     "text": "Hirīnisedho puriso,"
    },
    {
     "n": 58,
     "text": "koci lokasmi vijjati;"
    },
    {
     "n": 59,
     "text": "Yo niddaṁ apabodheti,"
    },
    {
     "n": 60,
     "text": "asso bhadro kasāmiva."
    },
    {
     "n": 61,
     "text": "Asso yathā bhadro kasāniviṭṭho,"
    },
    {
     "n": 62,
     "text": "Ātāpino saṁvegino bhavātha;"
    },
    {
     "n": 63,
     "text": "Saddhāya sīlena ca vīriyena ca,"
    },
    {
     "n": 64,
     "text": "Samādhinā dhammavinicchayena ca;"
    },
    {
     "n": 65,
     "text": "Sampannavijjācaraṇā patissatā,"
    },
    {
     "n": 66,
     "text": "Jahissatha dukkhamidaṁ anappakaṁ."
    },
    {
     "n": 67,
     "text": "Udakañhi nayanti nettikā,"
    },
    {
     "n": 68,
     "text": "Usukārā namayanti tejanaṁ;"
    },
    {
     "n": 69,
     "text": "Dāruṁ namayanti tacchakā,"
    },
    {
     "n": 70,
     "text": "Attānaṁ damayanti subbatā."
    }
   ]
  },
  {
   "key": "en-translation",
   "lang": "en",
   "variant": "translation",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp129-145/sujato?lang=en (translation_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (bilara-data _publication-v2.json); the translator additionally requests that use not be for AI training datasets, AI models or AI-derived technologies",
   "lines": [
    {
     "n": 1,
     "text": "All tremble at the rod,"
    },
    {
     "n": 2,
     "text": "all fear death."
    },
    {
     "n": 3,
     "text": "Treating others like oneself,"
    },
    {
     "n": 4,
     "text": "neither kill nor incite to kill."
    },
    {
     "n": 5,
     "text": "All tremble at the rod,"
    },
    {
     "n": 6,
     "text": "all love life."
    },
    {
     "n": 7,
     "text": "Treating others like oneself,"
    },
    {
     "n": 8,
     "text": "neither kill nor incite to kill."
    },
    {
     "n": 9,
     "text": "Creatures love happiness,"
    },
    {
     "n": 10,
     "text": "so if you harm them with a stick"
    },
    {
     "n": 11,
     "text": "in search of your own happiness,"
    },
    {
     "n": 12,
     "text": "after death you won’t find happiness."
    },
    {
     "n": 13,
     "text": "Creatures love happiness,"
    },
    {
     "n": 14,
     "text": "so if you don’t harm them with a stick"
    },
    {
     "n": 15,
     "text": "in search of your own happiness,"
    },
    {
     "n": 16,
     "text": "after death you will find happiness."
    },
    {
     "n": 17,
     "text": "Don’t speak harshly,"
    },
    {
     "n": 18,
     "text": "they may speak harshly back."
    },
    {
     "n": 19,
     "text": "For aggressive speech is painful,"
    },
    {
     "n": 20,
     "text": "and the rod may spring back on you."
    },
    {
     "n": 21,
     "text": "If you still yourself"
    },
    {
     "n": 22,
     "text": "like a broken gong,"
    },
    {
     "n": 23,
     "text": "you reach extinguishment"
    },
    {
     "n": 24,
     "text": "and know no conflict."
    },
    {
     "n": 25,
     "text": "As a cowherd drives the cows"
    },
    {
     "n": 26,
     "text": "to pasture with the rod,"
    },
    {
     "n": 27,
     "text": "so too old age and death"
    },
    {
     "n": 28,
     "text": "drive life from living beings."
    },
    {
     "n": 29,
     "text": "The fool does not understand"
    },
    {
     "n": 30,
     "text": "the evil that they do."
    },
    {
     "n": 31,
     "text": "But because of those deeds, that simpleton"
    },
    {
     "n": 32,
     "text": "is tormented as if burnt by fire."
    },
    {
     "n": 33,
     "text": "One who violently attacks"
    },
    {
     "n": 34,
     "text": "the peaceful and the innocent"
    },
    {
     "n": 35,
     "text": "swiftly falls"
    },
    {
     "n": 36,
     "text": "to one of ten bad states:"
    },
    {
     "n": 37,
     "text": "harsh pain; loss;"
    },
    {
     "n": 38,
     "text": "the breakup of the body;"
    },
    {
     "n": 39,
     "text": "serious illness;"
    },
    {
     "n": 40,
     "text": "mental distress;"
    },
    {
     "n": 41,
     "text": "hazards from rulers;"
    },
    {
     "n": 42,
     "text": "vicious slander;"
    },
    {
     "n": 43,
     "text": "loss of kin;"
    },
    {
     "n": 44,
     "text": "destruction of wealth;"
    },
    {
     "n": 45,
     "text": "or else their home"
    },
    {
     "n": 46,
     "text": "is consumed by fire."
    },
    {
     "n": 47,
     "text": "When their body breaks up, that witless person"
    },
    {
     "n": 48,
     "text": "is reborn in hell."
    },
    {
     "n": 49,
     "text": "Not nudity, nor matted hair, nor mud,"
    },
    {
     "n": 50,
     "text": "nor fasting, nor lying on bare ground,"
    },
    {
     "n": 51,
     "text": "nor wearing dust and dirt, or squatting on the heels,"
    },
    {
     "n": 52,
     "text": "will cleanse a mortal not free of doubt."
    },
    {
     "n": 53,
     "text": "Dressed up they may be, but if they live well—"
    },
    {
     "n": 54,
     "text": "peaceful, tamed, committed to the spiritual path,"
    },
    {
     "n": 55,
     "text": "having laid aside violence toward all creatures—"
    },
    {
     "n": 56,
     "text": "they are a brahmin, an ascetic, a mendicant."
    },
    {
     "n": 57,
     "text": "Can a person constrained by conscience"
    },
    {
     "n": 58,
