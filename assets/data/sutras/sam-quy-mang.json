    {
     "n": 95,
     "text": "thì biến thành rừng hương,"
    },
    {
     "n": 96,
     "text": "loài uống đồng ăn sắt"
    },
    {
     "n": 97,
     "text": "đều hóa sinh cõi tịnh,"
    },
    {
     "n": 98,
     "text": "khoác lông đội sừng"
    },
    {
     "n": 99,
     "text": "mắc nợ ngậm oan"
    },
    {
     "n": 100,
     "text": "hết cả cay chua"
    },
    {
     "n": 101,
     "text": "đồng nhuần lợi lạc."
    },
    {
     "n": 102,
     "text": "Lúc bịnh thì hiện làm dược liệu"
    },
    {
     "n": 103,
     "text": "chữa cơn trầm trọng,"
    },
    {
     "n": 104,
     "text": "thời đói lại hóa thành thóc lúa"
    },
    {
     "n": 105,
     "text": "cứu kẻ đói nghèo,"
    },
    {
     "n": 106,
     "text": "hễ có ích lợi"
    },
    {
     "n": 107,
     "text": "thì làm tất cả."
    },
    {
     "n": 108,
     "text": "Ước nguyện thân thù bao kiếp"
    },
    {
     "n": 109,
     "text": "cầu mong bà con hiện tại"
    },
    {
     "n": 110,
     "text": "đều thoát bốn loài chìm ngập"
    },
    {
     "n": 111,
     "text": "đều bỏ muôn kiếp ái ân,"
    },
    {
     "n": 112,
     "text": "cùng mọi sinh linh"
