   "licenseNote": "không thấy tuyên bố giấy phép trên trang; chân trang ghi \"Trình bày: Nhị Tường\", \"Cập nhật: 3-6-2007\", trang \"Nguồn: www.buddhismtoday.com\"",
   "note": "Giữ nguyên chữ của nguồn; bỏ số chú thích [(n)] và các chỉ dẫn lễ nghi như \"(3 lần)\", \"(1 lạy)\". Dịch âm ngắt câu theo dấu câu của nguồn. Giữ ngắt dòng theo nguồn.",
   "lines": [
    {
     "n": 1,
     "text": "Kính lạy khắp mười phương"
    },
    {
     "n": 2,
     "text": "các đức Điều ngự sư,"
    },
    {
     "n": 3,
     "text": "cùng với Vi diệu pháp"
    },
    {
     "n": 4,
     "text": "do các ngài tuyên dương,"
    },
    {
     "n": 5,
     "text": "và những Giải thoát tăng"
    },
    {
     "n": 6,
     "text": "là bốn quả ba thừa,"
    },
    {
     "n": 7,
     "text": "nguyện ban lòng từ mẫn"
    },
    {
     "n": 8,
     "text": "nhiếp thọ cho chúng con."
    },
    {
     "n": 9,
     "text": "Đệ tử chúng con"
    },
    {
     "n": 10,
     "text": "tự trái tánh thật,"
    },
    {
     "n": 11,
     "text": "vào oan dòng mê;"
    },
    {
     "n": 12,
     "text": "nổi chìm theo sống chết,"
    },
    {
     "n": 13,
     "text": "tham nhiễm với sắc thanh."
    },
    {
     "n": 14,
     "text": "Mười triền mười sử"
    },
    {
     "n": 15,
     "text": "chứa thành nguyên nhân hữu lậu,"
    },
    {
     "n": 16,
     "text": "sáu căn sáu trần"
    },
    {
     "n": 17,
     "text": "gây nên tội lỗi vô biên."
    },
    {
     "n": 18,
     "text": "Chìm hoài biển khổ,"
    },
    {
     "n": 19,
     "text": "lún sâu đường tà."
    },
    {
     "n": 20,
     "text": "Chấp trước bản ngã,"
    },
    {
     "n": 21,
     "text": "đam mê tha nhân;"
    },
    {
     "n": 22,
     "text": "nâng đỡ kẻ cong,"
    },
    {
     "n": 23,
     "text": "loại bỏ người thẳng."
    },
    {
     "n": 24,
     "text": "Nghiệp chướng nhiều đời,"
    },
    {
     "n": 25,
     "text": "lỡ lầm bao kiếp,"
    },
    {
     "n": 26,
     "text": "ngửa mong Tam bảo"
    },
    {
     "n": 27,
     "text": "dũ lòng từ bi,"
    },
    {
     "n": 28,
     "text": "lọc sạch nhất tâm"
    },
    {
     "n": 29,
     "text": "cầu xin sám hối."
    },
    {
     "n": 30,
     "text": "Chúng con nguyện cầu"
    },
    {
     "n": 31,
     "text": "được đức Năng nhân cứu vớt"
    },
    {
     "n": 32,
     "text": "được các thiện hữu dắt dìu,"
    },
    {
     "n": 33,
     "text": "ra khỏi hầm hố phiền não"
    },
    {
     "n": 34,
     "text": "vượt đến bến bờ bồ đề."
    },
    {
     "n": 35,
     "text": "Đời này"
    },
    {
     "n": 36,
     "text": "nền phước đức ngôi sinh mạng"
    },
    {
     "n": 37,
     "text": "đều mong tốt thịnh,"
    },
    {
     "n": 38,
     "text": "kiếp sau"
    },
    {
     "n": 39,
     "text": "giống tuệ giác lúa tâm linh"
    },
    {
     "n": 40,
     "text": "đều cầu lớn tươi."
    },
    {
     "n": 41,
     "text": "Sinh nhằm xứ trung tâm"
    },
    {
     "n": 42,
     "text": "lớn gặp thầy minh trí,"
    },
    {
     "n": 43,
     "text": "xuất gia với đức chánh tín"
    },
    {
     "n": 44,
     "text": "nhập đạo bằng tuổi đồng chân,"
    },
    {
     "n": 45,
     "text": "sáu căn lanh sáng"
    },
    {
     "n": 46,
     "text": "ba nghiệp thuần hòa,"
    },
    {
     "n": 47,
     "text": "không nhiễm thế duyên"
    },
    {
     "n": 48,
     "text": "thường tu phạn hạnh,"
    },
    {
     "n": 49,
     "text": "chấp trì giới luật"
    },
    {
     "n": 50,
     "text": "trần nghiệp không thể xâm phạm"
    },
    {
     "n": 51,
     "text": "nghiêm hộ uy nghi"
    },
    {
     "n": 52,
     "text": "côn trùng cũng khó tổn thương."
    },
    {
     "n": 53,
     "text": "Không gặp tám nạn"
    },
    {
     "n": 54,
     "text": "chẳng thiếu bốn duyên,"
    },
    {
     "n": 55,
     "text": "trí bát nhã thường hiện tiền"
    },
    {
     "n": 56,
     "text": "tâm bồ đề không thoái chuyển,"
    },
    {
     "n": 57,
     "text": "tu tập chánh pháp"
    },
    {
     "n": 58,
     "text": "liễu ngộ đại thừa,"
    },
    {
     "n": 59,
     "text": "mở cửa hạnh nguyện"
    },
    {
     "n": 60,
     "text": "sáu ba la mật,"
    },
    {
     "n": 61,
     "text": "vượt biển đời kiếp"
    },
    {
     "n": 62,
     "text": "ba a tăng kỳ."
    },
    {
     "n": 63,
     "text": "Nơi nơi dựng cờ chánh pháp"
    },
    {
     "n": 64,
     "text": "lớp lớp phá lưới hoài nghi,"
    },
    {
     "n": 65,
     "text": "chiến thắng loài ma"
    },
    {
     "n": 66,
     "text": "thừa kế dòng Phật,"
    },
    {
     "n": 67,
     "text": "phụng sự mười phương Phật đà"
    },
    {
     "n": 68,
     "text": "không hề mệt nhọc,"
    },
    {
     "n": 69,
     "text": "tu học toàn bộ pháp môn"
    },
    {
     "n": 70,
     "text": "đều được thông suốt,"
    },
    {
     "n": 71,
     "text": "thực hành rộng lớn"
    },
    {
     "n": 72,
     "text": "mọi thứ phước tuệ,"
    },
    {
     "n": 73,
     "text": "ích lợi cùng khắp"
    },
    {
     "n": 74,
     "text": "các loài chúng sinh,"
    },
    {
     "n": 75,
     "text": "thành tựu sáu pháp thần thông"
    },
    {
     "n": 76,
     "text": "viên mãn một đời Phật quả."
    },
    {
     "n": 77,
     "text": "Thế rồi sau đó"
    },
    {
     "n": 78,
     "text": "không bỏ pháp giới"
    },
    {
     "n": 79,
     "text": "khắp vào trần lao,"
    },
    {
     "n": 80,
     "text": "đồng đẳng với từ tâm Quan âm"
    },
    {
     "n": 81,
     "text": "hoạt động theo hạnh nguyện Phổ hiền:"
    },
    {
     "n": 82,
     "text": "Cõi này cõi khác"
    },
    {
     "n": 83,
     "text": "tùy loại tùy hình,"
    },
    {
     "n": 84,
     "text": "ứng hiện sắc thân"
    },
    {
     "n": 85,
     "text": "tuyên dương diệu pháp."
    },
    {
     "n": 86,
     "text": "Chỗ khổ địa ngục"
    },
    {
     "n": 87,
     "text": "đường khốn ngạ quỉ"
    },
    {
     "n": 88,
     "text": "thì phóng ánh sáng lớn"
    },
    {
     "n": 89,
     "text": "hoặc hiện thần biến nhiều,"
    },
    {
     "n": 90,
     "text": "những người thấy hình"
