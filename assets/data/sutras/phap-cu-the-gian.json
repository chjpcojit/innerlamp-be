 "reference": "Dhp 167-178",
 "summary": "Phẩm kệ trong Kinh Pháp Cú (Tiểu Bộ, Dhp 167–178) nói về cách sống giữa thế gian. Kệ khuyên chớ theo pháp hạ liệt, chớ buông lung hay tin tà kiến, hãy nỗ lực sống theo chánh hạnh. Phẩm cũng nhắc nhìn đời như bọt nước, như cảnh huyển, và kết bằng ý rằng quả Dự Lưu còn hơn việc thống lãnh cõi đất hay sinh lên cõi trời.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Thế Gian",
  "pli": "Lokavagga",
  "en": "The World"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
