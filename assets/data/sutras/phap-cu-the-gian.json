   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Hīnaṁ dhammaṁ na seveyya,"
    },
    {
     "n": 2,
     "text": "pamādena na saṁvase;"
    },
    {
     "n": 3,
     "text": "Micchādiṭṭhiṁ na seveyya,"
    },
    {
     "n": 4,
     "text": "na siyā lokavaḍḍhano."
    },
    {
     "n": 5,
     "text": "Uttiṭṭhe nappamajjeyya,"
    },
    {
     "n": 6,
     "text": "dhammaṁ sucaritaṁ care;"
    },
    {
     "n": 7,
     "text": "Dhammacārī sukhaṁ seti,"
    },
    {
     "n": 8,
     "text": "asmiṁ loke paramhi ca."
    },
    {
     "n": 9,
     "text": "Dhammaṁ care sucaritaṁ,"
    },
    {
     "n": 10,
     "text": "na naṁ duccaritaṁ care;"
    },
    {
     "n": 11,
     "text": "Dhammacārī sukhaṁ seti,"
    },
    {
     "n": 12,
     "text": "asmiṁ loke paramhi ca."
    },
    {
     "n": 13,
     "text": "Yathā pubbuḷakaṁ passe,"
    },
    {
     "n": 14,
     "text": "yathā passe marīcikaṁ;"
    },
    {
     "n": 15,
     "text": "Evaṁ lokaṁ avekkhantaṁ,"
    },
    {
     "n": 16,
     "text": "maccurājā na passati."
    },
    {
     "n": 17,
     "text": "Etha passathimaṁ lokaṁ,"
    },
    {
     "n": 18,
     "text": "cittaṁ rājarathūpamaṁ;"
    },
    {
     "n": 19,
     "text": "Yattha bālā visīdanti,"
    },
    {
     "n": 20,
     "text": "natthi saṅgo vijānataṁ."
    },
    {
     "n": 21,
     "text": "Yo ca pubbe pamajjitvā,"
    },
    {
     "n": 22,
     "text": "pacchā so nappamajjati;"
    },
    {
     "n": 23,
     "text": "Somaṁ lokaṁ pabhāseti,"
    },
    {
     "n": 24,
     "text": "abbhā muttova candimā."
    },
    {
     "n": 25,
     "text": "Yassa pāpaṁ kataṁ kammaṁ,"
    },
    {
     "n": 26,
     "text": "kusalena pidhīyati;"
    },
    {
     "n": 27,
     "text": "Somaṁ lokaṁ pabhāseti,"
    },
    {
     "n": 28,
     "text": "abbhā muttova candimā."
    },
    {
     "n": 29,
     "text": "Andhabhūto ayaṁ loko,"
    },
    {
     "n": 30,
     "text": "tanukettha vipassati;"
    },
    {
     "n": 31,
     "text": "Sakuṇo jālamuttova,"
    },
    {
     "n": 32,
     "text": "appo saggāya gacchati."
    },
    {
     "n": 33,
     "text": "Haṁsādiccapathe yanti,"
    },
    {
     "n": 34,
     "text": "ākāse yanti iddhiyā;"
    },
    {
     "n": 35,
     "text": "Nīyanti dhīrā lokamhā,"
    },
    {
     "n": 36,
     "text": "jetvā māraṁ savāhiniṁ."
    },
    {
     "n": 37,
     "text": "Ekaṁ dhammaṁ atītassa,"
    },
    {
     "n": 38,
     "text": "musāvādissa jantuno;"
    },
    {
     "n": 39,
     "text": "Vitiṇṇaparalokassa,"
    },
    {
     "n": 40,
     "text": "natthi pāpaṁ akāriyaṁ."
    },
    {
     "n": 41,
     "text": "Na ve kadariyā devalokaṁ vajanti,"
    },
    {
     "n": 42,
     "text": "Bālā have nappasaṁsanti dānaṁ;"
    },
    {
     "n": 43,
     "text": "Dhīro ca dānaṁ anumodamāno,"
    },
    {
     "n": 44,
     "text": "Teneva so hoti sukhī parattha."
    },
    {
     "n": 45,
     "text": "Pathabyā ekarajjena,"
    },
    {
     "n": 46,
     "text": "saggassa gamanena vā;"
    },
    {
     "n": 47,
     "text": "Sabbalokādhipaccena,"
    },
    {
     "n": 48,
     "text": "sotāpattiphalaṁ varaṁ."
    }
   ]
  },
  {
