   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Chớ theo pháp hạ liệt."
    },
    {
     "n": 2,
     "text": "Chớ sống mặc, buông lung;"
    },
    {
     "n": 3,
     "text": "Chớ tin theo tà kiến,"
    },
    {
     "n": 4,
     "text": "Chớ tăng trưởng tục trần."
    },
    {
     "n": 5,
     "text": "Nỗ lực, chớ phóng dật!"
    },
    {
     "n": 6,
     "text": "Hãy sống theo chánh hạnh;"
    },
    {
     "n": 7,
     "text": "Người chánh hạnh hưởng lạc,"
    },
    {
     "n": 8,
     "text": "Cả đời này, đời sau."
    },
    {
     "n": 9,
     "text": "Hãy khéo sống chánh hạnh,"
    },
    {
     "n": 10,
     "text": "Chớ sống theo tà hạnh!"
    },
    {
     "n": 11,
     "text": "Người chánh hạnh hưởng lạc,"
    },
    {
     "n": 12,
     "text": "Cả đời này, đời sau."
    },
    {
     "n": 13,
     "text": "Hãy nhìn như bọt nước,"
    },
    {
     "n": 14,
     "text": "Hãy nhìn như cảnh huyển!"
    },
    {
     "n": 15,
     "text": "Quán nhìn đời như vậy,"
    },
    {
     "n": 16,
     "text": "Thần chết không bắt gặp."
    },
    {
     "n": 17,
     "text": "Hãy đến nhìn đời này,"
    },
    {
     "n": 18,
     "text": "Như xe vua lộng lẫy,"
    },
    {
     "n": 19,
     "text": "Người ngu mới tham đắm,"
    },
    {
     "n": 20,
     "text": "Kẻ trí nào đắm say."
    },
    {
     "n": 21,
     "text": "Ai sống trước buông lung,"
    },
    {
     "n": 22,
     "text": "Sau sống không phóng dật,"
    },
    {
     "n": 23,
     "text": "Chói sáng rực đời này."
    },
    {
     "n": 24,
     "text": "Như trăng thoát mây che."
    },
    {
     "n": 25,
     "text": "Ai dùng các hạnh lành,"
    },
    {
     "n": 26,
     "text": "Làm xóa mờ nghiệp ác,"
    },
    {
     "n": 27,
     "text": "Chói sáng rực đời này,"
    },
    {
     "n": 28,
     "text": "Như trăng thoát mây che."
    },
    {
     "n": 29,
     "text": "Đời này thật mù quáng,"
    },
    {
     "n": 30,
     "text": "Ít kẻ thấy rõ ràng."
    },
    {
     "n": 31,
     "text": "Như chim thoát khỏi lưới,"
    },
    {
     "n": 32,
     "text": "Rất ít đi thiên giới."
    },
    {
     "n": 33,
     "text": "Như chim thiên nga bay,"
    },
    {
     "n": 34,
     "text": "Thần thông liệng giữa trời;"
    },
    {
     "n": 35,
     "text": "Chiến thắng ma, ma quân,"
    },
    {
     "n": 36,
     "text": "Kẻ trí thoát đời này."
    },
    {
     "n": 37,
     "text": "Ai vi phạm một pháp,"
    },
    {
     "n": 38,
     "text": "Ai nói lời vọng ngữ,"
    },
    {
     "n": 39,
     "text": "Ai bác bỏ đời sau,"
    },
    {
     "n": 40,
     "text": "Không ác nào không làm."
    },
    {
     "n": 41,
     "text": "Keo kiết không sanh thiên,"
    },
    {
     "n": 42,
     "text": "Kẻ ngu ghét bố thí,"
    },
    {
     "n": 43,
     "text": "Người trí thích bố thí,"
    },
    {
     "n": 44,
     "text": "Đời sau, được hưởng lạc."
    },
    {
     "n": 45,
     "text": "Hơn thống lãnh cõi đất,"
    },
    {
     "n": 46,
     "text": "Hơn được sanh cõi trời,"
    },
    {
     "n": 47,
     "text": "Hơn chủ trì vũ trụ,"
    },
    {
     "n": 48,
     "text": "Quả Dự Lưu tối thắng."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
