{
 "id": "phap-cu-a-la-han",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 90-99",
 "summary": "Phẩm thuộc Kinh Pháp Cú (Tiểu Bộ, kệ 90-99), mô tả vị A-la-hán đã đến đích, không còn sầu muộn, thoát khỏi mọi buộc ràng. Các bài kệ ca ngợi người không chất chứa, nhiếp phục các căn, không còn kiêu mạn và lậu hoặc, bình thản như đất, không hiềm hận. Phẩm giúp người đọc hình dung cảnh giới giải thoát của bậc thánh.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm A-la-hán",
  "pli": "Arahantavagga",
  "en": "The Perfected Ones"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 3,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp90-99/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Đích đã đến, không sầu,"
    },
    {
     "n": 2,
     "text": "Giải thoát ngoài tất cả,"
    },
    {
     "n": 3,
     "text": "Đoạn trừ mọi buộc ràng,"
    },
    {
     "n": 4,
     "text": "Vị ấy không nhiệt não."
    },
    {
     "n": 5,
     "text": "Tự sách tấn chánh niệm,"
    },
    {
     "n": 6,
     "text": "Không thích cư xá nào,"
    },
    {
     "n": 7,
     "text": "Như ngỗng trời rời ao,"
    },
    {
     "n": 8,
     "text": "Bỏ sau mọi trú ẩn."
    },
    {
     "n": 9,
     "text": "Tài sản không chất chứa,"
    },
    {
     "n": 10,
     "text": "Ăn uống biết liễu trì,"
    },
    {
     "n": 11,
     "text": "Tự tại trong hành xứ,"
    },
    {
     "n": 12,
     "text": "Không vô tướng, giải thoát,"
    },
    {
     "n": 13,
     "text": "Như chim giữa hư không,"
    },
    {
     "n": 14,
     "text": "Hướng chúng đi khó tìm."
    },
    {
     "n": 15,
     "text": "Ai lậu hoặc đoạn sạch,"
    },
    {
     "n": 16,
     "text": "Ăn uống không tham đắm,"
    },
    {
     "n": 17,
     "text": "Tự tại trong hành xứ,"
    },
    {
     "n": 18,
     "text": "Không, vô tướng, giải thoát."
    },
    {
     "n": 19,
     "text": "Như chim giữa hư không,"
    },
    {
     "n": 20,
     "text": "Dấu chân thật khó tìm."
    },
    {
     "n": 21,
     "text": "Ai nhiếp phục các căn,"
    },
    {
     "n": 22,
     "text": "Như đánh xe điều ngự,"
    },
    {
     "n": 23,
     "text": "Mạn trừ, lậu hoặc dứt,"
    },
    {
     "n": 24,
     "text": "Người vậy, Chư Thiên mến."
    },
    {
     "n": 25,
     "text": "Như đất không hiềm hận,"
    },
    {
     "n": 26,
     "text": "Như cột trụ kiên trì,"
    },
    {
     "n": 27,
     "text": "Như hồ, không bùn nhơ,"
    },
    {
     "n": 28,
     "text": "Không luân hồi, vị ấy."
    },
    {
     "n": 29,
     "text": "Người tâm ý an tịnh,"
    },
    {
     "n": 30,
     "text": "Lời an, nghiệp cũng an,"
    },
    {
     "n": 31,
     "text": "Chánh trí, chơn giải thoát,"
    },
    {
     "n": 32,
     "text": "Tịnh lạc là vị ấy."
    },
    {
     "n": 33,
     "text": "Không tin, hiểu Vô vi."
    },
    {
     "n": 34,
     "text": "Người cắt mọi hệ lụy,"
    },
    {
     "n": 35,
     "text": "Cơ hội tận, xả ly"
    },
    {
     "n": 36,
     "text": "Vị ấy thật tối thượng."
    },
    {
     "n": 37,
     "text": "Làng mạc hay rừng núi"
    },
    {
     "n": 38,
     "text": "Thung lũng hay đồi cao,"
    },
    {
     "n": 39,
     "text": "La-hán trú chỗ nào,"
    },
    {
     "n": 40,
     "text": "Đất ấy thật khả ái."
    },
    {
     "n": 41,
     "text": "Khả ái thay núi rừng,"
    },
    {
     "n": 42,
     "text": "Chỗ người phàm không ưa,"
    },
    {
     "n": 43,
     "text": "Vị ly tham ưa thích,"
    },
    {
     "n": 44,
     "text": "Vì không tìm dục lạc."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp90-99/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Gataddhino visokassa,"
    },
    {
     "n": 2,
     "text": "vippamuttassa sabbadhi;"
    },
    {
     "n": 3,
     "text": "Sabbaganthappahīnassa,"
    },
    {
     "n": 4,
     "text": "pariḷāho na vijjati."
    },
    {
     "n": 5,
     "text": "Uyyuñjanti satīmanto,"
    },
    {
     "n": 6,
     "text": "na nikete ramanti te;"
    },
    {
     "n": 7,
     "text": "Haṁsāva pallalaṁ hitvā,"
    },
    {
     "n": 8,
     "text": "okamokaṁ jahanti te."
    },
    {
     "n": 9,
     "text": "Yesaṁ sannicayo natthi,"
    },
    {
     "n": 10,
     "text": "ye pariññātabhojanā;"
    },
    {
     "n": 11,
     "text": "Suññato animitto ca,"
    },
    {
     "n": 12,
     "text": "vimokkho yesaṁ gocaro;"
    },
    {
     "n": 13,
     "text": "Ākāseva sakuntānaṁ,"
    },
    {
     "n": 14,
     "text": "gati tesaṁ durannayā."
    },
    {
     "n": 15,
     "text": "Yassāsavā parikkhīṇā,"
    },
    {
     "n": 16,
     "text": "āhāre ca anissito;"
    },
    {
     "n": 17,
     "text": "Suññato animitto ca,"
    },
    {
     "n": 18,
     "text": "vimokkho yassa gocaro;"
    },
    {
     "n": 19,
     "text": "Ākāseva sakuntānaṁ,"
    },
    {
     "n": 20,
     "text": "padaṁ tassa durannayaṁ."
    },
    {
     "n": 21,
     "text": "Yassindriyāni samathaṅgatāni,"
    },
    {
     "n": 22,
     "text": "Assā yathā sārathinā sudantā;"
    },
    {
     "n": 23,
     "text": "Pahīnamānassa anāsavassa,"
    },
    {
     "n": 24,
     "text": "Devāpi tassa pihayanti tādino."
    },
    {
     "n": 25,
     "text": "Pathavisamo no virujjhati,"
    },
    {
     "n": 26,
     "text": "Indakhilupamo tādi subbato;"
    },
    {
     "n": 27,
     "text": "Rahadova apetakaddamo,"
    },
    {
     "n": 28,
     "text": "Saṁsārā na bhavanti tādino."
    },
    {
     "n": 29,
     "text": "Santaṁ tassa manaṁ hoti,"
    },
    {
     "n": 30,
     "text": "santā vācā ca kamma ca;"
    },
    {
     "n": 31,
     "text": "Sammadaññāvimuttassa,"
    },
    {
     "n": 32,
     "text": "upasantassa tādino."
    },
    {
     "n": 33,
     "text": "Assaddho akataññū ca,"
    },
    {
     "n": 34,
     "text": "sandhicchedo ca yo naro;"
    },
    {
     "n": 35,
     "text": "Hatāvakāso vantāso,"
    },
    {
     "n": 36,
     "text": "sa ve uttamaporiso."
    },
    {
     "n": 37,
     "text": "Gāme vā yadi vāraññe,"
    },
    {
     "n": 38,
     "text": "Ninne vā yadi vā thale;"
    },
    {
     "n": 39,
     "text": "Yattha arahanto viharanti,"
    },
    {
     "n": 40,
     "text": "Taṁ bhūmirāmaṇeyyakaṁ."
    },
    {
     "n": 41,
     "text": "Ramaṇīyāni araññāni,"
    },
    {
     "n": 42,
     "text": "yattha na ramatī jano;"
    },
    {
     "n": 43,
     "text": "Vītarāgā ramissanti,"
    },
    {
     "n": 44,
     "text": "na te kāmagavesino."
    }
   ]
  },
  {
   "key": "en-translation",
   "lang": "en",
   "variant": "translation",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp90-99/sujato?lang=en (translation_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (bilara-data _publication-v2.json); the translator additionally requests that use not be for AI training datasets, AI models or AI-derived technologies",
   "lines": [
    {
     "n": 1,
     "text": "At journey’s end, rid of sorrow;"
    },
    {
     "n": 2,
     "text": "everywhere free,"
    },
    {
     "n": 3,
     "text": "all ties given up,"
    },
    {
     "n": 4,
     "text": "no fever is found in them."
    },
    {
     "n": 5,
     "text": "The mindful apply themselves;"
    },
    {
     "n": 6,
     "text": "they delight in no abode."
    },
    {
     "n": 7,
     "text": "Like a swan gone from the marsh,"
    },
    {
     "n": 8,
     "text": "they leave home after home behind."
    },
    {
     "n": 9,
     "text": "Those with nothing stored up,"
    },
    {
     "n": 10,
     "text": "who have understood their food,"
    },
    {
     "n": 11,
     "text": "whose domain is the liberation"
    },
    {
     "n": 12,
     "text": "of the signless and the empty:"
    },
    {
     "n": 13,
     "text": "their path is hard to trace,"
    },
    {
     "n": 14,
     "text": "like birds in the sky."
    },
    {
     "n": 15,
     "text": "One whose defilements have ended;"
    },
    {
     "n": 16,
     "text": "who’s not attached to food;"
    },
    {
     "n": 17,
     "text": "whose domain is the liberation"
    },
    {
     "n": 18,
     "text": "of the signless and the empty:"
    },
    {
     "n": 19,
     "text": "their track is hard to trace,"
    },
    {
     "n": 20,
     "text": "like birds in the sky."
    },
    {
     "n": 21,
     "text": "Whose faculties have become serene,"
    },
    {
     "n": 22,
     "text": "like horses tamed by a charioteer,"
    },
    {
     "n": 23,
     "text": "who has abandoned conceit and defilements;"
    },
    {
     "n": 24,
     "text": "the unaffected one is envied by even the gods."
    },
    {
     "n": 25,
     "text": "Undisturbed like the earth,"
    },
    {
     "n": 26,
     "text": "true to their vows, steady as Indra’s pillar,"
    },
    {
     "n": 27,
     "text": "like a lake clear of mud;"
    },
    {
     "n": 28,
     "text": "such a one does not transmigrate."
    },
    {
     "n": 29,
     "text": "Their mind is peaceful,"
    },
    {
     "n": 30,
     "text": "peaceful are their speech and deeds."
    },
    {
     "n": 31,
     "text": "Such a one is at peace,"
    },
    {
     "n": 32,
     "text": "rightly freed through enlightenment."
    },
    {
     "n": 33,
     "text": "Lacking faith, a house-breaker,"
    },
    {
     "n": 34,
     "text": "one who acknowledges nothing,"
    },
    {
     "n": 35,
     "text": "purged of hope, they’ve wasted their chance:"
    },
    {
     "n": 36,
     "text": "that is indeed the supreme person!"
    },
    {
     "n": 37,
     "text": "Whether in village or wilderness,"
    },
    {
     "n": 38,
     "text": "in a valley or the uplands,"
    },
    {
     "n": 39,
     "text": "wherever the perfected ones live"
    },
    {
     "n": 40,
     "text": "is a delightful place."
    },
    {
     "n": 41,
     "text": "Delightful are the wildernesses"
    },
    {
     "n": 42,
     "text": "where no people delight."
    },
    {
     "n": 43,
     "text": "Those free of greed will delight there,"
    },
    {
     "n": 44,
     "text": "not those who seek sensual pleasures."
    }
   ]
  }
 ]
}
