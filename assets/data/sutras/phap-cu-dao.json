{
 "id": "phap-cu-dao",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 273-289",
 "summary": "Phẩm thuộc Kinh Pháp Cú (Tiểu Bộ, kệ 273-289), nói về con đường tu tập, trong đó Bát Chánh Đạo được xem là con đường thù thắng đưa đến thanh tịnh. Phẩm nêu cách quán các hành là vô thường, khổ, các pháp là vô ngã để nhàm chán khổ đau, khuyên tinh tấn tự thực hành vì Như Lai chỉ là người chỉ đường.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Đạo",
  "pli": "Maggavagga",
  "en": "The Path"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 5,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp273-289/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Tám chánh, đường thù thắng,"
    },
    {
     "n": 2,
     "text": "Bốn câu, lý thù thắng,"
    },
    {
     "n": 3,
     "text": "Ly tham, pháp thù thắng,"
    },
    {
     "n": 4,
     "text": "Giữa các loài hai chân, Pháp nhãn, người thù thắng."
    },
    {
     "n": 5,
     "text": "Đường này, không đường khác"
    },
    {
     "n": 6,
     "text": "Đưa đến kiến thanh tịnh."
    },
    {
     "n": 7,
     "text": "Nếu ngươi theo đường này,"
    },
    {
     "n": 8,
     "text": "Ma quân sẽ mê loạn."
    },
    {
     "n": 9,
     "text": "Nếu ngươi theo đường này,"
    },
    {
     "n": 10,
     "text": "Đau khổ được đoạn tận."
    },
    {
     "n": 11,
     "text": "Ta dạy ngươi con đường."
    },
    {
     "n": 12,
     "text": "Với trí, gai chướng diệt."
    },
    {
     "n": 13,
     "text": "Ngươi hãy nhiệt tình làm,"
    },
    {
     "n": 14,
     "text": "Như Lai chỉ thuyết dạy."
    },
    {
     "n": 15,
     "text": "Người hành trì thiền địn"
    },
    {
     "n": 16,
     "text": "Thoát trói buộc ác Ma."
    },
    {
     "n": 17,
     "text": "Tất cả hành vô thường"
    },
    {
     "n": 18,
     "text": "Với Tuệ, quán thấy vậy"
    },
    {
     "n": 19,
     "text": "Đau khổ được nhàm chán:"
    },
    {
     "n": 20,
     "text": "Chính con đường thanh tịnh."
    },
    {
     "n": 21,
     "text": "Tất cả hành khổ đau"
    },
    {
     "n": 22,
     "text": "Với Tuệ, quán thấy vậy,"
    },
    {
     "n": 23,
     "text": "Đau khổ được nhàm chán:"
    },
    {
     "n": 24,
     "text": "Chính con đường thanh tịnh."
    },
    {
     "n": 25,
     "text": "Tất cả pháp vô ngã,"
    },
    {
     "n": 26,
     "text": "Với Tuệ, quán thấy vậy,"
    },
    {
     "n": 27,
     "text": "Đau khổ được nhàm chán:"
    },
    {
     "n": 28,
     "text": "Chính con đường thanh tịnh."
    },
    {
     "n": 29,
     "text": "Khi cần, không nỗ lực,"
    },
    {
     "n": 30,
     "text": "Tuy trẻ mạnh, nhưng lười"
    },
    {
     "n": 31,
     "text": "Chí nhu nhược, biếng nhác."
    },
    {
     "n": 32,
     "text": "Với trí tuệ thụ động, Sao tìm được chánh đạo?"
    },
    {
     "n": 33,
     "text": "Lời nói được thận trọng, Tâm tư khéo hộ phòng,"
    },
    {
     "n": 34,
     "text": "Thân chớ làm điều ác"
    },
    {
     "n": 35,
     "text": "Hãy giữ ba nghiệp tịnh,"
    },
    {
     "n": 36,
     "text": "Chứng đạo thánh nhân dạy."
    },
    {
     "n": 37,
     "text": "Tu Thiền, trí tuệ sanh,"
    },
    {
     "n": 38,
     "text": "Bỏ Thiền, trí tuệ diệt."
    },
    {
     "n": 39,
     "text": "Biết con đường hai ngả"
    },
    {
     "n": 40,
     "text": "Đưa đến hữu, phi hữu,"
    },
    {
     "n": 41,
     "text": "Hãy tự mình nỗ lực,"
    },
    {
     "n": 42,
     "text": "Khiến trí tuệ tăng trưởng."
    },
    {
     "n": 43,
     "text": "Đốn rừng không đốn cây"
    },
    {
     "n": 44,
     "text": "Từ rừng, sinh sợ hãi;"
    },
    {
     "n": 45,
     "text": "Đốn rừng và ái dục,"
    },
    {
     "n": 46,
     "text": "Tỷ kheo, hãy tịch mịch."
    },
    {
     "n": 47,
     "text": "Khi nào chưa cắt tiệt,"
    },
    {
     "n": 48,
     "text": "Ái dục giữa gái trai,"
    },
    {
     "n": 49,
     "text": "Tâm ý vẫn buộc ràng,"
    },
    {
     "n": 50,
     "text": "Như bò con vú mẹ."
    },
    {
     "n": 51,
     "text": "Tự cắt dây ái dục,"
    },
    {
     "n": 52,
     "text": "Như tay bẻ sen thu,"
    },
    {
     "n": 53,
     "text": "Hãy tu đạo tịch tịnh,"
    },
    {
     "n": 54,
     "text": "Niết-bàn, Thiện Thệ dạy."
    },
    {
     "n": 55,
     "text": "Mùa mưa ta ở đây"
    },
    {
     "n": 56,
     "text": "Đông, hạ cũng ở đây,"
    },
    {
     "n": 57,
     "text": "Người ngu tâm tưởng vậy,"
    },
    {
     "n": 58,
     "text": "Không tự giác hiểm nguy."
    },
    {
     "n": 59,
     "text": "Người tâm ý đắm say"
    },
    {
     "n": 60,
     "text": "Con cái và súc vật,"
    },
    {
     "n": 61,
     "text": "Tử thần bắt người ấy,"
    },
    {
     "n": 62,
     "text": "Như lụt trôi hàng ngủ."
    },
    {
     "n": 63,
     "text": "Một khi tử thần đến,"
    },
    {
     "n": 64,
     "text": "Không có con che chở,"
    },
    {
     "n": 65,
     "text": "Không cha, không bà con,"
    },
    {
     "n": 66,
     "text": "Không thân thích che chở."
    },
    {
     "n": 67,
     "text": "Biết rõ ý nghĩa này,"
    },
    {
     "n": 68,
     "text": "Bậc trí lo trì giới,"
    },
    {
     "n": 69,
     "text": "Mau lẹ làm thanh tịnh,"
    },
    {
     "n": 70,
     "text": "Con đường đến Niết bàn."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp273-289/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Maggānaṭṭhaṅgiko seṭṭho,"
    },
    {
     "n": 2,
     "text": "saccānaṁ caturo padā;"
    },
    {
     "n": 3,
     "text": "Virāgo seṭṭho dhammānaṁ,"
    },
    {
     "n": 4,
     "text": "dvipadānañca cakkhumā."
    },
    {
     "n": 5,
     "text": "Eseva maggo natthañño,"
    },
    {
     "n": 6,
     "text": "Dassanassa visuddhiyā;"
    },
    {
     "n": 7,
     "text": "Etañhi tumhe paṭipajjatha,"
    },
    {
     "n": 8,
     "text": "Mārassetaṁ pamohanaṁ."
    },
    {
     "n": 9,
     "text": "Etañhi tumhe paṭipannā,"
    },
    {
     "n": 10,
     "text": "dukkhassantaṁ karissatha;"
    },
    {
     "n": 11,
     "text": "Akkhāto vo mayā maggo,"
    },
    {
     "n": 12,
     "text": "aññāya sallakantanaṁ."
    },
    {
     "n": 13,
     "text": "Tumhehi kiccamātappaṁ,"
    },
    {
     "n": 14,
     "text": "akkhātāro tathāgatā;"
    },
    {
     "n": 15,
     "text": "Paṭipannā pamokkhanti,"
    },
    {
     "n": 16,
     "text": "jhāyino mārabandhanā."
    },
    {
     "n": 17,
     "text": "“Sabbe saṅkhārā aniccā”ti,"
    },
    {
     "n": 18,
     "text": "yadā paññāya passati;"
    },
    {
     "n": 19,
     "text": "Atha nibbindati dukkhe,"
    },
    {
     "n": 20,
     "text": "esa maggo visuddhiyā."
    },
    {
     "n": 21,
     "text": "“Sabbe saṅkhārā dukkhā”ti,"
    },
    {
     "n": 22,
     "text": "yadā paññāya passati;"
    },
    {
     "n": 23,
     "text": "Atha nibbindati dukkhe,"
    },
    {
     "n": 24,
     "text": "esa maggo visuddhiyā."
    },
    {
     "n": 25,
     "text": "“Sabbe dhammā anattā”ti,"
    },
    {
     "n": 26,
     "text": "yadā paññāya passati;"
    },
    {
     "n": 27,
     "text": "Atha nibbindati dukkhe,"
    },
    {
     "n": 28,
     "text": "esa maggo visuddhiyā."
    },
    {
     "n": 29,
     "text": "Uṭṭhānakālamhi anuṭṭhahāno,"
    },
    {
     "n": 30,
     "text": "Yuvā balī ālasiyaṁ upeto;"
    },
    {
     "n": 31,
     "text": "Saṁsannasaṅkappamano kusīto,"
    },
    {
     "n": 32,
     "text": "Paññāya maggaṁ alaso na vindati."
    },
    {
     "n": 33,
     "text": "Vācānurakkhī manasā susaṁvuto,"
    },
    {
     "n": 34,
     "text": "Kāyena ca nākusalaṁ kayirā;"
    },
    {
     "n": 35,
     "text": "Ete tayo kammapathe visodhaye,"
    },
    {
     "n": 36,
     "text": "Ārādhaye maggamisippaveditaṁ."
    },
    {
     "n": 37,
     "text": "Yogā ve jāyatī bhūri,"
    },
    {
     "n": 38,
     "text": "ayogā bhūrisaṅkhayo;"
    },
    {
     "n": 39,
     "text": "Etaṁ dvedhāpathaṁ ñatvā,"
    },
    {
     "n": 40,
     "text": "bhavāya vibhavāya ca;"
    },
    {
     "n": 41,
     "text": "Tathāttānaṁ niveseyya,"
    },
    {
     "n": 42,
     "text": "yathā bhūri pavaḍḍhati."
    },
    {
     "n": 43,
     "text": "Vanaṁ chindatha mā rukkhaṁ,"
    },
    {
     "n": 44,
     "text": "vanato jāyate bhayaṁ;"
    },
    {
     "n": 45,
     "text": "Chetvā vanañca vanathañca,"
    },
    {
     "n": 46,
     "text": "nibbanā hotha bhikkhavo."
    },
    {
     "n": 47,
     "text": "Yāva hi vanatho na chijjati,"
    },
    {
     "n": 48,
     "text": "Aṇumattopi narassa nārisu;"
    },
    {
     "n": 49,
     "text": "Paṭibaddhamanova tāva so,"
    },
    {
     "n": 50,
     "text": "Vaccho khīrapakova mātari."
    },
    {
     "n": 51,
     "text": "Ucchinda sinehamattano,"
    },
    {
     "n": 52,
     "text": "Kumudaṁ sāradikaṁva pāṇinā;"
    },
    {
     "n": 53,
     "text": "Santimaggameva brūhaya,"
    },
    {
     "n": 54,
     "text": "Nibbānaṁ sugatena desitaṁ."
    },
    {
     "n": 55,
     "text": "Idha vassaṁ vasissāmi,"
    },
    {
     "n": 56,
     "text": "idha hemantagimhisu;"
    },
    {
     "n": 57,
     "text": "Iti bālo vicinteti,"
    },
    {
     "n": 58,
     "text": "antarāyaṁ na bujjhati."
    },
    {
     "n": 59,
     "text": "Taṁ puttapasusammattaṁ,"
    },
    {
     "n": 60,
     "text": "byāsattamanasaṁ naraṁ;"
    },
    {
     "n": 61,
     "text": "Suttaṁ gāmaṁ mahoghova,"
    },
    {
     "n": 62,
     "text": "maccu ādāya gacchati."
    },
    {
     "n": 63,
     "text": "Na santi puttā tāṇāya,"
    },
    {
     "n": 64,
     "text": "na pitā nāpi bandhavā;"
    },
    {
     "n": 65,
     "text": "Antakenādhipannassa,"
    },
    {
     "n": 66,
     "text": "natthi ñātīsu tāṇatā."
    },
    {
     "n": 67,
     "text": "Etamatthavasaṁ ñatvā,"
    },
    {
     "n": 68,
     "text": "paṇḍito sīlasaṁvuto;"
    },
    {
     "n": 69,
     "text": "Nibbānagamanaṁ maggaṁ,"
    },
    {
     "n": 70,
     "text": "khippameva visodhaye."
    }
   ]
  },
  {
   "key": "en-translation",
   "lang": "en",
   "variant": "translation",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp273-289/sujato?lang=en (translation_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (bilara-data _publication-v2.json); the translator additionally requests that use not be for AI training datasets, AI models or AI-derived technologies",
   "lines": [
    {
     "n": 1,
     "text": "Of paths, the eightfold is the best;"
    },
    {
     "n": 2,
     "text": "of truths, the four statements;"
    },
    {
     "n": 3,
     "text": "dispassion is the best of things,"
    },
    {
     "n": 4,
     "text": "and the Clear-eyed One is the best of humans."
    },
    {
     "n": 5,
     "text": "This is the path, there is no other"
    },
    {
     "n": 6,
     "text": "for the purification of vision."
    },
    {
     "n": 7,
     "text": "You all must practice this,"
    },
    {
     "n": 8,
     "text": "it is the way to baffle Māra."
    },
    {
     "n": 9,
     "text": "When you all are practicing this,"
    },
    {
     "n": 10,
     "text": "you’ll make an end of suffering."
    },
    {
     "n": 11,
     "text": "I have explained the path to you"
    },
    {
     "n": 12,
     "text": "for extracting the thorn with wisdom."
    },
    {
     "n": 13,
     "text": "You yourselves must do the work,"
    },
    {
     "n": 14,
     "text": "the Realized Ones just show the way."
    },
    {
     "n": 15,
     "text": "Meditators practicing absorption"
    },
    {
     "n": 16,
     "text": "are released from Māra’s bonds."
    },
    {
     "n": 17,
     "text": "All conditions are impermanent—"
    },
    {
     "n": 18,
     "text": "when this is seen with wisdom,"
    },
    {
     "n": 19,
     "text": "one grows disillusioned with suffering:"
    },
    {
     "n": 20,
     "text": "this is the path to purity."
    },
    {
     "n": 21,
     "text": "All conditions are suffering—"
    },
    {
     "n": 22,
     "text": "when this is seen with wisdom,"
    },
    {
     "n": 23,
     "text": "one grows disillusioned with suffering:"
    },
    {
     "n": 24,
     "text": "this is the path to purity."
    },
    {
     "n": 25,
     "text": "All things are not-self—"
    },
    {
     "n": 26,
     "text": "when this is seen with wisdom,"
    },
    {
     "n": 27,
     "text": "one grows disillusioned with suffering:"
    },
    {
     "n": 28,
     "text": "this is the path to purity."
    },
    {
     "n": 29,
     "text": "They don’t get going when it’s time to start;"
    },
    {
     "n": 30,
     "text": "they’re young and strong, but given to sloth."
    },
    {
     "n": 31,
     "text": "Their mind depressed in sunken thought,"
    },
    {
     "n": 32,
     "text": "lazy and slothful, they can’t discern the path."
    },
    {
     "n": 33,
     "text": "Guarded in speech, restrained in mind,"
    },
    {
     "n": 34,
     "text": "doing no unskillful bodily deed."
    },
    {
     "n": 35,
     "text": "Purify these three ways of performing deeds,"
    },
    {
     "n": 36,
     "text": "and win the path known to seers."
    },
    {
     "n": 37,
     "text": "From meditation springs wisdom,"
    },
    {
     "n": 38,
     "text": "without meditation, wisdom ends."
    },
    {
     "n": 39,
     "text": "Knowing these two paths—"
    },
    {
     "n": 40,
     "text": "of progress and decline—"
    },
    {
     "n": 41,
     "text": "you should conduct yourself"
    },
    {
     "n": 42,
     "text": "so that wisdom grows."
    },
    {
     "n": 43,
     "text": "Cut down the jungle, not just a tree;"
    },
    {
     "n": 44,
     "text": "from the jungle springs fear."
    },
    {
     "n": 45,
     "text": "Having cut down jungle and snarl,"
    },
    {
     "n": 46,
     "text": "be free of jungles, mendicants!"
    },
    {
     "n": 47,
     "text": "So long as the vine, no matter how small,"
    },
    {
     "n": 48,
     "text": "that ties a man to women is not cut,"
    },
    {
     "n": 49,
     "text": "his mind remains trapped,"
    },
    {
     "n": 50,
     "text": "like a calf suckling its mother."
    },
    {
     "n": 51,
     "text": "Cut out affection for oneself,"
    },
    {
     "n": 52,
     "text": "like plucking an autumn lotus."
    },
    {
     "n": 53,
     "text": "Foster only the path to peace,"
    },
    {
     "n": 54,
     "text": "the extinguishment the Holy One taught."
    },
    {
     "n": 55,
     "text": "“Here I will stay for the rains;"
    },
    {
     "n": 56,
     "text": "here for winter, here the summer”;"
    },
    {
     "n": 57,
     "text": "thus the fool thinks,"
    },
    {
     "n": 58,
     "text": "not realizing the danger."
    },
    {
     "n": 59,
     "text": "As a mighty flood sweeps away a sleeping village,"
    },
    {
