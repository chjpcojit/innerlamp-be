{
 "id": "phap-cu-hoa",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 44-59",
 "summary": "Phẩm thuộc Kinh Pháp Cú (Tiểu Bộ, kệ 44-59), dùng hình ảnh hoa để nói về sự tu tập. Phẩm nhắc thân như bọt nước, so sánh người đắm say hái hoa với cái chết cuốn đi, và nói hương của giới đức còn thơm hơn hương hoa. Kết phẩm ví đệ tử Phật như hoa sen mọc giữa đống rác, sáng ngời nhờ trí tuệ.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Hoa",
  "pli": "Pupphavagga",
  "en": "Flowers"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 5,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp44-59/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Ai chinh phục đất này"
    },
    {
     "n": 2,
     "text": "Dạ ma, Thiên giới này?"
    },
    {
     "n": 3,
     "text": "Ai khéo giảng Pháp cú,"
    },
    {
     "n": 4,
     "text": "Như người khéo hái hoa?"
    },
    {
     "n": 5,
     "text": "Hữu học chinh phục đất,"
    },
    {
     "n": 6,
     "text": "Dạ ma, Thiên giới này."
    },
    {
     "n": 7,
     "text": "Hữu học giảng Pháp cú,"
    },
    {
     "n": 8,
     "text": "Như người khéo hái hoa."
    },
    {
     "n": 9,
     "text": "Biết thân như bọt nước,"
    },
    {
     "n": 10,
     "text": "Ngộ thân là như huyễn,"
    },
    {
     "n": 11,
     "text": "Bẻ tên hoa của Ma,"
    },
    {
     "n": 12,
     "text": "Vượt tầm mắt Thần chết."
    },
    {
     "n": 13,
     "text": "Người nhặt các loại hoa,"
    },
    {
     "n": 14,
     "text": "Ý đắm say, tham nhiễm,"
    },
    {
     "n": 15,
     "text": "Bị Thần chết mang đi,"
    },
    {
     "n": 16,
     "text": "Như lụt trôi làng ngủ."
    },
    {
     "n": 17,
     "text": "Người nhặt các loại hoa,"
    },
    {
     "n": 18,
     "text": "Ý đắm say, tham nhiễm,"
    },
    {
     "n": 19,
     "text": "Các dục chưa thỏa mãn,"
    },
    {
     "n": 20,
     "text": "Đã bị chết chinh phục."
    },
    {
     "n": 21,
     "text": "Như ong đến với hoa,"
    },
    {
     "n": 22,
     "text": "Không hại sắc và hương,"
    },
    {
     "n": 23,
     "text": "Che chở hoa, lấy nhụy."
    },
    {
     "n": 24,
     "text": "Bậc Thánh đi vào làng."
    },
    {
     "n": 25,
     "text": "Không nên nhìn lỗi người,"
    },
    {
     "n": 26,
     "text": "Người làm hay không làm."
    },
    {
     "n": 27,
     "text": "Nên nhìn tự chính mình,"
    },
    {
     "n": 28,
     "text": "Có làm hay không làm."
    },
    {
     "n": 29,
     "text": "Như bông hoa tươi đẹp,"
    },
    {
     "n": 30,
     "text": "Có sắc nhưng không hương."
    },
    {
     "n": 31,
     "text": "Cũng vậy, lời khéo nói,"
    },
    {
     "n": 32,
     "text": "Không làm, không kết quả."
    },
    {
     "n": 33,
     "text": "Như bông hoa tươi đẹp,"
    },
    {
     "n": 34,
     "text": "Có sắc lại thêm hương;"
    },
    {
     "n": 35,
     "text": "Cũng vậy, lời khéo nói,"
    },
    {
     "n": 36,
     "text": "Có làm, có kết quả."
    },
    {
     "n": 37,
     "text": "Như từ một đống hoa,"
    },
    {
     "n": 38,
     "text": "Nhiều tràng hoa được kết."
    },
    {
     "n": 39,
     "text": "Cũng vậy, thân sanh tử,"
    },
    {
     "n": 40,
     "text": "Làm được nhiều thiện sự."
    },
    {
     "n": 41,
     "text": "Hương các loại hoa thơm"
    },
    {
     "n": 42,
     "text": "Không ngược bay chiều gió"
    },
    {
     "n": 43,
     "text": "Nhưng hương người đức hạnh Ngược gió khắp tung bay"
    },
    {
     "n": 44,
     "text": "Chỉ có bậc chân nhân Toả khắp mọi phương trời."
    },
    {
     "n": 45,
     "text": "Hoa chiên đàn, già la,"
    },
    {
     "n": 46,
     "text": "Hoa sen, hoa vũ quý."
    },
    {
     "n": 47,
     "text": "Giữa những hương hoa ấy,"
    },
    {
     "n": 48,
     "text": "Giới hương là vô thượng."
    },
    {
     "n": 49,
     "text": "Ít giá trị hương này,"
    },
    {
     "n": 50,
     "text": "Hương già la, chiên đàn;"
    },
    {
     "n": 51,
     "text": "Chỉ hương người đức hạnh,"
    },
    {
     "n": 52,
     "text": "Tối thượng tỏa Thiên giới."
    },
    {
     "n": 53,
     "text": "Giữa ai có giới hạnh,"
    },
    {
     "n": 54,
     "text": "An trú không phóng dật."
    },
    {
     "n": 55,
     "text": "Chánh trí, chơn giải thoát,"
    },
    {
     "n": 56,
     "text": "Ác ma không thấy đường."
    },
    {
     "n": 57,
     "text": "Như giữa đống rác nhớp,"
    },
    {
     "n": 58,
     "text": "Quăng bỏ trên đường lớn,"
    },
    {
     "n": 59,
     "text": "Chỗ ấy hoa sen nở,"
    },
    {
     "n": 60,
     "text": "Thơm sạch, đẹp ý người."
    },
    {
     "n": 61,
     "text": "Cũng vậy giữa quần sanh,"
    },
    {
     "n": 62,
     "text": "Uế nhiễm, mù, phàm tục,"
    },
    {
     "n": 63,
     "text": "Đệ tử bậc Chánh Giác,"
    },
    {
     "n": 64,
     "text": "Sáng ngời với Tuệ Tri."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp44-59/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Ko imaṁ pathaviṁ vicessati,"
    },
    {
     "n": 2,
     "text": "Yamalokañca imaṁ sadevakaṁ;"
    },
    {
     "n": 3,
     "text": "Ko dhammapadaṁ sudesitaṁ,"
    },
    {
     "n": 4,
     "text": "Kusalo pupphamiva pacessati."
    },
    {
     "n": 5,
     "text": "Sekho pathaviṁ vicessati,"
    },
    {
     "n": 6,
     "text": "Yamalokañca imaṁ sadevakaṁ;"
    },
    {
     "n": 7,
     "text": "Sekho dhammapadaṁ sudesitaṁ,"
    },
    {
     "n": 8,
     "text": "Kusalo pupphamiva pacessati."
    },
    {
     "n": 9,
     "text": "Pheṇūpamaṁ kāyamimaṁ viditvā,"
    },
    {
     "n": 10,
     "text": "Marīcidhammaṁ abhisambudhāno;"
    },
    {
     "n": 11,
     "text": "Chetvāna mārassa papupphakāni,"
    },
    {
     "n": 12,
     "text": "Adassanaṁ maccurājassa gacche."
    },
    {
     "n": 13,
     "text": "Pupphāni heva pacinantaṁ,"
    },
    {
     "n": 14,
     "text": "byāsattamanasaṁ naraṁ;"
    },
    {
     "n": 15,
     "text": "Suttaṁ gāmaṁ mahoghova,"
    },
    {
     "n": 16,
     "text": "maccu ādāya gacchati."
    },
    {
     "n": 17,
     "text": "Pupphāni heva pacinantaṁ,"
    },
    {
     "n": 18,
     "text": "byāsattamanasaṁ naraṁ;"
    },
    {
     "n": 19,
     "text": "Atittaññeva kāmesu,"
    },
    {
     "n": 20,
     "text": "antako kurute vasaṁ."
    },
    {
     "n": 21,
     "text": "Yathāpi bhamaro pupphaṁ,"
    },
    {
     "n": 22,
     "text": "vaṇṇagandhamaheṭhayaṁ;"
    },
    {
     "n": 23,
     "text": "Paleti rasamādāya,"
    },
    {
     "n": 24,
     "text": "evaṁ gāme munī care."
    },
    {
     "n": 25,
     "text": "Na paresaṁ vilomāni,"
    },
    {
     "n": 26,
     "text": "na paresaṁ katākataṁ;"
    },
    {
     "n": 27,
     "text": "Attanova avekkheyya,"
    },
    {
     "n": 28,
     "text": "katāni akatāni ca."
    },
    {
     "n": 29,
     "text": "Yathāpi ruciraṁ pupphaṁ,"
    },
    {
     "n": 30,
     "text": "vaṇṇavantaṁ agandhakaṁ;"
    },
    {
     "n": 31,
     "text": "Evaṁ subhāsitā vācā,"
    },
    {
     "n": 32,
     "text": "aphalā hoti akubbato."
    },
    {
     "n": 33,
     "text": "Yathāpi ruciraṁ pupphaṁ,"
    },
    {
     "n": 34,
     "text": "Vaṇṇavantaṁ sagandhakaṁ;"
    },
    {
     "n": 35,
     "text": "Evaṁ subhāsitā vācā,"
    },
    {
     "n": 36,
     "text": "Saphalā hoti kubbato."
    },
    {
     "n": 37,
     "text": "Yathāpi puppharāsimhā,"
    },
    {
     "n": 38,
     "text": "kayirā mālāguṇe bahū;"
    },
    {
     "n": 39,
     "text": "Evaṁ jātena maccena,"
    },
    {
     "n": 40,
     "text": "kattabbaṁ kusalaṁ bahuṁ."
    },
    {
     "n": 41,
     "text": "Na pupphagandho paṭivātameti,"
    },
    {
     "n": 42,
     "text": "Na candanaṁ tagaramallikā vā;"
    },
    {
     "n": 43,
     "text": "Satañca gandho paṭivātameti,"
    },
    {
     "n": 44,
     "text": "Sabbā disā sappuriso pavāyati."
    },
    {
     "n": 45,
     "text": "Candanaṁ tagaraṁ vāpi,"
    },
    {
     "n": 46,
     "text": "uppalaṁ atha vassikī;"
    },
    {
     "n": 47,
     "text": "Etesaṁ gandhajātānaṁ,"
    },
    {
     "n": 48,
     "text": "sīlagandho anuttaro."
    },
    {
     "n": 49,
     "text": "Appamatto ayaṁ gandho,"
    },
    {
     "n": 50,
     "text": "yāyaṁ tagaracandanī;"
    },
    {
     "n": 51,
     "text": "Yo ca sīlavataṁ gandho,"
    },
    {
     "n": 52,
     "text": "vāti devesu uttamo."
    },
    {
     "n": 53,
     "text": "Tesaṁ sampannasīlānaṁ,"
    },
    {
     "n": 54,
     "text": "appamādavihārinaṁ;"
    },
    {
     "n": 55,
     "text": "Sammadaññāvimuttānaṁ,"
    },
    {
     "n": 56,
     "text": "māro maggaṁ na vindati."
    },
    {
     "n": 57,
     "text": "Yathā saṅkāradhānasmiṁ,"
    },
    {
     "n": 58,
     "text": "ujjhitasmiṁ mahāpathe;"
    },
    {
     "n": 59,
     "text": "Padumaṁ tattha jāyetha,"
    },
    {
     "n": 60,
     "text": "sucigandhaṁ manoramaṁ."
    },
    {
     "n": 61,
     "text": "Evaṁ saṅkārabhūtesu,"
    },
    {
     "n": 62,
     "text": "andhabhūte puthujjane;"
    },
    {
     "n": 63,
     "text": "Atirocati paññāya,"
    },
    {
     "n": 64,
     "text": "sammāsambuddhasāvako."
    }
   ]
  },
  {
   "key": "en-translation",
   "lang": "en",
   "variant": "translation",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp44-59/sujato?lang=en (translation_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (bilara-data _publication-v2.json); the translator additionally requests that use not be for AI training datasets, AI models or AI-derived technologies",
   "lines": [
    {
     "n": 1,
     "text": "Who bestirs this earth,"
    },
    {
     "n": 2,
     "text": "and the Yama realm with its gods?"
    },
    {
     "n": 3,
     "text": "Who sets out the well-taught word of truth,"
    },
    {
     "n": 4,
     "text": "as an expert a flower?"
    },
    {
     "n": 5,
     "text": "A trainee bestirs this earth,"
    },
    {
     "n": 6,
     "text": "and the Yama realm with its gods."
    },
    {
     "n": 7,
     "text": "A trainee sets out the well-taught word of truth,"
    },
    {
     "n": 8,
     "text": "as an expert a flower."
    },
    {
     "n": 9,
     "text": "Knowing this body’s like foam,"
    },
    {
     "n": 10,
     "text": "realizing it’s all just a mirage,"
    },
    {
     "n": 11,
     "text": "and cutting off Māra’s blossoming,"
    },
    {
     "n": 12,
     "text": "vanish from the King of Death."
    },
    {
     "n": 13,
     "text": "As a mighty flood sweeps off a sleeping village,"
    },
    {
     "n": 14,
     "text": "death steals away a man"
    },
    {
     "n": 15,
     "text": "even as he gathers flowers,"
    },
    {
     "n": 16,
     "text": "his mind caught up in them."
    },
    {
     "n": 17,
     "text": "The terminator gains control of the man"
    },
    {
     "n": 18,
     "text": "who has not had his fill of pleasures,"
    },
    {
     "n": 19,
     "text": "even as he gathers flowers,"
    },
    {
     "n": 20,
     "text": "his mind caught up in them."
    },
    {
     "n": 21,
     "text": "A bee takes the nectar"
    },
    {
     "n": 22,
     "text": "and moves on, doing no damage"
    },
    {
     "n": 23,
     "text": "to the flower’s beauty and fragrance;"
    },
    {
     "n": 24,
     "text": "and that’s how a sage should walk in the village."
    },
    {
     "n": 25,
     "text": "Don’t find fault with others,"
    },
    {
     "n": 26,
     "text": "with what they’ve done or left undone."
    },
    {
     "n": 27,
     "text": "You should only watch yourself,"
    },
    {
     "n": 28,
     "text": "what you’ve done or left undone."
    },
    {
     "n": 29,
     "text": "Just like a glorious flower"
    },
    {
     "n": 30,
     "text": "that’s colorful but lacks fragrance;"
    },
    {
     "n": 31,
     "text": "eloquent speech is fruitless"
    },
    {
     "n": 32,
     "text": "for one who does not act on it."
    },
    {
     "n": 33,
     "text": "Just like a glorious flower"
    },
    {
     "n": 34,
     "text": "that’s both colorful and fragrant,"
    },
    {
     "n": 35,
     "text": "eloquent speech is fruitful"
    },
    {
     "n": 36,
     "text": "for one who acts on it."
    },
    {
     "n": 37,
     "text": "Just as one would create many garlands"
    },
    {
     "n": 38,
     "text": "from a heap of flowers,"
    },
    {
     "n": 39,
     "text": "when a person has come to be born,"
    },
    {
     "n": 40,
     "text": "they should do many skillful things."
    },
    {
     "n": 41,
     "text": "The fragrance of flowers doesn’t spread upwind,"
    },
    {
     "n": 42,
     "text": "nor sandalwood, pinwheel, or jasmine;"
    },
    {
     "n": 43,
     "text": "but the fragrance of the good spreads upwind;"
    },
    {
     "n": 44,
     "text": "a true person’s virtue spreads in every direction."
    },
    {
     "n": 45,
     "text": "Among all the fragrances—"
    },
    {
     "n": 46,
     "text": "sandalwood or pinwheel"
    },
    {
     "n": 47,
     "text": "or lotus or jasmine—"
    },
    {
     "n": 48,
     "text": "the fragrance of virtue is supreme."
    },
    {
     "n": 49,
     "text": "Faint is the fragrance"
    },
    {
     "n": 50,
     "text": "of sandal or pinwheel;"
    },
    {
     "n": 51,
     "text": "but the fragrance of the virtuous"
    },
    {
     "n": 52,
     "text": "floats to the highest gods."
    },
    {
     "n": 53,
     "text": "For those accomplished in ethics,"
    },
    {
     "n": 54,
     "text": "meditating diligently,"
    },
    {
     "n": 55,
     "text": "freed through the highest knowledge,"
    },
    {
     "n": 56,
     "text": "Māra cannot find their path."
    },
    {
     "n": 57,
     "text": "From a heap of trash"
    },
    {
     "n": 58,
     "text": "discarded on the highway,"
    },
    {
     "n": 59,
     "text": "a lotus might blossom,"
    },
    {
     "n": 60,
     "text": "fragrant and delightful."
    },
    {
     "n": 61,
     "text": "So too, among those thought of as trash,"
    },
    {
     "n": 62,
     "text": "a disciple of the perfect Buddha"
    },
    {
     "n": 63,
     "text": "outshines with their wisdom"
    },
    {
     "n": 64,
     "text": "the blind ordinary folk."
    }
   ]
  }
 ]
}
