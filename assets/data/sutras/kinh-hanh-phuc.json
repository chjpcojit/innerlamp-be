{
 "id": "kinh-hanh-phuc",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Snp 2.4",
 "summary": "Bài kinh kệ thuộc Kinh Tập (Tiểu Bộ), kể rằng vào cuối đêm tại Jetavana ở Sàvatthi, một vị Thiên tử đến hỏi Đức Thế Tôn về điềm lành tối thượng. Đức Phật đáp bằng các bài kệ liệt kê những điều tốt đẹp trong đời sống như không gần kẻ ngu, gần bậc trí, hiếu dưỡng cha mẹ, sống nhu hòa, giữ tâm không sầu não. Kinh thường được tụng đọc để nhắc nhớ nếp sống thiện lành.",
 "titles": {
  "vi": "Kinh Hạnh Phúc",
  "pli": "Maṅgalasutta",
  "en": "True Blessings"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": true,
 "purposes": [
  "CAU_AN"
 ],
 "durationMinutes": 4,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "translator": "Thích Minh Châu",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/suttas/snp2.4/minh_chau?lang=vi",
   "license": "UNKNOWN",
   "licenseNote": "SuttaCentral page states only: Translated by Thích Minh Châu; prepared for SuttaCentral by editor named in footer; no license given",
   "lines": [
    {
     "n": 1,
     "text": "Như vầy tôi nghe: Một thời Thế Tôn trú tại Sàvatthi, ở Jetavana, khu vườn ông Anàthapindika."
    },
    {
     "n": 2,
     "text": "Rồi một Thiên tử, khi đêm đã gần mãn, với dung sắc thù thắng chói sáng toàn vùng Jetavana, đi đến Thế Tôn, sau khi đến đảnh lễ Thế Tôn rồi đứng một bên."
    },
    {
     "n": 3,
     "text": "Đứng một bên, vị Thiên tử ấy bạch Thế Tôn với bài kệ:"
    },
    {
     "n": 4,
     "text": "Thiên tử:"
    },
    {
     "n": 5,
     "text": "Nhiều Thiên tử và người,"
    },
    {
     "n": 6,
     "text": "Suy nghĩ đến điềm lành,"
    },
    {
     "n": 7,
     "text": "Mong ước và đợi chờ,"
    },
    {
     "n": 8,
     "text": "Một nếp sống an toàn,"
    },
    {
     "n": 9,
     "text": "Xin Ngài hãy nói lên,"
    },
    {
     "n": 10,
     "text": "Về điềm lành tối thượng."
    },
    {
     "n": 11,
     "text": "(Đức Phật giảng:)"
    },
    {
     "n": 12,
     "text": "Không thân cận kẻ ngu,"
    },
    {
     "n": 13,
     "text": "Nhưng gần gũi bậc Trí,"
    },
    {
     "n": 14,
     "text": "Đảnh lễ người đáng lễ,"
    },
    {
     "n": 15,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 16,
     "text": "Ở trú xứ thích hợp,"
    },
    {
     "n": 17,
     "text": "Công đức trước đã làm,"
    },
    {
     "n": 18,
     "text": "Chân chánh hướng tự tâm,"
    },
    {
     "n": 19,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 20,
     "text": "Học nhiều, nghề nghiệp giỏi,"
    },
    {
     "n": 21,
     "text": "Khéo huấn luyện học tập,"
    },
    {
     "n": 22,
     "text": "Nói những lời khéo nói,"
    },
    {
     "n": 23,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 24,
     "text": "Hiếu dưỡng mẹ và cha,"
    },
    {
     "n": 25,
     "text": "Nuôi nấng vợ và con."
    },
    {
     "n": 26,
     "text": "Làm nghề không rắc rối,"
    },
    {
     "n": 27,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 28,
     "text": "Bố thí, hành, đúng pháp,"
    },
    {
     "n": 29,
     "text": "Săn sóc các bà con,"
    },
    {
     "n": 30,
     "text": "Làm nghiệp không lỗi lầm,"
    },
    {
     "n": 31,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 32,
     "text": "Chấm dứt, từ bỏ ác,"
    },
    {
     "n": 33,
     "text": "Chế ngự đam mê rượu,"
    },
    {
     "n": 34,
     "text": "Trong Pháp, không phóng dật,"
    },
    {
     "n": 35,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 36,
     "text": "Kính lễ và hạ mình,"
    },
    {
     "n": 37,
     "text": "Biết đủ và biết ơn,"
    },
    {
     "n": 38,
     "text": "Đúng thời, nghe Chánh Pháp,"
    },
    {
     "n": 39,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 40,
     "text": "Nhẫn nhục, lời hòa nhã,"
    },
    {
     "n": 41,
     "text": "Yết kiến các Sa-môn,"
    },
    {
     "n": 42,
     "text": "Đúng thời, đàm luận Pháp,"
    },
    {
     "n": 43,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 44,
     "text": "Khắc khổ và Phạm hạnh,"
    },
    {
     "n": 45,
     "text": "Thấy được lý Thánh đế."
    },
    {
     "n": 46,
     "text": "Giác ngộ quả: \"Niết Bàn\""
    },
    {
     "n": 47,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 48,
     "text": "Khi xúc chạm việc đời"
    },
    {
     "n": 49,
     "text": "Tâm không động, không sầu,"
    },
    {
     "n": 50,
     "text": "Không uế nhiễm, an ổn,"
    },
    {
     "n": 51,
     "text": "Là điềm lành tối thượng."
    },
    {
     "n": 52,
     "text": "Làm sự việc như vầy,"
    },
    {
     "n": 53,
     "text": "Không chỗ nào thất bại,"
    },
    {
     "n": 54,
     "text": "Khắp nơi được an toàn,"
    },
    {
     "n": 55,
     "text": "Là điềm lành tối thượng."
    }
   ],
   "variant": "translation"
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/snp2.4/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Evaṁ me sutaṁ— ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme."
    },
    {
     "n": 2,
     "text": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṁ jetavanaṁ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhāsi."
    },
    {
     "n": 3,
     "text": "Ekamantaṁ ṭhitā kho sā devatā bhagavantaṁ gāthāya ajjhabhāsi:"
    },
    {
     "n": 4,
     "text": "“Bahū devā manussā ca,"
    },
    {
     "n": 5,
     "text": "maṅgalāni acintayuṁ;"
    },
    {
     "n": 6,
     "text": "Ākaṅkhamānā sotthānaṁ,"
    },
    {
     "n": 7,
     "text": "brūhi maṅgalamuttamaṁ”."
    },
    {
     "n": 8,
     "text": "“Asevanā ca bālānaṁ,"
    },
    {
     "n": 9,
     "text": "paṇḍitānañca sevanā;"
    },
    {
     "n": 10,
     "text": "Pūjā ca pūjaneyyānaṁ,"
    },
    {
     "n": 11,
     "text": "etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 12,
     "text": "Patirūpadesavāso ca,"
    },
    {
     "n": 13,
     "text": "pubbe ca katapuññatā;"
    },
    {
     "n": 14,
     "text": "Attasammāpaṇidhi ca,"
    },
    {
     "n": 15,
     "text": "etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 16,
     "text": "Bāhusaccañca sippañca,"
    },
    {
     "n": 17,
     "text": "vinayo ca susikkhito;"
    },
    {
     "n": 18,
     "text": "Subhāsitā ca yā vācā,"
    },
    {
     "n": 19,
     "text": "etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 20,
     "text": "Mātāpitu upaṭṭhānaṁ,"
    },
    {
     "n": 21,
     "text": "puttadārassa saṅgaho;"
    },
    {
     "n": 22,
     "text": "Anākulā ca kammantā,"
    },
    {
     "n": 23,
     "text": "etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 24,
     "text": "Dānañca dhammacariyā ca,"
    },
    {
     "n": 25,
     "text": "ñātakānañca saṅgaho;"
    },
    {
     "n": 26,
     "text": "Anavajjāni kammāni,"
    },
    {
     "n": 27,
     "text": "etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 28,
     "text": "Āratī viratī pāpā,"
    },
    {
     "n": 29,
     "text": "majjapānā ca saṁyamo;"
    },
    {
     "n": 30,
     "text": "Appamādo ca dhammesu,"
    },
    {
     "n": 31,
     "text": "etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 32,
     "text": "Gāravo ca nivāto ca,"
    },
    {
     "n": 33,
     "text": "santuṭṭhi ca kataññutā;"
    },
    {
     "n": 34,
     "text": "Kālena dhammassavanaṁ,"
    },
    {
     "n": 35,
     "text": "etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 36,
     "text": "Khantī ca sovacassatā,"
    },
    {
     "n": 37,
     "text": "samaṇānañca dassanaṁ;"
    },
    {
     "n": 38,
     "text": "Kālena dhammasākacchā,"
    },
    {
     "n": 39,
     "text": "etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 40,
     "text": "Tapo ca brahmacariyañca,"
    },
    {
     "n": 41,
     "text": "Ariyasaccāna dassanaṁ;"
    },
    {
     "n": 42,
     "text": "Nibbānasacchikiriyā ca,"
    },
    {
     "n": 43,
     "text": "Etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 44,
     "text": "Phuṭṭhassa lokadhammehi,"
    },
    {
     "n": 45,
     "text": "Cittaṁ yassa na kampati;"
    },
    {
     "n": 46,
     "text": "Asokaṁ virajaṁ khemaṁ,"
    },
    {
     "n": 47,
     "text": "Etaṁ maṅgalamuttamaṁ."
    },
    {
     "n": 48,
     "text": "Etādisāni katvāna,"
    },
    {
     "n": 49,
     "text": "Sabbattha maparājitā;"
    },
    {
     "n": 50,
     "text": "Sabbattha sotthiṁ gacchanti,"
    },
    {
     "n": 51,
     "text": "Taṁ tesaṁ maṅgalamuttaman”ti."
    },
    {
     "n": 52,
     "text": "Maṅgalasuttaṁ catutthaṁ."
    }
   ],
   "variant": "translation"
  },
  {
   "key": "en-translation",
