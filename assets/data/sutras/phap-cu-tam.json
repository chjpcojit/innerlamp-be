{
 "id": "phap-cu-tam",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 33-43",
 "summary": "Phẩm thuộc Kinh Pháp Cú (Tiểu Bộ, kệ 33-43), nói về việc điều phục tâm. Phẩm mô tả tâm là thứ dao động, khó giữ, được ví như cá bị quăng lên bờ, và khuyên người trí uốn thẳng tâm như thợ làm tên. Tâm được điều phục thì an lạc, còn tâm hướng đúng chánh có thể làm điều tốt hơn cả cha mẹ, bà con.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Tâm",
  "pli": "Cittavagga",
  "en": "The Mind"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 3,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp33-43/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Tâm hoảng hốt giao động,"
    },
    {
     "n": 2,
     "text": "Khó hộ trì, khó nhiếp,"
    },
    {
     "n": 3,
     "text": "Người trí làm tâm thẳng,"
    },
    {
     "n": 4,
     "text": "Như thợ tên, làm tên."
    },
    {
     "n": 5,
     "text": "Như cá quăng lên bờ,"
    },
    {
     "n": 6,
     "text": "Vất ra ngoài thủy giới;"
    },
    {
     "n": 7,
     "text": "Tâm này vùng vẫy mạnh,"
    },
    {
     "n": 8,
     "text": "Hãy đoạn thế lực Ma."
    },
    {
     "n": 9,
     "text": "Khó nắm giữ, khinh động,"
    },
    {
     "n": 10,
     "text": "Theo các dục quay cuồng."
    },
    {
     "n": 11,
     "text": "Lành thay, điều phục tâm;"
    },
    {
     "n": 12,
     "text": "Tâm điều, an lạc đến."
    },
    {
     "n": 13,
     "text": "Tâm khó thấy, tế nhị,"
    },
    {
     "n": 14,
     "text": "Theo các dục quay cuồng."
    },
    {
     "n": 15,
     "text": "Người trí phòng hộ tâm,"
    },
    {
     "n": 16,
     "text": "Tâm hộ, an lạc đến."
    },
    {
     "n": 17,
     "text": "Chạy xa, sống một mình,"
    },
    {
     "n": 18,
     "text": "Không thân, ẩn hang sâu,"
    },
    {
     "n": 19,
     "text": "Ai điều phục được tâm,"
    },
    {
     "n": 20,
     "text": "Thoát khỏi Ma trói buộc."
    },
    {
     "n": 21,
     "text": "Ai tâm không an trú,"
    },
    {
     "n": 22,
     "text": "Không biết chân diệu pháp,"
    },
    {
     "n": 23,
     "text": "Tịnh tín bị rúng động,"
    },
    {
     "n": 24,
     "text": "Trí tuệ không viên thành."
    },
    {
     "n": 25,
     "text": "Tâm không đầy tràn dục,"
    },
    {
     "n": 26,
     "text": "Tâm không (hận) công phá,"
    },
    {
     "n": 27,
     "text": "Đoạn tuyệt mọi thiện ác,"
    },
    {
     "n": 28,
     "text": "Kẻ tỉnh không sợ hãi."
    },
    {
     "n": 29,
     "text": "Biết thân như đồ gốm,"
    },
    {
     "n": 30,
     "text": "Trú tâm như thành trì,"
    },
    {
     "n": 31,
     "text": "Chống Ma với gươm trí;"
    },
    {
     "n": 32,
     "text": "Giữ chiến thắng không tham"
    },
    {
     "n": 33,
     "text": "Không bao lâu thân này,"
    },
    {
     "n": 34,
     "text": "Sẽ nằm dài trên đất,"
    },
    {
     "n": 35,
     "text": "Bị vất bỏ, vô thức,"
    },
    {
     "n": 36,
     "text": "Như khúc cây vô dụng."
    },
    {
     "n": 37,
     "text": "Kẻ thù hại kẻ thù,"
    },
    {
     "n": 38,
     "text": "Oan gia hại oan gia,"
    },
    {
     "n": 39,
     "text": "Không bằng tâm hướng tà,"
    },
    {
     "n": 40,
     "text": "Gây ác cho tự thân."
    },
    {
     "n": 41,
     "text": "Điều mẹ cha bà con,"
    },
    {
     "n": 42,
     "text": "Không có thể làm được,"
    },
    {
     "n": 43,
     "text": "Tâm hướng chánh làm được"
    },
    {
     "n": 44,
     "text": "Làm được tốt đẹp hơn."
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp33-43/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Phandanaṁ capalaṁ cittaṁ,"
    },
    {
     "n": 2,
     "text": "dūrakkhaṁ dunnivārayaṁ;"
    },
    {
     "n": 3,
     "text": "Ujuṁ karoti medhāvī,"
    },
    {
     "n": 4,
     "text": "usukārova tejanaṁ."
    },
    {
     "n": 5,
     "text": "Vārijova thale khitto,"
    },
    {
     "n": 6,
     "text": "okamokataubbhato;"
    },
    {
     "n": 7,
     "text": "Pariphandatidaṁ cittaṁ,"
    },
    {
     "n": 8,
     "text": "māradheyyaṁ pahātave."
    },
    {
     "n": 9,
     "text": "Dunniggahassa lahuno,"
    },
    {
     "n": 10,
     "text": "yatthakāmanipātino;"
    },
    {
     "n": 11,
     "text": "Cittassa damatho sādhu,"
    },
    {
     "n": 12,
     "text": "cittaṁ dantaṁ sukhāvahaṁ."
    },
    {
     "n": 13,
     "text": "Sududdasaṁ sunipuṇaṁ,"
    },
    {
     "n": 14,
     "text": "yatthakāmanipātinaṁ;"
    },
    {
     "n": 15,
     "text": "Cittaṁ rakkhetha medhāvī,"
    },
    {
     "n": 16,
     "text": "cittaṁ guttaṁ sukhāvahaṁ."
    },
    {
     "n": 17,
     "text": "Dūraṅgamaṁ ekacaraṁ,"
    },
    {
     "n": 18,
     "text": "asarīraṁ guhāsayaṁ;"
    },
    {
     "n": 19,
     "text": "Ye cittaṁ saṁyamissanti,"
    },
    {
     "n": 20,
     "text": "mokkhanti mārabandhanā."
    },
    {
     "n": 21,
     "text": "Anavaṭṭhitacittassa,"
    },
    {
     "n": 22,
     "text": "saddhammaṁ avijānato;"
    },
    {
     "n": 23,
     "text": "Pariplavapasādassa,"
    },
    {
     "n": 24,
     "text": "paññā na paripūrati."
    },
    {
     "n": 25,
     "text": "Anavassutacittassa,"
    },
    {
     "n": 26,
     "text": "ananvāhatacetaso;"
    },
    {
     "n": 27,
     "text": "Puññapāpapahīnassa,"
    },
    {
     "n": 28,
     "text": "natthi jāgarato bhayaṁ."
    },
    {
     "n": 29,
     "text": "Kumbhūpamaṁ kāyamimaṁ viditvā,"
    },
    {
     "n": 30,
     "text": "Nagarūpamaṁ cittamidaṁ ṭhapetvā;"
    },
    {
     "n": 31,
     "text": "Yodhetha māraṁ paññāvudhena,"
    },
    {
     "n": 32,
     "text": "Jitañca rakkhe anivesano siyā."
    },
    {
     "n": 33,
     "text": "Aciraṁ vatayaṁ kāyo,"
    },
    {
     "n": 34,
     "text": "pathaviṁ adhisessati;"
    },
    {
     "n": 35,
     "text": "Chuddho apetaviññāṇo,"
    },
    {
     "n": 36,
     "text": "niratthaṁva kaliṅgaraṁ."
    },
    {
     "n": 37,
     "text": "Diso disaṁ yaṁ taṁ kayirā,"
    },
    {
     "n": 38,
     "text": "verī vā pana verinaṁ;"
    },
    {
     "n": 39,
     "text": "Micchāpaṇihitaṁ cittaṁ,"
    },
    {
     "n": 40,
     "text": "pāpiyo naṁ tato kare."
    },
    {
     "n": 41,
     "text": "Na taṁ mātā pitā kayirā,"
    },
    {
     "n": 42,
     "text": "aññe vāpi ca ñātakā;"
    },
    {
     "n": 43,
     "text": "Sammāpaṇihitaṁ cittaṁ,"
    },
    {
     "n": 44,
     "text": "seyyaso naṁ tato kare."
    }
   ]
  },
  {
   "key": "en-translation",
   "lang": "en",
   "variant": "translation",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp33-43/sujato?lang=en (translation_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (bilara-data _publication-v2.json); the translator additionally requests that use not be for AI training datasets, AI models or AI-derived technologies",
   "lines": [
    {
     "n": 1,
     "text": "The mind quivers and quakes,"
    },
    {
     "n": 2,
     "text": "hard to guard, hard to curb."
    },
    {
     "n": 3,
     "text": "The discerning straighten it out,"
    },
    {
     "n": 4,
     "text": "like a fletcher an arrow."
    },
    {
     "n": 5,
     "text": "Like a fish pulled from the sea"
    },
    {
     "n": 6,
     "text": "and cast upon the shore,"
    },
    {
     "n": 7,
     "text": "this mind flounders about,"
    },
    {
     "n": 8,
     "text": "trying to throw off Māra’s dominion."
    },
    {
     "n": 9,
     "text": "Hard to hold back, flighty,"
    },
    {
     "n": 10,
     "text": "alighting where it will;"
    },
    {
     "n": 11,
     "text": "it’s good to tame the mind;"
    },
    {
     "n": 12,
     "text": "a tamed mind leads to bliss."
    },
    {
     "n": 13,
     "text": "So hard to see, so subtle,"
    },
    {
     "n": 14,
     "text": "alighting where it will;"
    },
    {
     "n": 15,
     "text": "the discerning protect the mind,"
    },
    {
     "n": 16,
     "text": "a guarded mind leads to bliss."
    },
    {
     "n": 17,
     "text": "The mind travels far, wandering alone;"
    },
    {
     "n": 18,
     "text": "incorporeal, it lies hidden in the heart."
    },
    {
     "n": 19,
     "text": "Those who will restrain the mind"
    },
    {
     "n": 20,
     "text": "are freed from Māra’s bonds."
    },
    {
     "n": 21,
     "text": "Those of unsteady mind,"
    },
    {
     "n": 22,
     "text": "who don’t understand the true teaching,"
    },
    {
     "n": 23,
     "text": "and whose confidence wavers,"
    },
    {
     "n": 24,
     "text": "do not perfect their wisdom."
    },
    {
     "n": 25,
     "text": "One whose mind is not festering,"
    },
    {
     "n": 26,
     "text": "whose heart is undamaged,"
    },
    {
     "n": 27,
     "text": "who’s given up right and wrong,"
    },
    {
     "n": 28,
     "text": "alert, has nothing to fear."
    },
    {
     "n": 29,
     "text": "Knowing this body breaks like a pot,"
    },
    {
     "n": 30,
     "text": "and fortifying the mind like a citadel,"
    },
    {
     "n": 31,
     "text": "attack Māra with the sword of wisdom,"
    },
    {
     "n": 32,
     "text": "guard your conquest, and never settle."
    },
    {
     "n": 33,
     "text": "All too soon this body"
    },
    {
     "n": 34,
     "text": "will lie upon the earth,"
    },
    {
     "n": 35,
     "text": "bereft of consciousness,"
    },
    {
     "n": 36,
     "text": "tossed aside like a worthless log."
    },
    {
     "n": 37,
     "text": "A wrongly directed mind"
    },
    {
     "n": 38,
     "text": "would do you more harm"
    },
    {
     "n": 39,
     "text": "than a hater to the hated,"
    },
    {
     "n": 40,
     "text": "or an enemy to their foe."
    },
    {
     "n": 41,
     "text": "A rightly directed mind"
    },
    {
     "n": 42,
     "text": "would do you more good"
    },
    {
     "n": 43,
     "text": "than your mother or father"
    },
    {
     "n": 44,
     "text": "or any other relative."
    }
   ]
  }
 ]
}
