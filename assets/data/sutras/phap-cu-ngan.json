  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp100-115/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Sahassamapi ce vācā,"
    },
    {
     "n": 2,
     "text": "anatthapadasaṁhitā;"
    },
    {
     "n": 3,
     "text": "Ekaṁ atthapadaṁ seyyo,"
    },
    {
     "n": 4,
     "text": "yaṁ sutvā upasammati."
    },
    {
     "n": 5,
     "text": "Sahassamapi ce gāthā,"
    },
    {
     "n": 6,
     "text": "anatthapadasaṁhitā;"
    },
    {
     "n": 7,
     "text": "Ekaṁ gāthāpadaṁ seyyo,"
    },
    {
     "n": 8,
     "text": "yaṁ sutvā upasammati."
    },
    {
     "n": 9,
     "text": "Yo ca gāthā sataṁ bhāse,"
    },
    {
     "n": 10,
     "text": "anatthapadasaṁhitā;"
    },
    {
     "n": 11,
     "text": "Ekaṁ dhammapadaṁ seyyo,"
    },
    {
     "n": 12,
     "text": "yaṁ sutvā upasammati."
    },
    {
     "n": 13,
     "text": "Yo sahassaṁ sahassena,"
    },
    {
     "n": 14,
     "text": "saṅgāme mānuse jine;"
    },
    {
     "n": 15,
     "text": "Ekañca jeyyamattānaṁ,"
    },
    {
     "n": 16,
     "text": "sa ve saṅgāmajuttamo."
    },
    {
     "n": 17,
     "text": "Attā have jitaṁ seyyo,"
    },
    {
     "n": 18,
     "text": "yā cāyaṁ itarā pajā;"
    },
    {
     "n": 19,
     "text": "Attadantassa posassa,"
    },
    {
     "n": 20,
     "text": "niccaṁ saññatacārino."
    },
    {
     "n": 21,
     "text": "Neva devo na gandhabbo,"
    },
    {
     "n": 22,
     "text": "na māro saha brahmunā;"
    },
    {
     "n": 23,
     "text": "Jitaṁ apajitaṁ kayirā,"
    },
    {
     "n": 24,
     "text": "tathārūpassa jantuno."
    },
    {
     "n": 25,
     "text": "Māse māse sahassena,"
    },
    {
     "n": 26,
     "text": "yo yajetha sataṁ samaṁ;"
    },
    {
     "n": 27,
     "text": "Ekañca bhāvitattānaṁ,"
    },
    {
     "n": 28,
     "text": "muhuttamapi pūjaye;"
    },
    {
     "n": 29,
     "text": "Sāyeva pūjanā seyyo,"
    },
    {
     "n": 30,
     "text": "yañce vassasataṁ hutaṁ."
    },
    {
     "n": 31,
     "text": "Yo ca vassasataṁ jantu,"
    },
    {
     "n": 32,
     "text": "aggiṁ paricare vane;"
    },
    {
     "n": 33,
     "text": "Ekañca bhāvitattānaṁ,"
    },
    {
     "n": 34,
     "text": "muhuttamapi pūjaye;"
    },
    {
     "n": 35,
     "text": "Sāyeva pūjanā seyyo,"
    },
    {
     "n": 36,
     "text": "yañce vassasataṁ hutaṁ."
    },
    {
     "n": 37,
     "text": "Yaṁ kiñci yiṭṭhaṁ va hutaṁ va loke,"
    },
    {
     "n": 38,
     "text": "Saṁvaccharaṁ yajetha puññapekkho;"
    },
    {
     "n": 39,
     "text": "Sabbampi taṁ na catubhāgameti,"
    },
    {
     "n": 40,
     "text": "Abhivādanā ujjugatesu seyyo."
    },
    {
     "n": 41,
     "text": "Abhivādanasīlissa,"
    },
    {
     "n": 42,
     "text": "niccaṁ vuḍḍhāpacāyino;"
    },
    {
     "n": 43,
     "text": "Cattāro dhammā vaḍḍhanti,"
    },
    {
     "n": 44,
     "text": "āyu vaṇṇo sukhaṁ balaṁ."
    },
    {
     "n": 45,
     "text": "Yo ca vassasataṁ jīve,"
    },
    {
     "n": 46,
     "text": "dussīlo asamāhito;"
    },
    {
     "n": 47,
     "text": "Ekāhaṁ jīvitaṁ seyyo,"
    },
    {
     "n": 48,
     "text": "sīlavantassa jhāyino."
    },
    {
     "n": 49,
     "text": "Yo ca vassasataṁ jīve,"
    },
    {
     "n": 50,
     "text": "duppañño asamāhito;"
    },
    {
     "n": 51,
     "text": "Ekāhaṁ jīvitaṁ seyyo,"
    },
    {
     "n": 52,
     "text": "paññavantassa jhāyino."
    },
    {
     "n": 53,
     "text": "Yo ca vassasataṁ jīve,"
    },
    {
     "n": 54,
     "text": "kusīto hīnavīriyo;"
    },
    {
     "n": 55,
     "text": "Ekāhaṁ jīvitaṁ seyyo,"
    },
    {
     "n": 56,
     "text": "vīriyamārabhato daḷhaṁ."
    },
    {
     "n": 57,
     "text": "Yo ca vassasataṁ jīve,"
    },
    {
     "n": 58,
     "text": "apassaṁ udayabbayaṁ;"
    },
    {
     "n": 59,
     "text": "Ekāhaṁ jīvitaṁ seyyo,"
    },
    {
     "n": 60,
     "text": "passato udayabbayaṁ."
    },
    {
     "n": 61,
     "text": "Yo ca vassasataṁ jīve,"
    },
    {
     "n": 62,
     "text": "apassaṁ amataṁ padaṁ;"
    },
    {
     "n": 63,
     "text": "Ekāhaṁ jīvitaṁ seyyo,"
    },
    {
     "n": 64,
     "text": "passato amataṁ padaṁ."
    },
    {
     "n": 65,
     "text": "Yo ca vassasataṁ jīve,"
    },
    {
     "n": 66,
     "text": "apassaṁ dhammamuttamaṁ;"
    },
    {
     "n": 67,
     "text": "Ekāhaṁ jīvitaṁ seyyo,"
    },
    {
     "n": 68,
     "text": "passato dhammamuttamaṁ."
    }
   ]
