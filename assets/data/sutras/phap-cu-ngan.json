   "lines": [
    {
     "n": 1,
     "text": "Better than a thousand"
    },
    {
     "n": 2,
     "text": "meaningless sayings"
    },
    {
     "n": 3,
     "text": "is a single meaningful saying,"
    },
    {
     "n": 4,
     "text": "hearing which brings you peace."
    },
    {
     "n": 5,
     "text": "Better than a thousand"
    },
    {
     "n": 6,
     "text": "meaningless verses"
    },
    {
     "n": 7,
     "text": "is a single meaningful verse,"
    },
    {
     "n": 8,
     "text": "hearing which brings you peace."
    },
    {
     "n": 9,
     "text": "Better than reciting"
    },
    {
     "n": 10,
     "text": "a hundred meaningless verses"
    },
    {
     "n": 11,
     "text": "is a single saying of Dhamma,"
    },
    {
     "n": 12,
     "text": "hearing which brings you peace."
    },
    {
     "n": 13,
     "text": "The supreme conqueror is"
    },
    {
     "n": 14,
     "text": "not he who conquers a million men in battle,"
    },
    {
     "n": 15,
     "text": "but he who conquers a single man:"
    },
    {
     "n": 16,
     "text": "himself."
    },
    {
     "n": 17,
     "text": "It is surely better to conquer oneself"
    },
    {
     "n": 18,
     "text": "than all those other folk."
    },
    {
     "n": 19,
     "text": "When a person has tamed themselves,"
    },
    {
     "n": 20,
     "text": "always living restrained,"
    },
    {
     "n": 21,
     "text": "no god nor centaur,"
    },
    {
     "n": 22,
     "text": "nor Māra nor divinity,"
    },
    {
     "n": 23,
     "text": "can undo the victory"
    },
    {
     "n": 24,
     "text": "of such a personage."
    },
    {
     "n": 25,
     "text": "Rather than a thousandfold sacrifice,"
    },
    {
     "n": 26,
     "text": "every month for a full century,"
    },
    {
     "n": 27,
     "text": "it’s better to honor for a single hour"
    },
    {
     "n": 28,
     "text": "one who has developed themselves."
    },
    {
     "n": 29,
     "text": "That offering is better"
    },
    {
     "n": 30,
     "text": "than the hundred year sacrifice."
    },
    {
     "n": 31,
     "text": "Rather than serve the sacred flame"
    },
    {
     "n": 32,
     "text": "in the forest for a hundred years,"
    },
    {
     "n": 33,
     "text": "it’s better to honor for a single hour"
    },
    {
     "n": 34,
     "text": "a personage who has developed themselves."
    },
    {
     "n": 35,
     "text": "That offering is better"
    },
    {
     "n": 36,
     "text": "than the hundred year sacrifice."
    },
    {
     "n": 37,
     "text": "Whatever sacrifice or offering in the world"
    },
    {
     "n": 38,
     "text": "a seeker of merit may make for a year,"
    },
    {
     "n": 39,
     "text": "none of it is worth a quarter"
    },
    {
     "n": 40,
     "text": "of bowing to the sincere."
    },
    {
     "n": 41,
     "text": "For one in the habit of bowing,"
    },
    {
     "n": 42,
     "text": "always honoring the elders,"
    },
    {
     "n": 43,
     "text": "four blessings grow:"
    },
    {
     "n": 44,
     "text": "lifespan, beauty, happiness, and strength."
    },
    {
     "n": 45,
     "text": "Better to live a single day"
    },
    {
     "n": 46,
     "text": "ethical and absorbed in meditation"
    },
    {
     "n": 47,
     "text": "than to live a hundred years"
    },
    {
     "n": 48,
     "text": "unethical and lacking immersion."
    },
    {
     "n": 49,
     "text": "Better to live a single day"
    },
    {
     "n": 50,
     "text": "wise and absorbed in meditation"
    },
    {
     "n": 51,
     "text": "than to live a hundred years"
    },
    {
     "n": 52,
     "text": "witless and lacking immersion."
    },
    {
     "n": 53,
     "text": "Better to live a single day"
    },
    {
     "n": 54,
     "text": "energetic and strong,"
    },
    {
     "n": 55,
     "text": "than to live a hundred years"
    },
    {
     "n": 56,
     "text": "lazy and lacking energy."
    },
    {
     "n": 57,
     "text": "Better to live a single day"
    },
    {
     "n": 58,
     "text": "seeing rise and fall"
    },
    {
     "n": 59,
     "text": "than to live a hundred years"
    },
    {
     "n": 60,
     "text": "blind to rise and fall."
    },
    {
     "n": 61,
     "text": "Better to live a single day"
    },
    {
     "n": 62,
     "text": "seeing the state free of death"
    },
    {
     "n": 63,
     "text": "than to live a hundred years"
    },
    {
     "n": 64,
     "text": "blind to the state free of death."
    },
    {
     "n": 65,
     "text": "Better to live a single day"
    },
    {
     "n": 66,
     "text": "seeing the supreme teaching"
    },
