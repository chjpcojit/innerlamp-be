   "lines": [
    {
     "n": 1,
     "text": "Dầu nói ngàn ngàn lời,"
    },
    {
     "n": 2,
     "text": "Nhưng không gì lợi ích,"
    },
    {
     "n": 3,
     "text": "Tốt hơn một câu nghĩa,"
    },
    {
     "n": 4,
     "text": "Nghe xong, được tịnh lạc."
    },
    {
     "n": 5,
     "text": "Dầu nói ngàn câu kệ"
    },
    {
     "n": 6,
     "text": "Nhưng không gì lợi ích,"
    },
    {
     "n": 7,
     "text": "Tốt hơn nói một câu,"
    },
    {
     "n": 8,
     "text": "Nghe xong, được tịnh lạc."
    },
    {
     "n": 9,
     "text": "Dầu nói trăm câu kệ"
    },
    {
     "n": 10,
     "text": "Nhưng không gì lợi ích"
    },
    {
     "n": 11,
     "text": "Tốt hơn một câu Pháp,"
    },
    {
     "n": 12,
     "text": "Nghe xong, được tịnh lạc."
    },
    {
     "n": 13,
     "text": "Dầu tại bãi chiến trường"
    },
    {
     "n": 14,
     "text": "Thắng ngàn ngàn quân địch,"
    },
    {
     "n": 15,
     "text": "Tự thắng mình tốt hơn,"
    },
    {
     "n": 16,
     "text": "Thật chiến thắng tối thượng."
    },
    {
     "n": 17,
     "text": "Tự thắng , tốt đẹp hơn,"
    },
    {
     "n": 18,
     "text": "Hơn chiến thắng người khác."
    },
    {
     "n": 19,
     "text": "Người khéo điều phục mình,"
    },
    {
     "n": 20,
     "text": "Thường sống tự chế ngự."
    },
    {
     "n": 21,
     "text": "Dầu Thiên Thần, Thát-bà,"
    },
    {
     "n": 22,
     "text": "Dầu Ma Vương, Phạm Thiên"
    },
    {
     "n": 23,
     "text": "Không ai chiến thắng nổi,"
    },
    {
     "n": 24,
     "text": "Người tự thắng như vậy."
    },
    {
     "n": 25,
     "text": "Tháng tháng bỏ ngàn vàng,"
    },
    {
     "n": 26,
     "text": "Tế tự cả trăm năm,"
    },
    {
     "n": 27,
     "text": "Chẳng bằng trong giây lát,"
    },
    {
     "n": 28,
     "text": "Cúng dường bậc tự tu."
    },
    {
     "n": 29,
     "text": "Cúng dường vậy tốt hơn,"
    },
    {
     "n": 30,
     "text": "Hơn trăm năm tế tự."
    },
    {
     "n": 31,
     "text": "Dầu trải một trăm năm,"
    },
    {
     "n": 32,
     "text": "Thờ lửa tại rừng sâu,"
    },
    {
     "n": 33,
     "text": "Chẳng bằng trong giây lát,"
    },
    {
     "n": 34,
     "text": "Cúng dường bậc tự tu."
    },
    {
     "n": 35,
     "text": "Cúng dường vậy tốt hơn,"
    },
    {
     "n": 36,
     "text": "Hơn trăm năm tế tự."
    },
    {
     "n": 37,
     "text": "Suốt năm cúng tế vật,"
    },
    {
     "n": 38,
     "text": "Để cầu phước ở đời."
    },
    {
     "n": 39,
     "text": "Không bằng một phần tư"
    },
    {
     "n": 40,
     "text": "Kính lễ bậc chánh trực."
    },
    {
     "n": 41,
     "text": "Thường tôn trọng, kính lễ"
    },
    {
     "n": 42,
     "text": "Bậc kỳ lão trưởng thượng,"
    },
    {
     "n": 43,
     "text": "Bốn pháp được tăng trưởng:"
    },
    {
     "n": 44,
     "text": "Thọ, sắc, lạc, sức mạnh."
    },
    {
     "n": 45,
     "text": "Dầu sống một trăm năm,"
    },
    {
     "n": 46,
     "text": "Ác giới, không thiền định,"
    },
    {
     "n": 47,
     "text": "Tốt hơn sống một ngày,"
    },
    {
     "n": 48,
     "text": "Trì giới, tu thiền định."
    },
    {
     "n": 49,
     "text": "Ai sống một trăm năm,"
    },
    {
     "n": 50,
     "text": "Ác tuệ, không thiền định."
    },
    {
     "n": 51,
     "text": "Tốt hơn sống một ngày,"
    },
    {
     "n": 52,
     "text": "Có tuệ, tu thiền định."
    },
    {
     "n": 53,
     "text": "Ai sống một trăm năm,"
    },
    {
     "n": 54,
     "text": "Lười nhác không tin tấn,"
    },
    {
     "n": 55,
     "text": "Tốt hơn sống một ngày"
    },
    {
     "n": 56,
     "text": "Tinh tấn tận sức mình."
    },
    {
     "n": 57,
     "text": "Ai sống một trăm năm,"
    },
    {
     "n": 58,
     "text": "Không thấy pháp sinh diệt,"
    },
    {
     "n": 59,
     "text": "Tốt hơn sống một ngày,"
    },
    {
     "n": 60,
     "text": "Thấy được pháp sinh diệt."
    },
    {
     "n": 61,
     "text": "Ai sống một trăm năm,"
    },
    {
     "n": 62,
     "text": "Không thấy câu bất tử,"
    },
    {
     "n": 63,
     "text": "Tốt hơn sống một ngày,"
    },
    {
     "n": 64,
     "text": "Thấy được câu bất tử."
    },
    {
     "n": 65,
     "text": "Ai sống một trăm năm,"
    },
    {
     "n": 66,
     "text": "Không thấy Pháp Tối thượng,"
    },
    {
     "n": 67,
     "text": "Tốt hơn sống một ngày,"
    },
    {
     "n": 68,
     "text": "Thấy được Pháp Tối thượng."
    }
   ]
