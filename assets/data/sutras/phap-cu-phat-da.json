{
 "id": "phap-cu-phat-da",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 179-196",
 "summary": "Phẩm thuộc Kinh Pháp Cú (Tiểu Bộ, kệ 179-196), ca ngợi Đức Phật như bậc chiến thắng không bại, đã giải tỏa lưới tham ái, phạm vi trí tuệ rộng mênh mông. Phẩm nhắc việc được làm người, được nghe chánh pháp, có Phật ra đời là hiếm có, nêu giáo huấn chung của chư Phật và khuyên nương tựa Tam Bảo, Tứ Thánh Đế.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Phật-đà",
  "pli": "Buddhavagga",
  "en": "The Buddhas"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SUBJECT"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 5,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp179-196/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Vị chiến thắng không bại,"
    },
    {
     "n": 2,
     "text": "Vị bước đi trên đời, Không dấu tích chiến thắng,"
    },
    {
     "n": 3,
     "text": "Phật giới rộng mênh mông,"
    },
    {
     "n": 4,
     "text": "Ai dùng chân theo dõi Bậc không để dấu tích?"
    },
    {
     "n": 5,
     "text": "Ai giải tỏa lưới tham,"
    },
    {
     "n": 6,
     "text": "Ái phược hết dắt dẫn,"
    },
    {
     "n": 7,
     "text": "Phật giới rộng mênh mông,"
    },
    {
     "n": 8,
     "text": "Ai dùng chân theo dõi Bậc không để dấu tích?"
    },
    {
     "n": 9,
     "text": "Người trí chuyên thiền định,"
    },
    {
     "n": 10,
     "text": "Thích an tịnh viễn ly,"
    },
    {
     "n": 11,
     "text": "Chư thiên đều ái kính,"
    },
    {
     "n": 12,
     "text": "Bậc chánh giác, chánh niệm."
    },
    {
     "n": 13,
     "text": "Khó thay, được làm người,"
    },
    {
     "n": 14,
     "text": "Khó thay, được sống còn,"
    },
    {
     "n": 15,
     "text": "Khó thay, nghe Diệu Pháp,"
    },
    {
     "n": 16,
     "text": "Khó thay, Phật ra đời!"
    },
    {
     "n": 17,
     "text": "Không làm mọi điều ác."
    },
    {
     "n": 18,
     "text": "Thành tựu các hạnh lành,"
    },
    {
     "n": 19,
     "text": "Tâm ý giữ trong sạch,"
    },
    {
     "n": 20,
     "text": "Chính lời chư Phật dạy."
    },
    {
     "n": 21,
     "text": "Chư Phật thường giảng dạy; Nhẫn, khổ hạnh tối thượng;"
    },
    {
     "n": 22,
     "text": "Niết-bàn quả tối thượng;"
    },
    {
     "n": 23,
     "text": "Xuất gia không phá người;"
    },
    {
     "n": 24,
     "text": "Sa môn không hại người."
    },
    {
     "n": 25,
     "text": "Không phỉ báng, phá hoại,"
    },
    {
     "n": 26,
     "text": "Hộ trì giới căn bản,"
    },
    {
     "n": 27,
     "text": "Ăn uống có tiết độ,"
    },
    {
     "n": 28,
     "text": "Sàng tọa chỗ nhàn tịnh"
    },
    {
     "n": 29,
     "text": "Chuyên chú tăng thượng tâm,"
    },
    {
     "n": 30,
     "text": "Chính lời chư Phật dạy."
    },
    {
     "n": 31,
     "text": "Dầu mưa bằng tiền vàng,"
    },
    {
     "n": 32,
     "text": "Các dục khó thỏa mãn."
    },
    {
     "n": 33,
     "text": "Dục đắng nhiều ngọt ít,"
    },
    {
     "n": 34,
     "text": "Biết vậy là bậc trí."
    },
    {
     "n": 35,
     "text": "Đệ tử bậc chánh giác,"
    },
    {
     "n": 36,
     "text": "Không tìm cầu dục lạc,"
    },
    {
     "n": 37,
     "text": "Dầu là dục chư thiên,"
    },
    {
     "n": 38,
     "text": "Chỉ ưa thích ái diệt."
    },
    {
     "n": 39,
     "text": "Loài người sợ hoảng hốt,"
    },
    {
     "n": 40,
     "text": "Tìm nhiều chỗ quy y,"
    },
    {
     "n": 41,
     "text": "Hoặc rừng rậm, núi non,"
    },
    {
     "n": 42,
     "text": "Hoặc vườn cây, đền tháp."
    },
    {
     "n": 43,
     "text": "Quy y ấy không ổn,"
    },
    {
     "n": 44,
     "text": "Không quy y tối thượng."
    },
    {
     "n": 45,
     "text": "Quy y các chỗ ấy,"
    },
    {
     "n": 46,
     "text": "Không thoát mọi khổ đau?"
    },
    {
     "n": 47,
     "text": "Ai quy y Đức Phật,"
    },
    {
     "n": 48,
     "text": "Chánh Pháp và chư Tăng,"
    },
    {
     "n": 49,
     "text": "Ai dùng chánh tri kiến,"
    },
    {
     "n": 50,
     "text": "Thấy được bốn Thánh đế."
    },
    {
     "n": 51,
     "text": "Thấy khổ và khổ tập,"
    },
    {
     "n": 52,
     "text": "Thấy sự khổ vượt qua,"
    },
    {
     "n": 53,
     "text": "Thấy đường Thánh tám ngành,"
    },
    {
     "n": 54,
     "text": "Đưa đến khổ não tận."
    },
    {
     "n": 55,
     "text": "Thật quy y an ổn,"
    },
    {
     "n": 56,
     "text": "Thật quy y tối thượng,"
    },
    {
     "n": 57,
     "text": "Có quy y như vậy,"
    },
    {
     "n": 58,
     "text": "Mới thoát mọi khổ đau."
    },
    {
     "n": 59,
     "text": "Khó gặp bậc thánh nhân,"
    },
    {
     "n": 60,
     "text": "Không phải đâu cũng có."
    },
    {
     "n": 61,
     "text": "Chỗ nào bậc trí sanh,"
    },
    {
     "n": 62,
     "text": "Gia đình tất an lạc."
    },
    {
     "n": 63,
     "text": "Vui thay, Phật ra đời!"
    },
    {
     "n": 64,
     "text": "Vui thay, Pháp được giảng!"
    },
    {
     "n": 65,
     "text": "Vui thay, Tăng hòa hợp!"
    },
    {
     "n": 66,
     "text": "Hòa hợp tu, vui thay!"
    },
    {
     "n": 67,
     "text": "Cúng dường bậc đáng cúng,"
    },
    {
     "n": 68,
     "text": "Chư Phật hoặc đệ tử,"
    },
    {
     "n": 69,
     "text": "Các bậc vượt hý luận,"
    },
    {
     "n": 70,
     "text": "Đoạn diệt mọi sầu bi."
    },
    {
     "n": 71,
     "text": "Cúng dường bậc như vậy,"
    },
    {
     "n": 72,
     "text": "Tịch tịnh, không sợ hãi,"
    },
    {
     "n": 73,
     "text": "Các công đức như vậy,"
    },
    {
     "n": 74,
     "text": "Không ai ước lường được."
    },
    {
     "n": 75,
     "text": "Hết phẩm"
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp179-196/sujato?lang=en (root_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub38, Mahāsaṅgīti Tipiṭaka Buddhavasse 2500, The M.L. Maniratana Bunnag Dhamma Society Fund, 2005)",
   "lines": [
    {
     "n": 1,
     "text": "Yassa jitaṁ nāvajīyati,"
    },
    {
     "n": 2,
     "text": "Jitaṁ yassa noyāti koci loke;"
    },
    {
     "n": 3,
     "text": "Taṁ buddhamanantagocaraṁ,"
    },
    {
     "n": 4,
     "text": "Apadaṁ kena padena nessatha."
    },
    {
     "n": 5,
     "text": "Yassa jālinī visattikā,"
    },
    {
     "n": 6,
     "text": "Taṇhā natthi kuhiñci netave;"
    },
    {
     "n": 7,
     "text": "Taṁ buddhamanantagocaraṁ,"
    },
    {
     "n": 8,
     "text": "Apadaṁ kena padena nessatha."
    },
    {
     "n": 9,
     "text": "Ye jhānapasutā dhīrā,"
    },
    {
     "n": 10,
     "text": "nekkhammūpasame ratā;"
    },
    {
     "n": 11,
     "text": "Devāpi tesaṁ pihayanti,"
    },
    {
     "n": 12,
     "text": "sambuddhānaṁ satīmataṁ."
    },
    {
     "n": 13,
     "text": "Kiccho manussapaṭilābho,"
    },
    {
     "n": 14,
     "text": "kicchaṁ maccāna jīvitaṁ;"
    },
    {
     "n": 15,
     "text": "Kicchaṁ saddhammassavanaṁ,"
    },
    {
     "n": 16,
     "text": "kiccho buddhānamuppādo."
    },
    {
     "n": 17,
     "text": "Sabbapāpassa akaraṇaṁ,"
    },
    {
     "n": 18,
     "text": "kusalassa upasampadā;"
    },
    {
     "n": 19,
     "text": "Sacittapariyodapanaṁ,"
    },
    {
     "n": 20,
     "text": "etaṁ buddhāna sāsanaṁ."
    },
    {
     "n": 21,
     "text": "Khantī paramaṁ tapo titikkhā,"
    },
    {
     "n": 22,
     "text": "Nibbānaṁ paramaṁ vadanti buddhā;"
    },
    {
     "n": 23,
     "text": "Na hi pabbajito parūpaghātī,"
    },
    {
     "n": 24,
     "text": "Na samaṇo hoti paraṁ viheṭhayanto."
    },
    {
     "n": 25,
     "text": "Anūpavādo anūpaghāto,"
    },
    {
     "n": 26,
     "text": "Pātimokkhe ca saṁvaro;"
    },
    {
     "n": 27,
     "text": "Mattaññutā ca bhattasmiṁ,"
    },
    {
     "n": 28,
     "text": "Pantañca sayanāsanaṁ;"
    },
    {
     "n": 29,
     "text": "Adhicitte ca āyogo,"
    },
    {
     "n": 30,
     "text": "Etaṁ buddhāna sāsanaṁ."
    },
    {
     "n": 31,
     "text": "Na kahāpaṇavassena,"
    },
    {
     "n": 32,
     "text": "titti kāmesu vijjati;"
    },
    {
     "n": 33,
     "text": "Appassādā dukhā kāmā,"
    },
    {
     "n": 34,
     "text": "iti viññāya paṇḍito."
    },
    {
     "n": 35,
     "text": "Api dibbesu kāmesu,"
    },
    {
     "n": 36,
     "text": "ratiṁ so nādhigacchati;"
    },
    {
     "n": 37,
     "text": "Taṇhakkhayarato hoti,"
    },
    {
     "n": 38,
     "text": "sammāsambuddhasāvako."
    },
    {
     "n": 39,
     "text": "Bahuṁ ve saraṇaṁ yanti,"
    },
    {
     "n": 40,
     "text": "pabbatāni vanāni ca;"
    },
    {
     "n": 41,
     "text": "Ārāmarukkhacetyāni,"
    },
    {
     "n": 42,
     "text": "manussā bhayatajjitā."
    },
    {
     "n": 43,
     "text": "Netaṁ kho saraṇaṁ khemaṁ,"
    },
    {
     "n": 44,
     "text": "netaṁ saraṇamuttamaṁ;"
    },
    {
     "n": 45,
     "text": "Netaṁ saraṇamāgamma,"
    },
    {
     "n": 46,
     "text": "sabbadukkhā pamuccati."
    },
    {
     "n": 47,
     "text": "Yo ca buddhañca dhammañca,"
    },
    {
     "n": 48,
     "text": "saṅghañca saraṇaṁ gato;"
    },
    {
     "n": 49,
     "text": "Cattāri ariyasaccāni,"
    },
    {
     "n": 50,
     "text": "sammappaññāya passati."
    },
    {
     "n": 51,
     "text": "Dukkhaṁ dukkhasamuppādaṁ,"
    },
    {
     "n": 52,
     "text": "dukkhassa ca atikkamaṁ;"
    },
    {
     "n": 53,
     "text": "Ariyaṁ caṭṭhaṅgikaṁ maggaṁ,"
    },
    {
     "n": 54,
     "text": "dukkhūpasamagāminaṁ."
    },
    {
     "n": 55,
     "text": "Etaṁ kho saraṇaṁ khemaṁ,"
    },
    {
     "n": 56,
     "text": "etaṁ saraṇamuttamaṁ;"
    },
    {
     "n": 57,
     "text": "Etaṁ saraṇamāgamma,"
    },
    {
     "n": 58,
     "text": "sabbadukkhā pamuccati."
    },
    {
     "n": 59,
     "text": "Dullabho purisājañño,"
    },
    {
     "n": 60,
     "text": "na so sabbattha jāyati;"
    },
    {
     "n": 61,
     "text": "Yattha so jāyati dhīro,"
    },
    {
     "n": 62,
     "text": "taṁ kulaṁ sukhamedhati."
    },
    {
     "n": 63,
     "text": "Sukho buddhānamuppādo,"
    },
    {
     "n": 64,
     "text": "sukhā saddhammadesanā;"
    },
    {
     "n": 65,
     "text": "Sukhā saṅghassa sāmaggī,"
    },
    {
     "n": 66,
     "text": "samaggānaṁ tapo sukho."
    },
    {
     "n": 67,
     "text": "Pūjārahe pūjayato,"
    },
    {
     "n": 68,
     "text": "buddhe yadi va sāvake;"
    },
    {
     "n": 69,
     "text": "Papañcasamatikkante,"
    },
    {
     "n": 70,
     "text": "tiṇṇasokapariddave."
    },
    {
     "n": 71,
     "text": "Te tādise pūjayato,"
    },
    {
     "n": 72,
     "text": "nibbute akutobhaye;"
    },
    {
     "n": 73,
     "text": "Na sakkā puññaṁ saṅkhātuṁ,"
    },
    {
     "n": 74,
     "text": "imettamapi kenaci."
    },
    {
     "n": 75,
     "text": "Paṭhamabhāṇavāraṁ."
    }
   ]
  },
  {
   "key": "en-translation",
   "lang": "en",
   "variant": "translation",
   "translator": "Bhikkhu Sujato",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp179-196/sujato?lang=en (translation_text)",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (bilara-data _publication-v2.json); the translator additionally requests that use not be for AI training datasets, AI models or AI-derived technologies",
   "lines": [
    {
     "n": 1,
     "text": "He whose victory may not be undone,"
    },
    {
     "n": 2,
     "text": "a victory unrivaled in all the world;"
    },
    {
     "n": 3,
     "text": "by what track would you trace that Buddha,"
    },
    {
     "n": 4,
     "text": "who leaves no track in his infinite range?"
    },
    {
     "n": 5,
     "text": "Of craving, the weaver, the clinger, he has none:"
    },
    {
     "n": 6,
     "text": "so where can he be traced?"
    },
    {
     "n": 7,
     "text": "By what track would you trace that Buddha,"
    },
    {
     "n": 8,
     "text": "who leaves no track in his infinite range?"
    },
    {
     "n": 9,
     "text": "The attentive intent on absorption,"
    },
    {
     "n": 10,
     "text": "who love the peace of renunciation,"
    },
    {
     "n": 11,
     "text": "the Buddhas, ever mindful,"
    },
    {
     "n": 12,
     "text": "are envied by even the gods."
    },
    {
     "n": 13,
     "text": "It’s hard to gain a human birth;"
    },
    {
     "n": 14,
     "text": "the life of mortals is hard;"
    },
    {
     "n": 15,
     "text": "it’s hard to hear the true teaching;"
    },
    {
     "n": 16,
     "text": "the arising of Buddhas is hard."
    },
    {
     "n": 17,
     "text": "Not to do any evil;"
    },
    {
     "n": 18,
     "text": "to embrace the good;"
    },
    {
     "n": 19,
     "text": "to purify one’s mind:"
    },
    {
     "n": 20,
     "text": "this is the instruction of the Buddhas."
    },
    {
     "n": 21,
     "text": "Patient acceptance is the ultimate fervor."
    },
    {
     "n": 22,
     "text": "Extinguishment is the ultimate, say the Buddhas."
    },
    {
     "n": 23,
     "text": "No true renunciate injures another,"
    },
    {
     "n": 24,
     "text": "nor does an ascetic hurt another."
    },
    {
     "n": 25,
     "text": "Not speaking ill nor doing harm;"
    },
    {
     "n": 26,
     "text": "restraint in the monastic code;"
    },
    {
     "n": 27,
     "text": "moderation in eating;"
    },
    {
     "n": 28,
     "text": "staying in remote lodgings;"
    },
    {
     "n": 29,
     "text": "commitment to the higher mind—"
    },
    {
     "n": 30,
     "text": "this is the instruction of the Buddhas."
    },
    {
     "n": 31,
     "text": "Even if it were raining money,"
    },
    {
     "n": 32,
     "text": "you’d not be sated in sensual pleasures."
    },
    {
     "n": 33,
     "text": "An astute person understands that sensual pleasures"
    },
    {
     "n": 34,
     "text": "offer little gratification and much suffering."
    },
    {
     "n": 35,
     "text": "Thus they find no delight"
    },
    {
     "n": 36,
     "text": "even in celestial pleasures."
    },
    {
     "n": 37,
     "text": "A disciple of the fully awakened Buddha"
    },
    {
     "n": 38,
     "text": "delights in the ending of craving."
    },
    {
     "n": 39,
     "text": "So many go for refuge"
    },
    {
     "n": 40,
     "text": "to mountains and forest groves,"
    },
    {
     "n": 41,
     "text": "to shrines in tended parks;"
    },
    {
     "n": 42,
     "text": "those people are driven by fear."
    },
    {
     "n": 43,
     "text": "But such refuge is no sanctuary,"
    },
    {
     "n": 44,
     "text": "it is no supreme refuge."
    },
    {
     "n": 45,
     "text": "By going to that refuge,"
    },
    {
     "n": 46,
     "text": "you’re not released from all suffering."
    },
    {
     "n": 47,
     "text": "One gone for refuge to the Buddha,"
    },
    {
     "n": 48,
     "text": "to his teaching and to the Saṅgha,"
    },
    {
     "n": 49,
     "text": "sees the four noble truths"
    },
    {
     "n": 50,
     "text": "with right understanding:"
    },
    {
     "n": 51,
     "text": "suffering, suffering’s origin,"
    },
    {
     "n": 52,
     "text": "suffering’s transcendence,"
    },
    {
     "n": 53,
     "text": "and the noble eightfold path"
    },
    {
     "n": 54,
     "text": "that leads to the stilling of suffering."
    },
    {
     "n": 55,
     "text": "Such refuge is a sanctuary,"
    },
    {
     "n": 56,
     "text": "it is the supreme refuge."
    },
    {
     "n": 57,
     "text": "By going to that refuge,"
    },
    {
     "n": 58,
     "text": "you’re released from all suffering."
    },
    {
     "n": 59,
     "text": "It’s hard to find a thoroughbred man:"
    },
    {
     "n": 60,
     "text": "they’re not born just anywhere."
    },
    {
     "n": 61,
     "text": "A family where that attentive one is born"
    },
    {
     "n": 62,
     "text": "prospers in happiness."
    },
    {
     "n": 63,
     "text": "Happy, the arising of Buddhas!"
    },
    {
     "n": 64,
     "text": "Happy, the teaching of Dhamma!"
    },
    {
     "n": 65,
     "text": "Happy is the harmony of the Saṅgha,"
    },
    {
     "n": 66,
     "text": "and the striving of the harmonious is happy."
    },
    {
     "n": 67,
     "text": "When a person venerates the worthy—"
    },
    {
     "n": 68,
     "text": "the Buddha or his disciple,"
    },
    {
     "n": 69,
     "text": "who have transcended proliferation,"
    },
    {
     "n": 70,
     "text": "and have left behind grief and lamentation,"
    },
    {
     "n": 71,
     "text": "quenched, fearing nothing from any quarter—"
    },
    {
     "n": 72,
     "text": "the merit of one venerating such as these,"
    },
    {
     "n": 73,
     "text": "cannot be calculated by anyone,"
    },
    {
