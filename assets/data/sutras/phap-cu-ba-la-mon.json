{
 "id": "phap-cu-ba-la-mon",
 "tradition": "THERAVADA",
 "kind": "VERSE",
 "collection": "Tiểu Bộ",
 "reference": "Dhp 383-423",
 "summary": "Phẩm cuối của Kinh Pháp Cú (Tiểu Bộ, kệ 383-423), định nghĩa thế nào là vị Bà-la-môn đích thực, không theo dòng dõi mà theo phẩm hạnh. Các bài kệ mô tả người đã đoạn trừ trói buộc, dứt ác, giữ tịnh hạnh, không chấp thủ và đạt giải thoát, tương ứng hình ảnh bậc thánh trong giáo lý Phật giáo.",
 "titles": {
  "vi": "Kinh Pháp Cú - Phẩm Bà-la-môn",
  "pli": "Brāhmaṇavagga",
  "en": "Brahmins"
 },
 "deities": [
  {
   "deity_id": "buddha_shakyamuni",
   "role": "SPEAKER"
  }
 ],
 "dailyChant": false,
 "purposes": [
  "HOC_GIAO_LY"
 ],
 "durationMinutes": 15,
 "reviewStatus": "UNREVIEWED",
 "translations": [
  {
   "key": "vi-translation",
   "lang": "vi",
   "variant": "translation",
   "translator": "Bhikkhu Thích Minh Châu (Hòa thượng Thích Minh Châu; SuttaCentral digital edition by phantuananh, 2021)",
   "sourceName": "SuttaCentral",
   "sourceUrl": "https://suttacentral.net/api/bilarasuttas/dhp383-423/phantuananh?lang=vi",
   "license": "CC0-1.0",
   "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
   "licenseNote": "as stated in SuttaCentral publication metadata (scpub43)",
   "lines": [
    {
     "n": 1,
     "text": "Hỡi này Bà-la-môn, Hãy tinh tấn đoạn lòng,"
    },
    {
     "n": 2,
     "text": "Từ bỏ các dục lạc,"
    },
    {
     "n": 3,
     "text": "Biết được hành đoạn diệt,"
    },
    {
     "n": 4,
     "text": "Ngươi là bậc vô vi."
    },
    {
     "n": 5,
     "text": "Nhờ thường trú hai pháp"
    },
    {
     "n": 6,
     "text": "Đến được bờ bên kia."
    },
    {
     "n": 7,
     "text": "Bà-la-môn có trí,"
    },
    {
     "n": 8,
     "text": "Mọi kiết sử dứt sạch."
    },
    {
     "n": 9,
     "text": "Không bờ này, bờ kia"
    },
    {
     "n": 10,
     "text": "Cả hai bờ không có,"
    },
    {
     "n": 11,
     "text": "Lìa khổ, không trói buộc"
    },
    {
     "n": 12,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 13,
     "text": "Tu thiền, trú ly trần"
    },
    {
     "n": 14,
     "text": "Phận sự xong, vô lậu,"
    },
    {
     "n": 15,
     "text": "Đạt được đích tối thượng,"
    },
    {
     "n": 16,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 17,
     "text": "Mặt trời sáng ban ngày,"
    },
    {
     "n": 18,
     "text": "Mặt trăng sáng ban đêm."
    },
    {
     "n": 19,
     "text": "Khí giới sáng Sát-lỵ,"
    },
    {
     "n": 20,
     "text": "Thiền định sáng Phạm chí."
    },
    {
     "n": 21,
     "text": "Còn hào quang đức Phật,"
    },
    {
     "n": 22,
     "text": "Chói sáng cả ngày đêm."
    },
    {
     "n": 23,
     "text": "Dứt ác gọi Phạm chí,"
    },
    {
     "n": 24,
     "text": "Tịnh hạnh gọi Sa-môn,"
    },
    {
     "n": 25,
     "text": "Tự mình xuất cấu uế,"
    },
    {
     "n": 26,
     "text": "Nên gọi bậc xuất gia."
    },
    {
     "n": 27,
     "text": "Chớ có đập Phạm chí!"
    },
    {
     "n": 28,
     "text": "Phạm chí chớ đập lại!"
    },
    {
     "n": 29,
     "text": "Xấu thay đập Phạm chí"
    },
    {
     "n": 30,
     "text": "Đập trả lại xấu hơn!"
    },
    {
     "n": 31,
     "text": "Đối vị Bà-la-môn, Đây không lợi ích nhỏ."
    },
    {
     "n": 32,
     "text": "Khi ý không ái luyến,"
    },
    {
     "n": 33,
     "text": "Tâm hại được chận đứng,"
    },
    {
     "n": 34,
     "text": "Chỉ khi ấy khổ diệt,"
    },
    {
     "n": 35,
     "text": "Với người thân miệng ý,"
    },
    {
     "n": 36,
     "text": "Không làm các ác hạnh"
    },
    {
     "n": 37,
     "text": "Ba nghiệp được phòng hộ,"
    },
    {
     "n": 38,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 39,
     "text": "Từ ai, biết chánh pháp"
    },
    {
     "n": 40,
     "text": "Bậc Chánh Giác thuyết giảng,"
    },
    {
     "n": 41,
     "text": "Hãy kính lễ vị ấy,"
    },
    {
     "n": 42,
     "text": "Như phạm chí thờ lửa."
    },
    {
     "n": 43,
     "text": "Được gọi Bà-la-môn, Không vì đầu bện tóc,"
    },
    {
     "n": 44,
     "text": "Không chủng tộc, thọ sanh,"
    },
    {
     "n": 45,
     "text": "Ai thật chân, chánh, tịnh,"
    },
    {
     "n": 46,
     "text": "Mới gọi Bà-la-môn."
    },
    {
     "n": 47,
     "text": "Kẻ ngu, có ích gì"
    },
    {
     "n": 48,
     "text": "Bện tóc với da dê,"
    },
    {
     "n": 49,
     "text": "Nội tâm toàn phiền não,"
    },
    {
     "n": 50,
     "text": "Ngoài mặt đánh bóng suông."
    },
    {
     "n": 51,
     "text": "Người mặc áo đống rác,"
    },
    {
     "n": 52,
     "text": "Gầy ốm, lộ mạch gân,"
    },
    {
     "n": 53,
     "text": "Độc thân thiền trong rừng."
    },
    {
     "n": 54,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 55,
     "text": "Ta không gọi Phạm chí,"
    },
    {
     "n": 56,
     "text": "Vì chỗ sanh, mẹ sanh."
    },
    {
     "n": 57,
     "text": "Chỉ được gọi tên suông"
    },
    {
     "n": 58,
     "text": "Nếu tâm còn phiền não."
    },
    {
     "n": 59,
     "text": "Không phiền não, chấp trước"
    },
    {
     "n": 60,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 61,
     "text": "Đoạn hết các kiết sử,"
    },
    {
     "n": 62,
     "text": "Không còn gì lo sợ"
    },
    {
     "n": 63,
     "text": "Không đắm trước buộc ràng"
    },
    {
     "n": 64,
     "text": "Ta gọi Bà-la-môn"
    },
    {
     "n": 65,
     "text": "Bỏ đai da, bỏ cương"
    },
    {
     "n": 66,
     "text": "Bỏ dây, đồ sở thuộc,"
    },
    {
     "n": 67,
     "text": "Bỏ then chốt, sáng suốt,"
    },
    {
     "n": 68,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 69,
     "text": "Không ác ý, nhẫn chịu,"
    },
    {
     "n": 70,
     "text": "Phỉ báng, đánh, phạt hình,"
    },
    {
     "n": 71,
     "text": "Lấy nhẫn làm quân lực,"
    },
    {
     "n": 72,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 73,
     "text": "Không hận, hết bổn phận,"
    },
    {
     "n": 74,
     "text": "Trì giới, không tham ái,"
    },
    {
     "n": 75,
     "text": "Nhiếp phục, thân cuối cùng,"
    },
    {
     "n": 76,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 77,
     "text": "Như nước trên lá sen,"
    },
    {
     "n": 78,
     "text": "Như hột cải đầu kim,"
    },
    {
     "n": 79,
     "text": "Người không nhiễm ái dục,"
    },
    {
     "n": 80,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 81,
     "text": "Ai tự trên đời này,"
    },
    {
     "n": 82,
     "text": "Giác khổ, diệt trừ khổ,"
    },
    {
     "n": 83,
     "text": "Bỏ gánh nặng, giải thoát,"
    },
    {
     "n": 84,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 85,
     "text": "Người trí tuệ sâu xa,"
    },
    {
     "n": 86,
     "text": "Khéo biết đạo, phi đạo"
    },
    {
     "n": 87,
     "text": "Chứng đạt đích vô thượng,"
    },
    {
     "n": 88,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 89,
     "text": "Không liên hệ cả hai,"
    },
    {
     "n": 90,
     "text": "Xuất gia và thế tục,"
    },
    {
     "n": 91,
     "text": "Sống độc thân, ít dục,"
    },
    {
     "n": 92,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 93,
     "text": "Bỏ trượng, đối chúng sanh,"
    },
    {
     "n": 94,
     "text": "Yếu kém hay kiên cường,"
    },
    {
     "n": 95,
     "text": "Không giết, không bảo giết,"
    },
    {
     "n": 96,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 97,
     "text": "Thân thiện giữa thù địch"
    },
    {
     "n": 98,
     "text": "Ôn hòa giữa hung hăng."
    },
    {
     "n": 99,
     "text": "Không nhiễm, giữa nhiễm trước,"
    },
    {
     "n": 100,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 101,
     "text": "Người bỏ rơi tham sân,"
    },
    {
     "n": 102,
     "text": "Không mạn không ganh tị,"
    },
    {
     "n": 103,
     "text": "Như hột cải đầu kim,"
    },
    {
     "n": 104,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 105,
     "text": "Nói lên lời ôn hòa,"
    },
    {
     "n": 106,
     "text": "Lợi ích và chân thật,"
    },
    {
     "n": 107,
     "text": "Không mất lòng một ai,"
    },
    {
     "n": 108,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 109,
     "text": "Ở đời, vật dài, ngắn,"
    },
    {
     "n": 110,
     "text": "Nhỏ, lớn, đẹp hay xấu"
    },
    {
     "n": 111,
     "text": "Phàm không cho không lấy,"
    },
    {
     "n": 112,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 113,
     "text": "Người không có hy cầu,"
    },
    {
     "n": 114,
     "text": "Đời này và đời sau,"
    },
    {
     "n": 115,
     "text": "Không hy cầu, giải thoát,"
    },
    {
     "n": 116,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 117,
     "text": "Người không còn tham ái,"
    },
    {
     "n": 118,
     "text": "Có trí, không nghi hoặc,"
    },
    {
     "n": 119,
     "text": "Thể nhập vào bất tử,"
    },
    {
     "n": 120,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 121,
     "text": "Người sống ở đời này"
    },
    {
     "n": 122,
     "text": "Không nhiễm cả thiện ác,"
    },
    {
     "n": 123,
     "text": "Không sầu, sạch không bụi"
    },
    {
     "n": 124,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 125,
     "text": "Như trăng, sạch không uế"
    },
    {
     "n": 126,
     "text": "Sáng trong và tịnh lặng,"
    },
    {
     "n": 127,
     "text": "Hữu ái, được đoạn tận,"
    },
    {
     "n": 128,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 129,
     "text": "Vượt đường nguy hiểm này,"
    },
    {
     "n": 130,
     "text": "Nhiếp phục luân hồi, si,"
    },
    {
     "n": 131,
     "text": "Đến bờ kia thiền định"
    },
    {
     "n": 132,
     "text": "Không dục ái, không nghi,"
    },
    {
     "n": 133,
     "text": "Không chấp trước, tịch tịnh,"
    },
    {
     "n": 134,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 135,
     "text": "Ai ở đời, đoạn dục,"
    },
    {
     "n": 136,
     "text": "Bỏ nhà, sống xuất gia,"
    },
    {
     "n": 137,
     "text": "Dục hữu được đoạn tận,"
    },
    {
     "n": 138,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 139,
     "text": "Ai ở đời đoạn ái"
    },
    {
     "n": 140,
     "text": "Bỏ nhà, sống xuất gia,"
    },
    {
     "n": 141,
     "text": "Ái hữu được đoạn tận,"
    },
    {
     "n": 142,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 143,
     "text": "(dị bản)"
    },
    {
     "n": 144,
     "text": "(dị bản)"
    },
    {
     "n": 145,
     "text": "(dị bản)"
    },
    {
     "n": 146,
     "text": "(dị bản)"
    },
    {
     "n": 147,
     "text": "Bỏ trói buộc loài người,"
    },
    {
     "n": 148,
     "text": "Vượt trói buộc cõi trời."
    },
    {
     "n": 149,
     "text": "Giải thoát mọi buộc ràng,"
    },
    {
     "n": 150,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 151,
     "text": "Bỏ điều ưa, điều ghét,"
    },
    {
     "n": 152,
     "text": "Mát lạnh, diệt sanh y"
    },
    {
     "n": 153,
     "text": "Bậc anh hùng chiến thắng, Nhiếp phục mọi thế giới,"
    },
    {
     "n": 154,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 155,
     "text": "Ai hiểu rõ hoàn toàn"
    },
    {
     "n": 156,
     "text": "Sanh tử các chúng sanh,"
    },
    {
     "n": 157,
     "text": "Không nhiễm, khéo vượt qua, Sáng suốt chân giác ngộ,"
    },
    {
     "n": 158,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 159,
     "text": "Với ai, loài trời, người Cùng với Càn-thát-bà,"
    },
    {
     "n": 160,
     "text": "Không biết chỗ thọ sanh"
    },
    {
     "n": 161,
     "text": "Lậu tận bậc La-hán."
    },
    {
     "n": 162,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 163,
     "text": "Ai quá, hiện, vị lai"
    },
    {
     "n": 164,
     "text": "Không một sở hữu gì,"
    },
    {
     "n": 165,
     "text": "Không sở hữu không nắm,"
    },
    {
     "n": 166,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 167,
     "text": "Bậc trâu chúa, thù thắng Bậc anh hùng, đại sĩ,"
    },
    {
     "n": 168,
     "text": "Bậc chiến thắng, không nhiễm,"
    },
    {
     "n": 169,
     "text": "Bậc tẩy sạch, giác ngộ,"
    },
    {
     "n": 170,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 171,
     "text": "Ai biết được đời trước,"
    },
    {
     "n": 172,
     "text": "Thấy thiên giới, đọa xứ,"
    },
    {
     "n": 173,
     "text": "Đạt được sanh diệt tận"
    },
    {
     "n": 174,
     "text": "Thắng trí, tự viên thành Bậc mâu-ni đạo sĩ."
    },
    {
     "n": 175,
     "text": "Viên mãn mọi thành tựu"
    },
    {
     "n": 176,
     "text": "Ta gọi Bà-la-môn."
    },
    {
     "n": 177,
     "text": "Hết kinh Pháp Cú"
    }
   ]
  },
  {
   "key": "pli-translation",
   "lang": "pli",
   "variant": "translation",
   "translator": "Mahāsaṅgīti Tipiṭaka Buddhavasse 2500 (The M.L. Maniratana Bunnag Dhamma Society Fund)",
   "sourceName": "SuttaCentral",
