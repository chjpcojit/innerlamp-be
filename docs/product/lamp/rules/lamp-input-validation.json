{
  "rule": [
    "BR-LMP-01",
    "BR-LMP-02",
    "BR-LMP-06",
    "BR-LMP-07"
  ],
  "description": "Whether a lamp the user submits is accepted, and the normalized recipient and prayer that are kept. Lamp type and intention use the product codes OIL_LAMP, LOTUS_CANDLE, FLOWER_LANTERN and PEACE, SALVATION, MERIT_DEDICATION, GRATITUDE as test-local labels. A value written as {\"repeat\": s, \"times\": n} is the string s repeated n times; {\"concat\": [...]} joins its parts. Characters are counted after Unicode NFC normalization.",
  "product_spec_version": "1.0",
  "inputs": {
    "lamp_type": "one of the three lamp types",
    "intention": "one of the four intentions",
    "recipient": "free text, possibly empty",
    "prayer": "free text or null",
    "duration_days": "integer"
  },
  "output": {
    "valid": "true when the lamp is accepted",
    "field": "when not valid: which input is rejected",
    "recipient": "kept recipient after trimming; null when blank",
    "prayer": "kept prayer after trimming; null when blank",
    "dedicated_to": "all_beings when the recipient is blank"
  },
  "cases": [
    {
      "name": "minimal valid lamp",
      "input": {
        "lamp_type": "OIL_LAMP",
        "intention": "PEACE",
        "recipient": "Bà ngoại",
        "prayer": null,
        "duration_days": 7
      },
      "expected": {
        "valid": true,
        "recipient": "Bà ngoại",
        "prayer": null
      },
      "source": "BR-LMP-01, BR-LMP-02, BR-LMP-06, BR-LMP-07"
    },
    {
      "name": "every lamp type is accepted: lotus candle",
      "input": {
        "lamp_type": "LOTUS_CANDLE",
        "intention": "PEACE",
        "recipient": "Bà ngoại",
        "prayer": null,
        "duration_days": 7
      },
      "expected": {
        "valid": true,
        "recipient": "Bà ngoại",
        "prayer": null
      },
      "source": "BR-LMP-01, BR-LMP-02, BR-LMP-06, BR-LMP-07"
    },
