    },
    {
      "name": "100 Vietnamese characters typed as base letter plus combining marks count as 100 characters",
      "input": {
        "lamp_type": "OIL_LAMP",
        "intention": "PEACE",
        "recipient": {
          "repeat": "ệ",
          "times": 100
