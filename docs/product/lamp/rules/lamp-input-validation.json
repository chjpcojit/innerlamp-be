      "source": "BR-LMP-06 (characters are counted after Unicode NFC normalization)"
    },
    {
      "name": "101 Vietnamese characters in decomposed form are rejected",
      "input": {
        "lamp_type": "OIL_LAMP",
        "intention": "PEACE",
        "recipient": {
          "repeat": "ệ",
          "times": 101
        },
        "prayer": null,
        "duration_days": 7
      },
      "expected": {
        "valid": false,
        "field": "recipient"
      },
      "source": "BR-LMP-06 (characters are counted after Unicode NFC normalization)"
    },
    {
      "name": "the recipient is also trimmed before counting: 100 characters plus spaces is accepted",
      "input": {
        "lamp_type": "OIL_LAMP",
        "intention": "PEACE",
        "recipient": {
          "concat": [
            "  ",
            {
              "repeat": "a",
              "times": 100
            },
            "  "
          ]
        },
        "prayer": null,
        "duration_days": 7
      },
      "expected": {
        "valid": true,
