{
  "rule": [
    "BR-CAL-01",
    "BR-CAL-02",
    "BR-CAL-03",
    "BR-CAL-04",
    "BR-CAL-05",
    "BR-CAL-06",
    "BR-CAL-07"
  ],
  "description": "Occurrences of one event in one solar year, computed from its repeat rule, each with its solar and Vietnamese lunar date (UTC+7).",
  "product_spec_version": "1.0",
  "inputs": {
    "rule": "kind = solar {month, day} | lunar {month, day, leap_month} | lunar_last_day {month} | every_lunar_month {day} | solar_term {longitude: multiple of 15 in 0..345}",
    "year": "solar year 1900..2100"
  },
  "output": {
    "occurrences": "list ordered by solar date; each {solar_date YYYY-MM-DD, lunar {day, month, year (lunar year), leap_month}}; empty when the event has no occurrence that year"
  },
  "cases": [
    {
      "name": "fixed solar date",
      "input": {
        "rule": {
          "kind": "solar",
          "month": 4,
          "day": 30
        },
        "year": 2026
      },
      "expected": {
        "occurrences": [
          {
            "solar_date": "2026-04-30",
            "lunar": {
              "day": 14,
              "month": 3,
              "year": 2026,
              "leap_month": false
            }
          }
        ]
      },
      "rules": "BR-CAL-03, BR-CAL-07",
      "source": "backend resolver (services/appService/domain/calendar_event_resolver.go, lunarcal) run 2026-10-15"
    },
    {
      "name": "29 February in a common year has no occurrence",
