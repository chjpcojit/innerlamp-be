{
  "rule": [
    "BR-CAL-15"
  ],
  "description": "Rows of one month card on the home block: Buddhist-group occurrences only; at most three; tier 1 major events, tier 2 other events, tier 3 Rằm / Mùng Một (every-lunar-month events); BR-CAL-12 order inside a tier; the rest counted as more. Identifiers and display orders are illustrative.",
  "product_spec_version": "1.0",
  "inputs": {
    "occurrences": "the month's occurrences {event, solar_date, display_order, major, every_lunar_month, groups}"
  },
  "output": {
    "shown": "event identifiers in display order",
    "more": "count of Buddhist-group occurrences not shown"
  },
  "cases": [
    {
      "name": "major first, Rằm/Mùng Một last",
      "input": {
        "occurrences": [
          {
            "event": "mung-mot",
            "solar_date": "2026-05-17",
            "display_order": 40,
            "major": false,
            "every_lunar_month": true,
            "groups": [
              "buddhist"
            ]
          },
          {
            "event": "via-van-thu",
            "solar_date": "2026-05-20",
            "display_order": 10,
            "major": false,
            "every_lunar_month": false,
            "groups": [
              "buddhist"
            ]
          },
          {
            "event": "phat-dan",
            "solar_date": "2026-05-31",
            "display_order": 1,
            "major": true,
            "every_lunar_month": false,
            "groups": [
              "buddhist"
            ]
          },
          {
            "event": "ram",
            "solar_date": "2026-05-31",
            "display_order": 41,
            "major": false,
            "every_lunar_month": true,
            "groups": [
              "buddhist"
            ]
          }
        ]
      },
      "expected": {
        "shown": [
          "phat-dan",
          "via-van-thu",
          "mung-mot"
        ],
        "more": 1
      }
    },
    {
      "name": "non-Buddhist events are not shown or counted",
      "input": {
        "occurrences": [
          {
            "event": "mung-mot",
            "solar_date": "2026-11-09",
            "display_order": 40,
            "major": false,
            "every_lunar_month": true,
            "groups": [
              "buddhist"
            ]
          },
          {
            "event": "ngay-nha-giao",
            "solar_date": "2026-11-20",
            "display_order": 30,
            "major": false,
            "every_lunar_month": false,
            "groups": [
              "vietnam"
            ]
          },
          {
            "event": "ram",
            "solar_date": "2026-11-23",
            "display_order": 41,
            "major": false,
            "every_lunar_month": true,
            "groups": [
              "buddhist"
            ]
          }
        ]
      },
      "expected": {
        "shown": [
          "mung-mot",
          "ram"
        ],
        "more": 0
      }
    },
    {
      "name": "more than three named events",
      "input": {
        "occurrences": [
          {
            "event": "a",
            "solar_date": "2026-03-02",
            "display_order": 5,
            "major": false,
            "every_lunar_month": false,
            "groups": [
              "buddhist"
            ]
          },
          {
            "event": "b",
            "solar_date": "2026-03-05",
            "display_order": 6,
            "major": false,
            "every_lunar_month": false,
            "groups": [
              "buddhist"
            ]
          },
          {
            "event": "c",
            "solar_date": "2026-03-08",
            "display_order": 7,
            "major": true,
            "every_lunar_month": false,
            "groups": [
              "buddhist"
            ]
          },
          {
            "event": "d",
            "solar_date": "2026-03-10",
            "display_order": 8,
            "major": false,
            "every_lunar_month": false,
            "groups": [
              "buddhist"
            ]
          },
          {
            "event": "ram",
