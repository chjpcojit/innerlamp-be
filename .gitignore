# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

pb/

# IDEs & Editors
.idea/
.vscode/

# Unit test reports
TEST*.xml

# OS generated files
.DS_Store
Thumbs.db

# Go specific (output application binary)
bin/
vendor/

# Go workspace file
go.work
go.work.sum
# Go module files
go.sum

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Sensitive file
*.pem
*.json
*.yaml
# API contract: committed, not a secret (docs/tech-debt/sutra/TD-001)
!docs/specs/api/openapi.yaml
!web/docs/public/openapi.yaml
# Administrative units dataset: public reference data, not a secret; cmd/seedadminunits loads it
# (docs/specs/features/administrative-units). Rebuilt by scripts/build_administrative_units.py.
!assets/data/administrative-units.json
# Seed catalogues: public content, the source of truth for the content load (docs/product/deity Appendix B,
# docs/product/calendar Appendix B). cmd/seedcalendarevents and cmd/seeddeities load them.
!assets/data/calendar-events.json
!assets/data/phat_botat.json
# Article content: public reading list, not a secret; embedded by assets/embed.go and loaded by
# cmd/seedarticles (docs/product/article FR-ART-009).
!assets/data/buddhist_articles.json
# Gallery photo list (titles, places, author/licence credits): public content, loaded by cmd/seedgallery
# (docs/product/gallery FR-GAL-010). The photo files themselves stay out of git.
!assets/data/buddhist_gallery.json
# Product test vectors: shared, not secrets; every platform runs them (docs/product/README.md).
!docs/product/*/rules/*.json
# Reviewed ward decisions for temple addresses (docs/specs/features/temple, tasks Phase 10): a record, not a secret.
!docs/specs/features/temple/address-decisions.json
*-adminsdk-*.json
*.sh
*.p8
*.txt
*.env
*.bat
.ssh/
.github
vendor

# Claude Code hook runtime state (not config — regenerated on every hook run)
# Keep .claude/settings.json, hooks/, skills/, locked_files.txt tracked:
# they are matched by the *.json / *.sh / *.txt rules above but stay tracked
# because git only ignores untracked files.
.claude/hook_log.jsonl
.claude/*_retry_count
.claude/hook.lock